rules_version = '2';

/* ============================================================================
 *  כללי האבטחה של Firestore — CBA / AtmoSync        (צעד 02ד, 2026-09-14)
 * ----------------------------------------------------------------------------
 *  🔴 **הקובץ הזה הוא השרת.** בארכיטקטורה שאליה אנחנו עוברים הדפדפן קורא
 *  ישירות מ-Firestore, בלי Apps Script באמצע — ולכן מה שכתוב כאן הוא הדבר
 *  היחיד שמפריד בין תושב לבין הנתונים של כל שאר השיכון. טעות כאן אינה קוד
 *  שנשבר אלא **נתונים שנחשפים בשקט**.
 *
 *  ✅ **תחום ראשון פתוח לקריאה (צעד 03ב, 2026-09-15): תוכנית העבודה של הגינון.**
 *     `gardenPlan` ו-`gardenMeta` — הגדרות עבודה בלבד, **בלי שום מידע אישי**.
 *     ו-`services` (צעד 04ב) — שירותים לתושב. 🔴 עמודת `עודכן ע"י`
 *     (אימייל של מנהל) **אינה מסונכרנת לשם** — ר' servicesSyncAll_.
 *     כל שאר האוספים עדיין חסומים לחלוטין תחת ברירת המחדל.
 *
 *  🔑 **מקור האמת להרשאות הוא `members/{uid}`**, שנכתב **אך ורק** ע"י
 *     Apps Script דרך חשבון שירות (חשבון שירות עוקף את הכללים האלה לגמרי,
 *     ולכן אין צורך — ואסור — לאפשר לדפדפן לכתוב לשם). ר' handleFirebaseLink_.
 *
 *  ⚠️ **עלות:** כל `get()` בתוך כלל נספר כקריאת מסמך מול מכסת Spark
 *     (50,000/יום). Firestore ממטמן את ה-`get()` בתוך הערכה אחת, ולכן
 *     `member()` נקראת פעם אחת לכל בקשה — אבל **אסור להוסיף get() נוסף**
 *     בלי לחשוב על המכסה.
 *
 *  ✅ **תנאי הסף נסגר (02ג):** `savePermissions` מסנכרן את `members/{uid}` מיידית,
 *     ו-`fbSyncRow_` מחווט לכל ארבעת מסלולי הכתיבה לשורת התושב. שלילת
 *     הרשאה או סימון "עזב" נכנסים לתוקף מיד. זה מה שהתיר לפתוח
 *     תחום ראשון לקריאה לפי הרשאה.
 * ========================================================================== */

service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------- פונקציות עזר ---------- */

    /* 🔴 גל 1 (3.10.26, צוות אדום M2) — רק כניסת Google עם מייל מאומת.
       כל משתמשי CBA נכנסים כך ממילא; זה סוגר את הדלת אם אי-פעם יודלק בקונסולה
       ספק אחר (סיסמה/קישור במייל) שמאפשר לפתוח חשבון על מייל של מישהו אחר. */
    function signedIn() {
      return request.auth != null && request.auth.uid != null &&
             request.auth.token.firebase.sign_in_provider == 'google.com' &&
             request.auth.token.email_verified == true;
    }

    /* ⚠️ **פונקציה בכללי Firestore לא מחזירה נתיב.** הנתיב נבנה בתוך
       `get()`/`exists()` עצמם — זה הדפוס המתועד, והיחיד שאפשר לסמוך עליו. */
    function memberExists() {
      return signedIn() && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }

    function m() {
      return get(/databases/$(database)/documents/members/$(request.auth.uid)).data;
    }

    /* 🔴 גל 1 (3.10.26, צוות אדום H1) — המסמך שייך למייל של המחובר.
       uid שנשאר בתא אחרי שמנהל החליף את המייל במשבצת היה מקבל את המסמך של
       התושב החדש. מסמך בלי שדה email (לפני הסנכרון של גל 1) — עובר כמו קודם;
       אחרי `membersSyncNow` לכל המסמכים יש email והבדיקה מלאה. */
    function memberEmailOk() {
      return !('email' in m()) || m().email == request.auth.token.email.lower();
    }

    /* 🔴 4.10.26 — תקרת 1,000 הביטויים (ר' ההסבר ליד hasPerm). `m()` נבנית מחדש
       בכל קריאה (נתיב + get), ולכן המסמך עובר כאן כפרמטר **פעם אחת** — במקום
       שלוש בניות. אותו תנאי בדיוק: active == true ו-memberEmailOk. */
    function isMember() {
      return memberExists() && memberDocOk(m());
    }

    function memberDocOk(d) {
      return d.active == true &&
             (!('email' in d) || d.email == request.auth.token.email.lower());
    }

    function isSuper() {
      return isMember() && ('על' in m().perms);
    }

    /* מנהל-על מקבל כל הרשאה, בדיוק כמו ב-authorize_ בצד Apps Script.
       ⚠️ **שתי המערכות חייבות להסכים על הכלל הזה.** אם הוא ישתנה בצד אחד
       בלבד, אותו משתמש יראה דברים שונים בשני המסלולים — וזה בדיוק סוג
       הסטייה השקטה שכלל הסטייה הגלויה בא למנוע. */
    /* 🔴 4.10.26 — **תקרת 1,000 הביטויים לבקשה.** Firestore מפסיק להעריך כלל אחרי
       1,000 ביטויים ו**דוחה** את הבקשה ("Missing or insufficient permissions") —
       בלי שום הבחנה בין "אין הרשאה" לבין "הכלל יקר מדי". פונקציה בכללים אינה
       נזכרת: כל קריאה ל-isMember() מעריכה מחדש את signedIn, exists, active
       ו-memberEmailOk (גל 1 הוסיף לשם עוד ~10 ביטויים). עד היום hasPerm קראה
       ל-isMember **פעמיים** (פעם ישירות ופעם דרך isSuper), ו-gtUpdateOk קראה
       ל-hasPerm עד 6 פעמים ⇒ אחרי גל 1 + השיוכים של 4.10, עדכון של משימה סגורה
       (וסגירה של מנהל עם סיבה) עבר את התקרה ונדחה — גם למנהל-על.
       כאן: isMember אחת בלבד. **אותו כלל לוגי בדיוק** ('על' = כל הרשאה). */
    function hasPerm(p) {
      return isMember() && permHas(m().perms, p);
    }

    /* 'על' = כל הרשאה. רשימת ההרשאות נשלפת פעם אחת. */
    function permHas(ps, p) {
      return ('על' in ps) || (p in ps);
    }

    function myFamilyId() {
      return isMember() ? m().familyId : '';
    }

    function isExternalUser() {
      return isMember() && m().isExternal == true;
    }

    /* ---------- תוכנית העבודה של הגינון (צעד 03ב) ---------- */

    /* 🔴 **שתי הדרישות אינן עודפות.**
       הראשונה, `hasPerm('גינון')` — רק מי שעוסק בגינון רואה את התוכנית.
       השנייה, `isExternal == false` — **מידור, לא הסתרה.** אחראי הגינון
       החיצוני מבצע משימות אבל אינו רואה את תוכנית העבודה — היא סמכות
       המנהל. `handleGardenPlan_` אוכף את זה בשרת מהיום הראשון; אם הכלל
       כאן לא יאכוף אותו גם, פתחנו לו דלת אחורית בדיוק לדבר היחיד
       שמידרנו ממנו.

       ⚠️ **`== false` ולא `!= true` — בכוונה.** שדה חסר במסמך היה עובר
       את `!= true` ומעניק גישה. `handleFirebaseLink_` כותב את השדה תמיד,
       ולכן הצורה הנוקשה נכשלת-סגור בלי לחסום אף משתמש אמיתי.

       ⚠️ **עלות:** `canSeePlan()` עולה `exists()` אחד ו-`get()` אחד על
       `members/{uid}`. Firestore ממטמן אותם בתוך הערכה אחת, ולכן קריאת
       כל התוכנית עולה 19 מסמכים + קריאה אחת לכלל, לא 20 קריאות לכלל. */
    function canSeePlan() {
      return hasPerm('גינון') && m().isExternal == false;
    }

    /* 🔴🔴 **ההפיכה** (2026-09-21, סעיף 3). עד היום כתוב היה כאן
       "הדפדפן לעולם אינו כותב... שני מקורות כתיבה = שני מקורות אמת".
       הנימוק הזה היה נכון כל עוד **הגיליון** היה מקור האמת.
       מרגע ש-Firestore הוא המקור, הכתיבה מהדפדפן היא המקור
       **היחיד**, והגיליון הוא מראה. אותה היפוך בדיוק כמו במשימות.
       ⚠️ מנהל בלבד — תוכנית העבודה חסומה לגנן החיצוני גם לקריאה. */
    function gpFields() {
      return ['id', 'title', 'category', 'areas', 'freq', 'firstWeek',
              'weekOfMonth', 'months', 'rotate', 'clause', 'active', 'note',
              /* 🔑 22.9 — מאיזה שבוע השינוי בתוקף (מפתח שבוע). מנוע האופק
                 מקפיא מופעים שקודמים לו. ר' GardenRules.applies. */
              'effectiveFrom',
              'order', 'schema', 'updatedAt'];
    }

    function gpShapeOk() {
      return request.resource.data.keys().hasOnly(gpFields()) &&
             request.resource.data.keys().hasAll(['id', 'title', 'freq', 'schema']) &&
             request.resource.data.title is string &&
             request.resource.data.title.size() > 0 &&
             request.resource.data.title.size() <= 80 &&
             /* תדירות מהרשימה הסגורה — `GARDEN_FREQS` בשרת. */
             ['שבועי', 'דו-שבועי', 'חודשי', 'שנתי']
               .hasAny([request.resource.data.freq]) &&
             /* ⚠️ מחזור דו-שבועי חייב עוגן, אחרת השבוע נקבע במקרה
                והצוות מגיע בשבוע הלא נכון. אותה בדיקה שבשרת. */
             (request.resource.data.freq != 'דו-שבועי' ||
              request.resource.data.get('firstWeek', '') != '') &&
             request.resource.data.schema is int;
    }

    function gpWriteOk() {
      return hasPerm('גינון') && m().isExternal == false;
    }

    match /gardenPlan/{id} {
      allow read: if canSeePlan();
      allow create, update: if gpWriteOk() && gpShapeOk();
      /* מחיקת הגדרה — משימות שכבר נוצרו ממנה נשארות. */
      allow delete: if gpWriteOk();
    }

    /* 🔑 **נפתח לאחראי הגינון החיצוני** (הכרעת יועד, 16.9). הרשימות
       האלה הן שמות האזורים והקטגוריות — והוא כבר רואה אותם על כל
       משימה שהוא מבצע. להסתיר ממנו את הרשימה בזמן שמציגים לו את
       הערכים אינה הגנה, והיא שוברת את קיבוץ המסך במסלול Firestore.
       ⚠️ **תוכנית העבודה עצמה נשארת חסומה לו** (`canSeePlan`) — שם
          המידור אמיתי, וזה בדיוק ההבדל. */
    /* 🔴 18.9, גל 3 — **נפתח לכל חבר פעיל.**
       עד היום הקריאה דרשה הרשאת גינון, ולכן **מסך הדיווח
       של התושב** נאלץ לקרוא את אותן רשימות מ-Apps Script.
       ⚠️ מה שיש כאן הוא שמות קטגוריות ואזורים — אפשרויות
          בתפריט גלילה. אין בהן נתון על אף אדם, וכל תושב
          רואה אותן ממילא בטופס הדיווח. הכתיבה נשארת סגורה. */
    /* 🔴 דיווח #6 (2026-09-21) — **מצב ההתראות נקרא מהשרת.**
       עד היום הכפתור הסתמך אך ורק על `localStorage`, והוא נמחק
       באיפון מדי פעם — ואז הכפתור אמר "הפעלה" למרות שהמנוי
       חי בשרת. כל אחד קורא **את שלו בלבד**.
       ⚠️ הכתיבה נשארת בשרת — הוא מאמת את ה-idToken מול גוגל
          ואינו סומך על מה שהלקוח טוען שה-uid שלו. */
    match /pushSubscriptions/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /gardenMeta/{doc} {
      allow read: if isMember();
      allow write: if false;
    }
    /* 🔴 22.9 (הכרעת יועד) — הגדרות הגינון של המנהל. מסמך אחד, שלושה שדות,
       מנהל גינון פנימי בלבד. `requireApproval`: סימון גנן על תקלת דייר
       ממתין לאישור מנהל. ⚠️ שני match חופפים — Firestore מתיר אם אחד מתיר,
       ולכן ה-`write: false` למעלה אינו חוסם את המסמך הזה בלבד. */
    function gsSettingsWriteOk() {
      return canSeePlan() &&
             request.resource.data.keys().hasOnly(['requireApproval', 'updatedAt', 'updatedBy']) &&
             request.resource.data.requireApproval is bool;
    }
    match /gardenMeta/settings {
      allow write: if gsSettingsWriteOk();
    }
    /* 📌 GW-25.9:R8-rules — כללים קבועים לסידור החכם (יועד, 25.9: "למנהל וגנן
       אפשרות לשמור כללים קבועים"). מסמך אחד, טקסט אחד (כלל בשורה).
       ⚠️ מחרוזת ולא רשימה — כללים לא יודעים לאמת איבר ברשימה לפי אינדקס
       (נתקלנו בזה ב-slot.more), ואורך מחרוזת כן. */
    function gsSchedRulesOk() {
      return hasPerm('גינון') &&
             request.resource.data.keys().hasOnly(['text', 'updatedAt', 'updatedBy']) &&
             request.resource.data.text is string && request.resource.data.text.size() <= 2600 &&
             request.resource.data.updatedAt == request.time &&
             request.resource.data.updatedBy == request.auth.uid;
    }
    match /gardenMeta/scheduleRules {
      allow write: if gsSchedRulesOk();
    }

    /* ========================================================================
     *  🔴🔴  דיווחי הגינון של התושב   (2026-09-16)
     * ------------------------------------------------------------------------
     *  **התקלה שזה פותר, במילים של יועד:** "תושב אחר ממש לא רואה
     *  דיווחים של שכנים."
     *
     *  🔴 **וזו בדיוק הסיבה שהאוסף מפוצל למסמך לכל דיווח.** כלל
     *  אבטחה פועל על **מסמך שלם** ואינו יודע לסנן שורות בתוכו.
     *  מסמך אחד שמחזיק את כל הדיווחים היה חושף את כולם לכל מי
     *  שמותר לו לקרוא אותו — אין כלל שמונע את זה, כי אין מה
     *  לאכוף עליו. אותו שיקול בדיוק, ומאותה סיבה, קבע את החלוקה
     *  בתנועות התקציב.
     *
     *  🔴 **ומכאן נובע דבר שני, פחות מובן מאליו:** Firestore מאשר
     *  **שאילתה** רק אם אפשר להוכיח אותה מראש מול הכלל. שאילתה על
     *  האוסף בלי מסנן `familyId` נדחית **לפני** שנקרא ולו מסמך
     *  אחד. כלומר אין מסלול של "לקרוא הכול ולסנן בדפדפן" — לא כי
     *  זה אסור, אלא כי זה בלתי-אפשרי.
     *
     *  ⚠️ **שלושת התנאים — כל אחד נחוץ**, בדיוק כמו ב-`canSeeFamilyTx`:
     *    1. `is string` — שדה חסר או מסוג אחר מפיל את הכלל סגור.
     *    2. `!= ''` — **הקריטי.** `myFamilyId()` מחזירה `''` למי שאינו
     *       חבר או ששדה המשפחה שלו ריק, ובלי התנאי הזה `'' == ''`
     *       היה פותח לו כל מסמך חסר-משפחה. הסנכרון בשרת מדלג על
     *       שורה בלי מזהה משפחה ולכן אין מסמך כזה — **והכלל אינו
     *       נשען על זה.** שתי הגנות, בכוונה.
     *    3. השוואה למשפחה שלו — וזה הלב.
     *
     *  🔑 **שני בני המשפחה רואים את אותם דיווחים** (הכרעת יועד):
     *  המפתח הוא `familyId` ולא `uid`. בן זוג שרואה את הדיווח על
     *  הממטרה בחצר המשותפת הוא התנהגות רצויה, לא דליפה.
     *
     *  ⚠️ **המנהל אינו נכלל כאן, בכוונה.** מסכי הניהול של הדיווחים
     *  עדיין קוראים מ-Apps Script. כלל שפותח להם את האוסף עכשיו
     *  היה מעניק גישה שאיש אינו משתמש בה — וזה בדיוק סוג החשיפה
     *  השקטה שהצוות האדום תפס ב-16.9 (קוד דלת של מכון הכושר).
     *  פתיחה למנהל היא החלטה נפרדת, בצעד שבו המסך שלו באמת עובר.
     *
     *  🔴🔴 **`isExternal == false` — נוסף 16.9 אחרי סקירת צוות אדום,
     *  והוא לא היה כאן.** בלעדיו האחראי החיצוני שהוא גם תושב היה
     *  קורא את הדיווחים של **הבית שלו עצמו** — לא דליפה של אחרים,
     *  ולכן קל לפטור את זה כ"לא נורא". **וזו בדיוק הטעות.**
     *
     *  הכלל שנשבר כאן אינו "כמה נזק" אלא **הכללים לעולם אינם רחבים
     *  מהשרת**. ב-`authorize_` יושבת שורה אחת:
     *      if (perm.isExternal && need !== PERM_GARDEN) → חסום
     *  ו-`handleMyGardenReports_` קורא עם `need = null`. כלומר
     *  **השרת חוסם אותו מהדיווחים, ו-Firestore היה פותח.**
     *
     *  ⚠️ ברגע שמתירים חריגה אחת "כי היא לא מזיקה", אי אפשר עוד
     *     לענות על "האם הכללים מסכימים עם השרת" בלי לעבור אחד-אחד.
     *     האינווריאנטה היא הנכס, לא המקרה הפרטי.
     *
     *  🔑 **ומכאן ההבדל מ-`canSeeGardenTasks` מקבל הסבר מדויק:**
     *  משימות נקראות עם `need = PERM_GARDEN`, ולכן אותה שורה
     *  עצמה **מתירה** לו. שני הכללים שונים כי שני ה-`need` שונים —
     *  לא כי החלטנו כך, אלא כי כך השרת מתנהג.
     *
     *  🔒 **מה אין במסמך:** שם המדווח והטלפון נשארים בגיליון.
     *  המסמך נושא `familyId` בלבד — הוא גשר, לא זהות.
     * ====================================================================== */
    function canSeeGardenReport(fid) {
      return isMember() && m().isExternal == false &&
             fid is string && fid != '' && fid == myFamilyId();
    }

    /* ========================================================================
     *  🔴🔴  כתיבת דיווחי גינון מהדפדפן   (2026-09-16, ההיפוך)
     * ------------------------------------------------------------------------
     *  ⚠️⚠️ **זה שינוי באופי של הקובץ.** עד כאן כמעט כל אוסף הוא
     *  קריאה-בלבד, והמשפט "הדפדפן לעולם אינו כותב" חוזר בכל בלוק.
     *  כאן הוא מפסיק להיות נכון לגינון, כי Firestore הופך למסד החי
     *  והגיליון לגיבוי. כלל קריאה שגוי **חושף**; כלל כתיבה שגוי נותן
     *  לשנות נתונים של אחרים. זו קטגוריית סיכון אחרת, ולכן הבלוק
     *  הזה מפורט יותר מכל מה שמעליו.
     *
     *  🔴 **ההפרדה שמחזיקה הכול:** מסמך הדיווח נושא שני סוגי מידע —
     *  מה ש**התושב אמר** (כותרת, תיאור, מיקום, משוב) ומה ש**הצוות
     *  עשה** (שלב, סגירה, קישור למשימה, חלון משוב). ברגע שהתושב הוא
     *  הכותב, שניהם יושבים באותו מסמך והכלל הוא הדבר היחיד שמפריד.
     *  בלי ההפרדה תושב פותח תקלה ומיד מסמן אותה "הושלם", או פותח
     *  לעצמו חלון משוב אינסופי.
     * ====================================================================== */

    /* השדות שתושב רשאי לשלוח ביצירה — רשימה סגורה. */
    function grCreateFields() {
      return ['id', 'familyId', 'date', 'category', 'area', 'title', 'desc',
              'place', 'x', 'y', 'photos', 'taskId', 'clientRef',
              /* 🔴 תיבת הדואר — הדפדפן מרים דגל, והעבודה השעתית
                 שולחת ומורידה אותו. כלל אבטחה אינו יכול לשלוח מייל
                 (אין Cloud Functions בתוכנית החינמית), ולכן זה
                 המנגנון. בוליאני בלבד: **התבנית והנמענים נגזרים
                 בשרת מתוכן המסמך**, לא משדה שהלקוח בוחר. */
              'mailPending',
              /* 🔴 **כמה תמונות נשלחו מול כמה נחתו.** עד היום תמונה
                 שנכשלה נבלעה בשקט בשרת והתושב קיבל "נשלח" כרגיל —
                 כלומר שלח שלוש, נחתה אחת, ואיש לא ידע. השדות האלה
                 הופכים את הפער לנתון: התושב רואה אותו, המנהל רואה
                 אותו, והעבודה השעתית סורקת `photosIncomplete == true`
                 ומתריעה על מה שאיש לא השלים.
                 ⚠️ שוויון בלבד — השוואה בין שני שדות הייתה דורשת
                    אינדקס, והקונסולה חסומה. */
              'photosExpected', 'photosIncomplete',
              'year', 'schema', 'updatedAt'];
    }

    /* השדות שהצוות מחזיק — תושב לעולם אינו שולח אותם ביצירה.
       ⚠️ הם נוצרים כברירת מחדל בקריאה (שדה חסר = ריק), ולא
          כערכים שהלקוח בוחר. */
    function grTeamFields() {
      return ['stage', 'flag', 'closure', 'closeWhy', 'mergedInto',
              'feedback', 'feedbackUntil', 'canFeedback',
              /* 📷 23.9 — תמונות הצוות ("אחרי"). ר' gtWorkPhotosOk. */
              'workPhotos'];
    }

    function grShapeOk() {
      return request.resource.data.keys().hasOnly(grCreateFields()) &&
             request.resource.data.keys().hasAll(
               ['id', 'familyId', 'title', 'category', 'schema']) &&
             /* 🔴 אף שדה של הצוות — ר' ההפרדה בראש הבלוק. */
             !request.resource.data.keys().hasAny(grTeamFields()) &&
             request.resource.data.familyId is string &&
             request.resource.data.familyId != '' &&
             request.resource.data.title is string &&
             request.resource.data.title.size() > 0 &&
             request.resource.data.title.size() <= 60 &&
             request.resource.data.category is string &&
             request.resource.data.category != '' &&
             request.resource.data.schema is int &&
             (!request.resource.data.keys().hasAny(['mailPending']) ||
              request.resource.data.mailPending is bool);
    }

    /* מיקום: או נעיצה מנורמלת 0–1, או מיקום מילולי. בדיוק התנאי
       שהשרת אכף עד היום ב-`submitGardenReport_`. */
    function grPlaceOk() {
      return (request.resource.data.get('x', null) == null &&
              request.resource.data.get('y', null) == null &&
              request.resource.data.get('place', '') != '') ||
             (request.resource.data.get('x', null) is number &&
              request.resource.data.get('y', null) is number &&
              request.resource.data.x >= 0 && request.resource.data.x <= 1 &&
              request.resource.data.y >= 0 && request.resource.data.y <= 1);
    }

    /* 🔴 יצירה בלבד למשפחה שלו, ורק כשהוא תושב פעיל שאינו חיצוני —
       בדיוק כמו `canSeeGardenReport`, כי אותו שער בדיוק חל בשרת. */
    function grCreateOk() {
      return isMember() && m().isExternal == false &&
             request.resource.data.familyId == myFamilyId() &&
             grShapeOk() && grPlaceOk();
    }

    /* התושב רשאי לכתוב **משוב בלבד**, ורק על מסמך קיים שלו.
       ⚠️ `affectedKeys().hasOnly` הוא הלב: הוא מונע ממנו לגעת
          ב-`stage`, ב-`familyId` או בתיאור אחרי ההגשה. */
    function grFeedbackOk() {
      return isMember() && m().isExternal == false &&
             resource.data.familyId == myFamilyId() &&
             request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['feedback', 'feedbackNote', 'feedbackAt', 'updatedAt']) &&
             /* חלון המשוב נאכף כאן ולא רק במסך — המסך הוא נוחות,
                הכלל הוא ההגבלה. 0 = משימה שלא אושרה, ואז אין חלון. */
             resource.data.canFeedback == true &&
             (resource.data.get('feedbackUntil', 0) == 0 ||
              request.time.toMillis() <= resource.data.get('feedbackUntil', 0));
    }

    /* 🔴 **השלמת תמונות לדיווח שכבר הוגש.** ההעלאה היא תמונה-תמונה,
       ולכן דיווח יכול להיוולד עם חלק מהתמונות — והתושב חוזר להשלים.
       ⚠️ **`photos` בלבד**, ולא תיאור/כותרת/מיקום: דיווח אינו נערך
          אחרי ההגשה, וזה לא פתח לערוך אותו בדלת האחורית.
       ⚠️ מזהי Drive שנכתבים כאן אינם מסוכנים: הצפייה עוברת דרך
          `gardenPhoto` ב-Apps Script, שבודק הרשאה בעצמו. */
    function grPhotosOk() {
      return isMember() && m().isExternal == false &&
             resource.data.familyId == myFamilyId() &&
             request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['photos', 'photosIncomplete', 'updatedAt']);
    }

    /* הצוות מזיז את הדיווח בתהליך. ⚠️ **`familyId` אינו ברשימה —
       גם לא למנהל.** שינוי בעלות על דיווח אינו פעולה שקיימת. */
    function grTeamUpdateOk() {
      return hasPerm('גינון') &&
             request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['stage', 'flag', 'closure', 'closeWhy', 'mergedInto',
                         'taskId', 'canFeedback', 'feedbackUntil',
                         'photos', 'photosIncomplete', 'updatedAt',
                         'workPhotos']) &&
             gtWorkPhotosOk();
    }

    match /gardenReports/{id} {
      allow read: if canSeeGardenReport(resource.data.familyId);
      /* ⚠️ `create` ולא `write`: מסמך קיים נכשל מעצמו, ולכן תושב
         אינו יכול לדרוס דיווח של שכן בכך שינחש מזהה. */
      allow create: if grCreateOk();
      allow update: if grFeedbackOk() || grPhotosOk() || grTeamUpdateOk();
      /* 🔴 אין מחיקה, לאיש. דיווח שנסגר מקבל `closure`, לא היעלמות. */
      allow delete: if false;
    }

    /* ========================================================================
     *  משימות הגינון   (2026-09-16)
     * ------------------------------------------------------------------------
     *  🔴 **הכלל כאן רחב יותר מזה של `gardenPlan`, וזה נראה כמו
     *  סתירה. הוא לא.**
     *
     *  בתוכנית העבודה האחראי החיצוני **חסום במפורש** (`canSeePlan`
     *  דורש `isExternal == false`) — המידור שם אמיתי: התוכנית היא
     *  סמכות המנהל.
     *
     *  במשימות הוא **אינו** חסום, כי `handleGardenTasks_` אינו חוסם
     *  אותו: מאז 9.9 ה-scope `all` מחזיר את כל המשימות לכל מי שיש
     *  לו `PERM_GARDEN`, והחיצוני בכללם. ההגבלה על `pending` חלה רק
     *  על ה-scopes הישנים, ואינה מגיעה ל-`all` שהמסך משתמש בו.
     *
     *  ⚠️ **ולכן `hasPerm('גינון')` לבדו הוא בדיוק מה שהשרת נותן —
     *  לא פחות ולא יותר.** כלל צר יותר כאן היה שובר לגנן את המסך
     *  במסלול Firestore בלבד; כלל רחב יותר היה הרחבה שקטה.
     *  אימתתי את זה בקוד ולא הנחתי.
     *
     *  🔒 **מה אין במסמך:** `updatedBy` ('עודכן על ידי') ירד — שם של
     *  אדם שאף מסך אינו מציג. `approvedBy` נשאר, כי הוא **כן** מוצג
     *  (gardenTasks.js:663, :1606) והאוסף סגור לבעלי הרשאת גינון.
     * ====================================================================== */
    function canSeeGardenTasks() {
      return hasPerm('גינון');
    }

    /* ========================================================================
     *  🔴🔴  כתיבת משימות גינון מהדפדפן   (2026-09-16, ההיפוך)
     * ------------------------------------------------------------------------
     *  משימה נוצרת בשני מצבים: תושב מגיש דיווח (ואז נולדת משימה
     *  נלווית), או שהצוות פותח משימה בעצמו. **שני המצבים כותבים את
     *  אותו מסמך**, ולכן שני שערי יצירה.
     *
     *  🔴 **`gtFromReportOk` הוא החריג המסוכן**, וצריך לקרוא אותו
     *  לאט: הוא נותן ל**תושב** ליצור מסמך באוסף שכולו של הצוות.
     *  מה שמחזיק אותו סגור: השלב חייב להיות 'התקבל' — נקודת
     *  הפתיחה ותו לא — ואסור לו לשלוח דגל, סגירה, שבוע או אישור.
     *  כלומר הוא יכול ליצור עבודה, ולעולם לא לסמן אותה כנעשתה.
     * ====================================================================== */
    function gtFields() {
      return ['id', 'kind', 'templateId', 'title', 'category', 'area', 'x', 'y',
              'stage', 'flag', 'closure', 'week', 'due', 'note', 'drags',
              'firstWeek', 'createdAt', 'updatedAt', 'approvedBy', 'approvedAt',
              'repId', 'photos', 'order', 'year', 'schema', 'syncedAt',
              /* 🔴 22.9 — "בדרך למחיקה". הדפדפן מרים, השרת מסיים. ר' gtPendingDeleteOk. */
              'pendingDelete',
              /* 🔴 22.9 (סימולציה, ממצא C) — המשפחה על המשימה. התושב כותב אותה
                 ביצירה (gtFromReportOk), והצוות — שאינו רשאי לקרוא דיווחים —
                 קורא אותה מכאן כדי לחתום שורות יומן שהתושב יראה. מזהה אטום.
                 ⚠️ אינה ב-gtTeamUpdateOk: הצוות לעולם אינו משנה בעלות. */
              'familyId',
              /* 22.9 (ממצא B) — הדיווחים שאוחדו לתוך המשימה, כדי שהשלב שלה
                 יגיע גם אליהם. הצוות בלבד (gtTeamUpdateOk). */
              'mergedReps',
              /* 🔴 22.9 (בקשת יועד) — מי פתח תקלת צוות: 'מנהל' / 'גנן',
                 וה-uid של הפותח (הרשאת העריכה במסך). נכתבים ביצירה בלבד —
                 **אינם** ב-gtTeamUpdateOk, ולכן לעולם לא משתנים. ר' gtOpenedOk. */
              'openedBy', 'openedUid',
              /* 🔴 22.9 (הכרעת יועד: "מוצג לכולם") — תיאור ומיקום במילים.
                 התושב כותב אותם ביצירה (gtFromReportOk), הצוות ביצירה
                 ובעריכה. ר' gtTextOk לגבולות. */
              'desc', 'place',
              /* 🔴 22.9 (הכרעת יועד) — שם המדווח (פרטי + משפחה), גלוי לצוות
                 **כולל הגנן**. נכתב ביצירה בלבד — אינו ב-gtTeamUpdateOk. */
              'reporter',
              /* 📷 23.9 (בקשת יועד) — תמונות שהצוות צילם בסגירה או
                 ב"הערה/דיווח". נפרד מ-`photos` (של התושב). הצוות בלבד. */
              'workPhotos',
              /* 🌱 4.10 (דשא והשקיה) — מזהי ממטרה/מחשב/קו/מדשאה שהתקלה משויכת
                 אליהם. **השיוך נשמר רק כאן** — הצד של הממטרה נגזר, כדי שלא
                 יהיו שני מקומות לסנכרן. תושב רשאי לשלוח אותו ביצירה (שיוך
                 אוטומטי למדשאה שבה ננעץ הדיווח); הצוות — גם בעדכון. ר' gtAssetsOk. */
              'assets',
              /* 🌱 4.10 (בקשת יועד) — סוג תקלת דשא/השקיה: קו מים / ממטרה / מחשב /
                 דשא. **הצוות בלבד** (gtTeamOnly) — התושב לא רואה ולא בוחר. ר' gtFkindOk. */
              'fkind'];
    }

    /* 🌱 4.10 — עד 5 שיוכים. שדה חסר עובר (כל המשימות שלפני 4.10). */
    /* 4.10.26 — `let` אחד במקום 15 קריאות get() (ר' תקרת הביטויים ליד hasPerm),
       ובלי לבדוק בכלל כשאין שיוכים (כמעט כל משימה). */
    function gtAssetsOk() {
      let a = request.resource.data.get('assets', []);
      return a is list && a.size() <= 5 &&
             (a.size() == 0 ||
              (gtAssetAt(a, 0) && gtAssetAt(a, 1) && gtAssetAt(a, 2) && gtAssetAt(a, 3) && gtAssetAt(a, 4)));
    }

    /* כל שיוך הוא מזהה קצר — לא אובייקט. אין לולאות בכללים, ולכן 5 פעמים. */
    function gtAssetAt(a, i) {
      return a.size() <= i || (a[i] is string && a[i].size() <= 40);
    }

    /* 📷 23.9 — רשימת מזהי Drive, בגבול. 2 לפעולה; 40 הם תקרה נדיבה
       למשימה שנפתחת ונסגרת כמה פעמים. שדה חסר עובר.
       ⚠️ מזהה Drive אינו סוד: הצפייה עוברת דרך `gardenPhoto` בשרת,
          שבודק הרשאה בעצמו. */
    function gtWorkPhotosOk() {
      return request.resource.data.get('workPhotos', []) is list &&
             request.resource.data.get('workPhotos', []).size() <= 40;
    }

    /* טקסט חופשי — מחרוזת, בגבול. שדה חסר עובר (משימות ישנות, שגרה). */
    function gtTextOk() {
      return request.resource.data.get('desc', '') is string &&
             request.resource.data.get('desc', '').size() <= 1000 &&
             request.resource.data.get('place', '') is string &&
             request.resource.data.get('place', '').size() <= 120 &&
             request.resource.data.get('reporter', '') is string &&
             request.resource.data.get('reporter', '').size() <= 60;
    }

    /* השדות שרק הצוות קובע — תושב אינו שולח אותם כלל. */
    function gtTeamOnly() {
      return ['flag', 'closure', 'week', 'due', 'note', 'drags',
              'approvedBy', 'approvedAt', 'openedBy', 'openedUid', 'workPhotos', 'fkind'];
    }

    function gtShapeOk() {
      return request.resource.data.keys().hasOnly(gtFields()) &&
             request.resource.data.keys().hasAll(['id', 'title', 'stage', 'schema']) &&
             request.resource.data.title is string &&
             request.resource.data.title.size() > 0 &&
             request.resource.data.schema is int &&
             gtTextOk() && gtWorkPhotosOk() && gtAssetsOk() && gtFkindOk();
    }

    /* 🌱 4.10 — רשימה סגורה; שדה חסר עובר (כל המשימות שלפני 4.10). */
    function gtFkindOk() {
      return ['', 'line', 'spr', 'ctrl', 'lawn'].hasAny([request.resource.data.get('fkind', '')]);
    }

    /* 🔴 תושב פותח משימה נלווית לדיווח — בנקודת הפתיחה בלבד. */
    function gtFromReportOk() {
      return isMember() && m().isExternal == false &&
             gtShapeOk() &&
             request.resource.data.stage == 'התקבל' &&
             !request.resource.data.keys().hasAny(gtTeamOnly());
    }

    /* 🔴 22.9 — **הפותח הוא הכותב.** `openedUid` הוא מה שמתיר עריכה במסך,
       ולכן אסור שיהיה ה-uid של מישהו אחר. `openedBy` מרשימה סגורה.
       שני השדות אופציונליים: משימה בלעדיהם (שגרה, יזומה, תקלה ישנה)
       עוברת כמו עד היום. */
    function gtOpenedOk() {
      return (request.resource.data.get('openedUid', '') == '' ||
              request.resource.data.get('openedUid', '') == request.auth.uid) &&
             ['', 'מנהל', 'גנן'].hasAny([request.resource.data.get('openedBy', '')]);
    }

    /* הצוות פותח משימה בעצמו — בלי ההגבלה על השלב.
       ⚠️ 22.9 (הכרעת יועד): **גם הגנן החיצוני פותח תקלות** ("דיווח גנן").
          זה מה שהכלל התיר ממילא; השרת הישן חוסם, והמסך מציג את הכפתור
          לגנן רק במסלול הישיר. ר' G-06 בבחינת 22.9 — ההכרעה הפוכה. */
    function gtTeamCreateOk() {
      return hasPerm('גינון') && gtShapeOk() && gtOpenedOk();
    }

    /* ⚠️ `id` אינו ברשימה: מזהה שנקבע ביצירה אינו משתנה לעולם.
       שינוי שלו היה מנתק את הדיווח שמצביע על המשימה.
       🔴 18.9 — שלושת שדות הדואר נוספו כאן **ולא** ב-`gtFields`:
       הם ניתנים לעדכון ע"י הצוות בלבד, ולעולם לא נשלחים ביצירה —
       אחרת תושב היה יכול ליצור משימה ששולחת מייל בשם הועד. */
    function gtTeamUpdateOk() {
      return hasPerm('גינון') &&
             request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['stage', 'flag', 'closure', 'week', 'due', 'note',
                         'drags', 'firstWeek', 'title', 'category', 'area',
                         'x', 'y', 'approvedBy', 'approvedAt',
                         'repId', 'photos', 'order', 'updatedAt', 'syncedAt',
                         'notify', 'notifyPending', 'notifyNote', 'mergedReps',
                         'desc', 'place', 'workPhotos', 'assets', 'fkind']) &&
             gtTextOk() && gtWorkPhotosOk() && gtAssetsOk() && gtFkindOk();
    }

    /* ========================================================================
     *  🔴🔴  השומרים שעברו מ-Apps Script לכאן   (2026-09-18, גל 3)
     * ------------------------------------------------------------------------
     *  עד היום עשר פעולות המנהל עברו דרך `gardenTaskAction_`, ושם
     *  ישבו ההחלטות: מי רשאי לסגור, מה מותר על משימה סגורה,
     *  ומתי חובה לכתוב לתושב. מרגע שהדפדפן כותב ישירות,
     *  **שומר שיושב רק בדפדפן הוא לא שומר** — ולכן הם כאן.
     *
     *  🔑 **הבחנה שחוזרת בכולם: `repId` ולא `kind`.** הלקוח כותב
     *  `kind: 'תקלה'` (הערך הישן) בעוד השרת מכיר 'דיווח תושב'
     *  וממפה ביניהם ב-`GARDEN_KIND_LEGACY`. כלל שנשען על `kind` היה
     *  נשבר בשקט באחד הצדדים. `repId` אינו משתמע לשתי פנים:
     *  יש דיווח מאחוריה, ולכן יש אדם שמחכה לתשובה.
     * ====================================================================== */

    /* מנהל גינון — לא הגנן החיצוני. זה `perm.isExternal` שבשרת. */
    function gtMgr() {
      return hasPerm('גינון') && m().isExternal == false;
    }

    function gtNext(f) { return request.resource.data.get(f, ''); }
    function gtCur(f)  { return resource.data.get(f, ''); }

    /* סיבת סגירה מהרשימה בלבד — `GARDEN_CLOSURES` בשרת. */
    function gtClosureValueOk() {
      return gtNext('closure') == '' ||
             ['בוצע', 'הועבר לבינוי', 'בוטל', 'לא רלוונטי', 'אוחד']
               .hasAny([gtNext('closure')]);
    }

    /* 🔴 **מי סוגר.** 'בוצע' פתוח לכל בעל הרשאת גינון, כולל הגנן
       החיצוני — זו הייתה הכרעת יועד ב-9.9 ("הסימון סוגר").
       כל סיבה אחרת היא **החלטה**, ולכן מנהל בלבד. */
    function gtClosureAuthOk() {
      return gtNext('closure') == gtCur('closure') ||
             gtNext('closure') == '' ||
             gtNext('closure') == 'בוצע' ||
             /* 🔴 21.9 — **'אוחד' גם הוא פתוח לגנן החיצוני.** זו היתה
                רגרסיה שלי: הכלל הראשון התיר רק 'בוצע', ובשרת
                כתוב במפורש (8.9): "איחוד **אינו** חסום לגנן — זיהוי
                ששתי פניות הן אותה תקלה הוא שיפוט שטח, לא החלטת ועד".
                בלי זה הגנן היה נוסע פעמיים לאותה ממטרה. */
             gtNext('closure') == 'אוחד' ||
             gtMgr();
    }

    /* 🔴 סגירת פנייה של תושב מחייבת טקסט — המייל בנוי סביבו.
       זה מה שהופך את "הושלם" למשהו שאפשר לערער עליו. */
    function gtCloseNoteOk() {
      return gtNext('closure') == '' ||
             gtNext('closure') == gtCur('closure') ||
             gtCur('repId') == '' ||
             gtNext('note') != '';
    }

    /* חלון הערעור של הגנן — `GARDEN_DISPUTE_DAYS` = 14.
       ⚠️ אם `approvedAt` אינו חותמת זמן, החלון **פתוח** — בדיוק כמו
          `gardenWithinDispute_` שמחזיר true כשאין תאריך. נעילה במקרה הזה
          הייתה הופכת כל משימה ישנה לבלתי הפיכה לגנן. */
    function gtWithinDispute() {
      return !(resource.data.get('approvedAt', null) is timestamp) ||
             request.time < resource.data.approvedAt + duration.value(14, 'd');
    }

    /* 🔴🔴 **משימה סגורה** — ממצא 22, עכשיו באכיפה ולא בנוהג.
       מנהל — הכול, בלי הגבלת זמן.
       גנן חיצוני — או ניקוי דגל בלבד (המסלול שמונע מבוי סתום
       כשמשוב שלילי מרים דגל על משימה סגורה), או פתיחה מחדש
       של סגירת 'בוצע' בתוך חלון הערעור. */
    /* 4.10.26 — הבדיקות הזולות לפני gtMgr() (אותה תוצאה, סדר אחר): gtMgr היא
       הקריאה היקרה בכללים — ר' תקרת הביטויים ליד hasPerm. */
    function gtClosedOk() {
      return gtCur('closure') == '' ||
             request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['flag', 'updatedAt']) ||
             /* 📷 23.9 — התמונה עולה **אחרי** הסגירה (שגר-ושכח), ולכן הגנן
                חייב להיות רשאי להוסיף אותה למשימה שכבר נסגרה. רק שני
                השדות האלה — שום שינוי אחר במשימה סגורה. */
             request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['workPhotos', 'updatedAt']) ||
             gtMgr() ||
             (gtCur('closure') == 'בוצע' && gtNext('closure') == '' &&
              gtWithinDispute());
    }

    /* 🔴 שם התבנית מרשימה סגורה בלבד.
       ⚠️ **הנמענים אינם נשלחים מהדפדפן ולעולם לא יישלחו** — השרת
          שולף אותם מטאב התושבים לפי `familyId` של הדיווח. זה הקו
          האדום: פרטים אישיים לעולם אינם עוברים בדפדפן. */
    /* ⚠️ **הרשימה הזאת היא השומר האמיתי** — הדפדפן בוחר שם תבנית
       והשרת שולח לפיה, ולכן שם שאינו ברשימה הוא הדרך לגרום לשרת
       לשלוח לתושב תבנית שרירותית. `GARDEN_RESCHEDULED` ו-
       `GARDEN_STATUS_NOTE` נוספו ב-22.9 (ממצא 32) וחייבות להופיע
       גם ב-`GARDEN_TASK_TEMPLATES` ב-Code.gs — אחרת הדגל יירד
       בשקט בלי שיצא מייל. */
    /* 🔴 23.9 — שתי הודעות שהן **החלטת מנהל** ונושאות טקסט חופשי לתושב
       או לגנן: "הבדיקה החוזרת הסתיימה" ו"הוחזר אליך". הגנן החיצוני אינו
       שולח אותן (הדפדפן שלו גם לא מציע אותן — כאן זה נאכף). */
    function gtNotifyMgrOnlyOk() {
      return !['GARDEN_RECHECK_DONE', 'GARDENER_TASK_RETURNED'].hasAny([gtNext('notify')]) ||
             gtMgr();
    }

    function gtNotifyOk() {
      return gtNext('notify') == '' ||
             ['GARDEN_COMPLETED', 'GARDEN_REPORT_DECLINED', 'GARDEN_PLANNED',
              'GARDEN_REOPENED', 'GARDEN_REPORT_MERGED',
              'GARDEN_RESCHEDULED', 'GARDEN_STATUS_NOTE',
              /* 23.9 — מרכז ההתראות. הנמענים נקבעים בשרת לפי הטבלה. */
              'GARDEN_FINAL_CHECK', 'GARDEN_PENDING_REVIEW',
              'GARDENER_TASK_RETURNED', 'GARDEN_RECHECK_DONE'].hasAny([gtNext('notify')]);
    }

    /* השער המלא לעדכון של הצוות — כל השומרים ביחד. */
    function gtUpdateOk() {
      return gtTeamUpdateOk() && gtClosureValueOk() && gtClosureAuthOk() &&
             gtCloseNoteOk() && gtClosedOk() && gtNotifyOk() && gtNotifyMgrOnlyOk();
    }

    /* 🔴 "בדרך למחיקה" (22.9.2026) — מנהל בלבד, כמו `gtDeleteOk`.
       הדגל הוא true בלבד ומגיע לבדו (עם updatedAt): כתיבה שמשנה גם
       שדות אחרים באותה בקשה נדחית — מחיקה אינה מסווה לעריכה.
       ⚠️ הגנן החיצוני אינו מוחק — לא ישירות ולא דרך הדגל. */
    function gtPendingDeleteOk() {
      return gtMgr() &&
             request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['pendingDelete', 'updatedAt']) &&
             request.resource.data.pendingDelete == true;
    }

    /* ========================================================================
     *  🔴🔴  התמונות של התושב אל מסמך המשימה   (2026-09-17)
     * ------------------------------------------------------------------------
     *  **התקלה שזה פותר, ולמה היא לא נראתה עד היום.** כשתושב מגיש
     *  דיווח, הדפדפן כותב את התמונות לשני מסמכים: הדיווח שלו
     *  (מותר לו, `grPhotosOk`) והמשימה הנלווית — ושם `gtTeamUpdateOk`
     *  דורש `hasPerm('גינון')`. כלומר הכתיבה הזאת **נדחית לכל תושב
     *  רגיל, תמיד**, והיא נבלעה ב-callback ריק.
     *
     *  ⚠️ **היום זה לא שובר כלום**, כי הסנכרון השעתי ממלא את
     *     `photos` למשימה מתוך הגיליון (`gardenReportRefs_`).
     *     ברגע ש-`gardenWriteToFirestore` יידלק, הגיליון מפסיק להיות
     *     המקור — ואז זו משימה שהגנן פותח ורואה בלי תמונות.
     *
     *  🔒 **הגבול צר במכוון, בשלושה מימדים:**
     *    1. **רק `photos` ו-`updatedAt`.** לא שלב, לא סגירה, לא כותרת.
     *    2. **רק על המשימה של הדיווח שלו** — `repId` של המשימה חייב
     *       להצביע על דיווח שה-`familyId` שלו הוא שלו. זה `get()`
     *       נוסף, ובכוונה: בלעדיו כל תושב היה יכול לכתוב תמונות לכל
     *       משימה בשיכון בכך שינחש מזהה.
     *    3. **לא לחיצוני**, כמו בכל שאר כללי התושב כאן.
     *
     *  ⚠️ `repId` חייב להתקיים ולהיות מחרוזת — משימת שגרה אין לה
     *     דיווח מאחוריה, ובלי התנאי הזה הנתיב ל-`get()` היה נבנה
     *     ממחרוזת ריקה.
     * ====================================================================== */
    function gtReportPhotosOk() {
      return isMember() && m().isExternal == false &&
             resource.data.repId is string && resource.data.repId != '' &&
             request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['photos', 'updatedAt']) &&
             get(/databases/$(database)/documents/gardenReports/$(resource.data.repId))
               .data.familyId == myFamilyId();
    }

    /* 🔴 מחיקה למנהל בלבד — לא לקבלן החיצוני. משימה שנסגרה מקבלת
       `closure`; מחיקה שמורה לטעות הזנה, והיא הפעולה היחידה בגינון
       שאי אפשר לבטל. */
    function gtDeleteOk() {
      return hasPerm('גינון') && m().isExternal == false;
    }

    /* 🔴 **גלגול אחורה של משימה יתומה** (2026-09-18, ממצא ג').
       הדפדפן כותב שני מסמכים: קודם המשימה, אחר כך הדיווח
       (ובסדר הזה בכוונה — דיווח שמצביע למשימה שאינה קיימת
       מראה לתושב שלב ריק). כשהכתיבה השנייה נדחית, הראשונה
       נשארת כאשפה — משימה בלי מדווח ובלי מדווחן.

       ⚠️ **שלושה שומרים, והמרכזי בהם הוא `!exists`:** המחיקה
          מותרת רק כל עוד אין מסמך דיווח שמצביע על המשימה.
          ברגע שהדיווח נכתב — השער נסגר, ותושב לעולם אינו
          יכול למחוק משימה חיה של הצוות. בנוסף: רק שלב 'התקבל'
          (משימה שאיש לא נגע בה), ורק `repId` מלא — משימת
          שגרה או יזומה של הצוות אינה נכנסת לכאן כלל. */
    function gtOrphanCleanupOk() {
      return isMember() && m().isExternal == false &&
             resource.data.stage == 'התקבל' &&
             resource.data.get('repId', '') != '' &&
             !exists(/databases/$(database)/documents/gardenReports/$(resource.data.repId));
    }

    /* 🔴🔴 **משוב שלילי מרים דגל** (2026-09-21, סעיף 5).
       כשתושב לוחץ "לא הושלם", המשימה מקבלת 'דורש בדיקה חוזרת'
       וההחלטה נשארת אנושית — המשוב אינו פותח מחדש אוטומטית.

       ⚠️ הכלל הזה הוא **העתק מדויק של `gtReportPhotosOk`** על שדה אחר:
          שני שדות בלבד, **ערך יחיד אפשרי אחד**, והצלבה מול
          `repId`→`familyId`. בלי ההצלבה כל תושב היה יכול להרים
          דגל על כל משימה בשיכון בכך שינחש מזהה. */
    function gtReportFlagOk() {
      return isMember() && m().isExternal == false &&
             resource.data.get('repId', '') != '' &&
             request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['flag', 'updatedAt']) &&
             request.resource.data.flag == 'דורש בדיקה חוזרת' &&
             get(/databases/$(database)/documents/gardenReports/$(resource.data.repId))
               .data.familyId == myFamilyId();
    }


    /* ========================================================================
     *  🗓  סידור שבועי — `slot`   (GW-23.9:R3-funcs, 2026-09-23)
     * ------------------------------------------------------------------------
     *  שעה ביום בתוך השבוע: { date: 'YYYY-MM-DD', start: דקות, dur: דקות },
     *  או null. **שער נפרד וצר** — הוא משנה את `slot` ו-`updatedAt` בלבד.
     *  🔴 זה מה שמבטיח שהסידור שקוף (הכרעת יועד): אין דרכו שום נגיעה
     *     בשבוע, בגרירה, בדגל או בשלב — גם לא בטעות בקוד הלקוח.
     *  · הגנן **והמנהל** עורכים (hasPerm('גינון')) — הכרעה 23.9.
     *  · משימה סגורה או "בדרך למחיקה" — לא.
     *  · 06:00–23:00, רבע שעה לפחות. זהה ל-DAY_START/DAY_END ב-gardenSlots.js.
     * ====================================================================== */
    /* ✂️ GW-25.9:R7-parts — חלק אחד של שיבוץ. ks = המפתחות המותרים (לחלק
       הראשון מותרים גם 'p1', 'p2' — ההמשכים בימים אחרים). done = החלק הסתיים.
       🔴 מפות ולא רשימה: `more: [..]` עם שני איברים נדחה תמיד (נבדק חי
       23.9 — גם כשהבדיקה של האיבר השני הוטמעה בלי פונקציה). p1/p2 עובד. */
    function gtPartOk(s, ks) {
      return s is map &&
             s.keys().hasOnly(ks) &&
             s.keys().hasAll(['date', 'start', 'dur']) &&
             s.date is string && s.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             s.start is int && s.dur is int &&
             s.start >= 360 && s.dur >= 15 && s.start + s.dur <= 1380 &&
             /* 🗓 GW-24.9:R5-who — עובדים: רשימת מפתחות אטומים ("74:2"), בלי שמות.
                act: כמה דקות זה לקח בפועל (נשאל ב"בוצע"). שניהם אופציונליים. */
             s.get('who', []) is list && s.get('who', []).size() <= 6 &&
             s.get('act', 60) is int && s.get('act', 60) >= 5 && s.get('act', 60) <= 720 &&
             s.get('done', false) is bool;
    }
    function gtSlotOk(s) {
      return s == null ||
             (gtPartOk(s, ['date', 'start', 'dur', 'who', 'act', 'done', 'p1', 'p2']) &&   /* GW-24.9:R6-keys */
              (s.get('p1', null) == null || gtPartOk(s.p1, ['date', 'start', 'dur', 'who', 'act', 'done'])) &&
              (s.get('p2', null) == null || gtPartOk(s.p2, ['date', 'start', 'dur', 'who', 'act', 'done'])));
    }
    function gtSlotUpdateOk() {
      return hasPerm('גינון') &&
             gtCur('closure') == '' &&
             resource.data.get('pendingDelete', false) != true &&
             request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['slot', 'updatedAt']) &&
             /* זמן השרת ולא של הלקוח — אחרת אפשר היה "להחביא" שינוי
                מהגיבוי המצטבר (updatedAt > X) בתאריך ישן. */
             request.resource.data.updatedAt == request.time &&
             gtSlotOk(request.resource.data.get('slot', null));
    }

    match /gardenTasks/{id} {
      allow read: if canSeeGardenTasks();
      allow create: if gtTeamCreateOk() || gtFromReportOk();
      allow update: if gtUpdateOk() || gtReportPhotosOk() || gtReportFlagOk() || gtPendingDeleteOk();
      /* 🗓 GW-23.9:R4-allow — סידור שבועי: שער נפרד, slot + updatedAt בלבד. */
      allow update: if gtSlotUpdateOk();
      allow delete: if gtDeleteOk() || gtOrphanCleanupOk();
    }

    /* ========================================================================
     *  🔴  יומן הגינון — הוספה בלבד   (2026-09-16)
     * ------------------------------------------------------------------------
     *  היסטוריה שאינה משתכתבת. זה היה עקרון באפיון כשהיומן היה טאב
     *  בגיליון, והוא נשמר כאן **באכיפה ולא בנוהג**: אין `update`,
     *  אין `delete`, לאיש, אף פעם.
     *
     *  🔴 **`actorUid` נאכף להיות הכותב עצמו.** כשהדפדפן כותב את
     *  היומן, "מי עשה את זה" הופך לשדה שהכותב ממלא — כלומר בלי
     *  הכלל הזה כל אחד יכול לרשום פעולה בשם מישהו אחר. זה ההבדל
     *  בין יומן לבין רשימת טענות.
     *  ⚠️ **uid ולא שם** — ר' ההחלטה על `residentDirectory`: השם
     *     נפתר בשרת בעת הצורך, ולא נשמר כאן.
     * ====================================================================== */
    /* 🔴 22.9 (בקשת יועד) — **חותם על שורת היומן.** `who` הוא שם התצוגה
       של הכותב; `role` הוא מה שקובע איך הוא מוצג ("מנהל גינון" / "<שם> ·
       גנן" / שם התושב) — ולכן **הוא** נאכף מול מסמך החבר: תושב אינו יכול
       לחתום "מנהל", ומשתמש פנימי אינו יכול לחתום "גנן". שני השדות
       אופציונליים — שורות ישנות ודפדפן ישן עוברים כמו עד היום. */
    function glRoleOk() {
      return request.resource.data.get('who', '') is string &&
             request.resource.data.get('who', '').size() <= 60 &&
             (request.resource.data.get('role', '') == '' ||
              request.resource.data.get('role', '') == 'תושב' ||
              (request.resource.data.get('role', '') == 'גנן' && m().isExternal == true) ||
              (request.resource.data.get('role', '') == 'מנהל' && m().isExternal == false &&
               hasPerm('גינון')));
    }

    function glCreateOk() {
      return hasPerm('גינון') && glRoleOk() &&
             request.resource.data.keys().hasOnly(
               ['taskId', 'kind', 'field', 'from', 'to', 'actorUid',
                'note', 'at', 'schema', 'familyId', 'who', 'role']) &&
             request.resource.data.keys().hasAll(['taskId', 'actorUid', 'at']) &&
             request.resource.data.actorUid == request.auth.uid;
    }

    /* 🔴 גם התושב רושם ביומן — הגשת דיווח ומשוב הן אירועים בהיסטוריה.
       אותה אכיפה על `actorUid`, ובלי אפשרות לגעת בשלב. */
    function glNext(f) { return request.resource.data.get(f, ''); }

    /* 🔴🔴 **הסוגים שתושב רשאי לראות — ברמת הכלל ולא ברמת המסך.**
       (2026-09-22, ממצא 32.) המסך מסנן "חסימה" ו"דגל" החוצה, אבל
       **מסך שמסנן אינו שומר**: מי שיפתח קונסולה ויריץ את השאילתה
       בעצמו יראה כל שורה שהכלל מתיר. הצוות כותב "חסימה — צריך
       קבלן" מתוך הנחה שזה פנימי, ולכן הגבול חייב לשבת כאן.
       🔑 **שתי הגנות בלתי תלויות:** `gardenLogAppend` בלקוח אינו
          חותם `familyId` על סוג פנימי מלכתחילה, והכלל הזה מסרב לו
          גם אם מישהו יחתום בעתיד. אחת מהן מספיקה; שתיהן הן
          האינווריאנטה.
       ⚠️ "איחוד" אינו כאן — הטקסט שלו נושא מזהי משימות פנימיים,
          ולתושב יש עליו כרטיס ומייל משלו. */
    function glResidentKinds() {
      /* 🔴 23.9 — סוג ההחזרה ירד (תיקון דחוף 2): הערה בין המנהל לגנן. */
      return ['נפתח', 'שיבוץ', 'גרירה', 'הערה',
              'ביטול ביצוע', 'ביצוע', 'סגירה', 'משוב'];
    }

    function glResidentCreateOk() {
      return isMember() && m().isExternal == false && glRoleOk() &&
             request.resource.data.keys().hasOnly(
               ['taskId', 'kind', 'field', 'from', 'to', 'actorUid',
                'note', 'at', 'schema', 'familyId', 'who', 'role']) &&
             request.resource.data.keys().hasAll(['taskId', 'actorUid', 'at']) &&
             request.resource.data.actorUid == request.auth.uid &&
             /* 🔴 **ורק המשפחה שלו** (2026-09-22, ממצא 32). בלי השורה
                הזאת תושב יכול לחתום שורת יומן על המשפחה של השכן —
                לא דליפה של נתוני אחרים, אבל הזרקת טקסט לקו הזמן שלהם.
                ⚠️ ריק עדיין מותר: שורה בלי `familyId` אינה מגיעה
                   לאיש, ולכן היא לא פרצה — והחלופה היתה לאבד שורת
                   יומן בשקט בכל רגע שבו המשפחה עוד לא נטענה. */
             (glNext('familyId') == '' ||
              glNext('familyId') == myFamilyId()) &&
             (request.resource.data.kind == 'נפתח' ||
              request.resource.data.kind == 'משוב');
    }

    /* ========================================================================
     *  🔴 **התושב קורא את ההיסטוריה של הדיווח שלו**   (2026-09-22, ממצא 32)
     * ------------------------------------------------------------------------
     *  עד היום היומן היה כולו פנימי, ולתושב לא היה שום חיווי על מה
     *  שקרה לדיווח שלו בין הפתיחה לסגירה — שיבוץ, דחייה וביטול קרו
     *  בשקט מוחלט.
     *
     *  🔑 **הגבול הוא `familyId` שעל השורה עצמה, ולא הצטלבות לאוסף
     *  אחר.** כלל פועל על מסמך שלם; `get()` על מסמך הדיווח היה עובד
     *  על מסמך בודד אבל **נשבר בשאילתה** — מכסת קריאות הכלל היא
     *  עשר, וקו זמן ארוך מזה היה מוחזר כשגיאה. לכן השורה נושאת את
     *  המזהה בעצמה.
     *
     *  ⚠️ **`myFamilyId() != ''` הוא התנאי שמחזיק את כל השאר.** היא
     *     מחזירה `''` למי שאינו חבר, ואז `'' == ''` היה פותח את כל
     *     שורות היומן שאין להן משפחה. אותה מלכודת בדיוק כמו
     *     ב-`canSeeFamilyTx`.
     *
     *  ⚠️ שורה בלי `familyId` — משימת שגרה, איחוד, פעולה פנימית —
     *     אינה נקראת לעולם ע"י תושב. זה הגבול, לא תופעת לוואי.
     * ====================================================================== */
    function glResidentReadOk() {
      return isMember() && myFamilyId() != '' &&
             resource.data.get('familyId', '') == myFamilyId() &&
             glResidentKinds().hasAny([resource.data.get('kind', '')]);
    }

    match /gardenLog/{id} {
      /* 🔴 22.9.2026 — `gtMgr()` ולא `canSeeGardenTasks()`.
         שתיהן דורשות הרשאת 'גינון', אבל רק `gtMgr()` מוסיפה
         `isExternal == false`. רשימת השדות המותרת ביומן כוללת
         `familyId` (ר' glCreateOk), ולכן הקבלן החיצוני קרא את יומן
         הגינון של **כל** המשפחות בשיכון.
         ⚠️ קריאת המשימות (gardenTasks, למעלה) נשארה
            `canSeeGardenTasks()` בכוונה — הקבלן חייב לראות משימות.
         ⚠️ המשמעות: לקבלן אין גישה ליומן ב-Firestore כלל.
            מסך הניהול קורא את היומן דרך Apps Script
            (`fsFirstRead("gardenLog", false, ...)`), ולכן שום דבר לא
            נשבר היום. אם היומן יעבור ל-Firestore — הפתרון הוא
            להוציא את `familyId` מהמסמך, לא להחזיר את הכלל. */
      allow read: if gtMgr() || glResidentReadOk();
      allow create: if glCreateOk() || glResidentCreateOk();
      /* 🔴🔴 היסטוריה אינה משתכתבת. */
      allow update, delete: if false;
    }

    /* ---------- שירותים לתושב (צעד 04ב) ---------- */

    /* 🔑 **הדרישה כאן רחבה יותר בכוונה, והיא מעתיקה בדיוק את השרת.**
       `handleServices_` קורא ל-`authorize_(ss, p, null)` — כל תושב פעיל רואה
       את רשימת השירותים, בלי צורך בהרשאה מיוחדת. זה מידע קהילתי
       מפורסם (גז, אינטרנט, בריכה), לא נתונים של אדם מסוים.

       ⚠️ **אבל `null` ב-`authorize_` אינו "לכולם".** השער החיצוני שם חוסם
       משתמש חיצוני מכל פעולה שאינה גינון — ולכן גם משירותים.
       אם הכלל כאן היה מסתפק ב-`isMember()`, הקריאה הישירה היתה **רחבה
       יותר מהשרת** — וזו בדיוק הסטייה השקטה שהמעבר הזה עלול לייצר. */
    function canSeeServices() {
      return isMember() && m().isExternal == false;
    }

    match /services/{id} {
      allow read: if canSeeServices();
      /* 🔴 כמו בכל האוספים: הדפדפן לעולם אינו כותב. */
      allow write: if false;
    }

    /* מסמך מטא נפרד לקטגוריות השירותים (2026-09-22) — אותו דפוס בדיוק
       כמו gardenMeta/lists: קטן, בלי מידע אישי, נקרא תמיד יחד עם
       השירותים. אותו שער בדיוק כמו services/{id} — לא הומצא כלל חדש. */
    match /servicesMeta/{doc} {
      allow read: if canSeeServices();
      allow write: if false;
    }

    /* ---------- לוח האירועים הקהילתי (2026-09-23) ---------- */

    /* 🔑 **מעתיק בדיוק את `eventsList` בשרת.** שם הפעולה אינה ב-ACTION_PERMS,
       כלומר `authorize_` עם need ריק — כל תושב פעיל. והשער החיצוני חוסם
       משתמש חיצוני (הגנן) מכל פעולה שאינה גינון, ולכן גם מכאן.
       ⚠️ `== false` ולא `!= true` — שדה חסר נכשל סגור.
       🔴 המסמך `eventsCal/{year}` הוא מראה של יומני הקהילה (מודל א'). אין
       בו מידע אישי: `birthdays` לעולם לא נכתב לכאן (EVENTS_FS_SKIP בשרת),
       והשדות עוברים ברשימת היתר (eventsWriteFs_). */
    function canSeeEvents() {
      return isMember() && m().isExternal == false;
    }

    match /eventsCal/{year} {
      allow read: if canSeeEvents();
      /* הדפדפן לעולם אינו כותב — רק Apps Script, מהיומן. */
      allow write: if false;
    }

    /* ---------- מטא-התקציב לפי שנה (צעד 08א) ---------- */

    /* 🔑 **הכלל הזה מעתיק בדיוק את `seesBudget` שב-doGet.**
       שם: `perm.isSuper || perms.indexOf(PERM_BUDGET) !== -1`. תושב בלי
       הרשאת תקציב מקבל היום `budget: [], income: [], groups: [],
       splits: [], items: []` — כלומר **שום דבר**. אם הכלל כאן
       היה מסתפק ב-`isMember()`, הקריאה הישירה היתה חושפת
       לכל תושב את כל תכנית התקציב — דלת אחורית שלמה
       למידור שהשרת אוכף מהיום הראשון.

       ⚠️ `isExternal == false` מאותה סיבה כמו בשאר: `authorize_` חוסם
          משתמש חיצוני מכל פעולה שאינה גינון. ושוב `== false`
          ולא `!= true`, כדי ששדה חסר ייכשל-סגור.

       🔴 **אין כאן תנועות, וזה העיקר.** חמש הטבלאות שכן כאן
       נבדקו ואין בהן נתונים אישיים (`משפחות` בהכנסות הוא
       **מספר**). תנועות נושאות מזהה משפחה ודורשות סינון
       לפי משפחה בכלל עצמו — אוסף נפרד, בצעד נפרד (08ב).
       **אסור להוסיף תנועות למסמך השנה הזה** — הכלל כאן הוא
       הכול-או-לא-כלום, והוא אינו יודע לסנן שדות בתוך מסמך. */
    function canSeeBudget() {
      return hasPerm('תקציב') && m().isExternal == false;
    }

    /* מי רואה מסמך תנועות של משפחה אחת.
       🔴 **שלושת התנאים בענף התושב — כל אחד נחוץ:**
       1. `is string` — שדה חסר או מסוג אחר מפיל את הכלל סגור.
       2. `!= ''` — **התנאי הקריטי.** דלי החסרי-משפחה נשמר עם
          `familyId: ''`, ו-`myFamilyId()` מחזירה `''` למי שאינו חבר
          או ששדה המשפחה שלו ריק. בלי התנאי הזה `'' == ''`
          היה פותח לו את כל התנועות הלא-משויכות.
       3. ההשוואה עצמה. */
    function canSeeFamilyTx(fid) {
      return canSeeBudget() ||
             (fid is string && fid != '' && fid == myFamilyId());
    }

    match /budgetYears/{year} {
      allow read: if canSeeBudget();
      /* 🔴 כמו בכל האוספים: הדפדפן לעולם אינו כותב. */
      allow write: if false;
    }

    /* ------------------------------------------------------------------
       תנועות — מסמך לכל (שנה, משפחה)   (צעד 08ב, 2026-09-15)

       🔴 **הכלל הראשון כאן שהוא לא "הכל או כלום".** תושב רואה את
       של משפחתו ובלבד. בדיוק בשביל זה החלוקה היא למסמך
       לכל משפחה: כלל פועל על **מסמך שלם** ואינו יודע לסנן
       שורות בתוך מסמך. מסמך אחד לכל השנה היה חושף לכל
       תושב את ההוצאות של כל השכנים.

       🔴 **שלושת התנאים בענף התושב — כל אחד נחוץ:**
       1. `is string` — שדה חסר או מסוג אחר מפיל את הכלל סגור.
       2. `!= ''` — **התנאי הקריטי.** דלי החסרי-משפחה נשמר עם
          `familyId: ''`, ו-`myFamilyId()` מחזירה `''` למי שאינו חבר
          או ששדה המשפחה שלו ריק. בלי התנאי הזה `'' == ''`
          היה פותח לו את כל התנועות הלא-משויכות.
       3. ההשוואה עצמה.

       ⚠️ **אין כאן צורך באינדקס מורכב** (וזה קריטי — קונסולת
       Google Cloud חסומה ב-2SV): מצעד 09 יש **מסמך לכל תנועה**,
       והקריאה היא שאילת שוויון: בעל התקציב מסנן `year ==`
       בלבד, והתושב `year ==` וגם `familyId ==`. שתי שאילתות שוויון
       על שדות שונים נשרתות מהאינדקסים האוטומטיים (מיזוג זיגזג).
       🔴 **אל תוסיף מיון או אי-שוויון** — הם ידרשו אינדקס
       שאי-אפשר ליצור, והשאילתה תיפול בייצור.
       ------------------------------------------------------------------ */
    /* שלבי הסטטוס כפי שהם נשמרים בגיליון (STATUS_HE ב-Code.gs). */
    function txLegalStep(from, to) {
      return (from == 'הוגשה קבלה' && (to == 'בבדיקה' || to == 'הועבר להנה"ח' || to == 'נדחה')) ||
             (from == 'בבדיקה'   && (to == 'הועבר להנה"ח' || to == 'נדחה')) ||
             (from == 'הועבר להנה"ח' && (to == 'שולם' || to == 'נדחה'));
    }

    /* הכתיבה היחידה שהדפדפן מורשה לעשות על תנועה.
       🔴 **שלושה תנאים, וכל אחד נחוץ בפני עצמו:**
       1. **רק ארבעה שדות משתנים** (`hasOnly`). בלעדיו הדפדפן
          יכול לשנות סכום, סעיף או מזהה משפחה — כלומר להעביר
          כסף למשפחה אחרת או לנפח הוצאה.
       2. **מעבר חוקי בלבד.** אי-אפשר לקפוץ מ"הוגשה" ל"שולם"
          בלי לעבור באישור, ואי-אפשר להחזיר מ"שולם" אחורה.
       3. **`statusPending` חייב לעלות ל-true.** זה מה שגורם לטריגר
          להחיל על הגיליון ולסנכרון לא לדרוס. כתיבה בלעדיו
          היתה נעלמת בסנכרון הבא — שינוי שנראה שנשמר ונעלם.
       ⚠️ יצירה ומחיקה סגורות לגמרי — הן שייכות לסנכרון בלבד. */
    function txStatusUpdateOk() {
      return canSeeBudget() &&
             request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['סטטוס', 'הערת בדיקה', 'statusPending', 'updatedAt']) &&
             request.resource.data.statusPending == true &&
             /* ⚠️ **סוגריים מרובעים ולא נקודה.** מזהה בשפת הכללים
                חייב להיות ASCII; גישה בנקודה לשדה עברי היא שגיאת פרסור
                שמפילה את פרסום הכללים כולו. */
             request.resource.data['סטטוס'] is string &&
             txLegalStep(resource.data['סטטוס'], request.resource.data['סטטוס']);
    }

    /* ========================================================================
     *  כתיבת תנועות מהדפדפן   (צעד 09ב-2, 2026-09-15)
     * ------------------------------------------------------------------------
     *  🔴 **רשימת היתר, לעולם לא רשימת חסימה.** טאב התנועות הוא מבנה
     *  פתוח, והלקוח אוסף כל עמודה לא מוכרת. עם רשימת חסימה, שדה חדש
     *  שמישהו יוסיף מחר (טלפון, הערה אישית) היה נכתב ל-Firestore בלי
     *  ששורה אחת בכלל תשתנה. שדה שאינו ברשימה — הכתיבה נדחית כולה.
     *
     *  🔴 **`רוכש` אינו ברשימה, בכוונה.** זה שם של אדם. החריג היחיד
     *  (שורה בלי מזהה משפחה) הוא של הסנכרון בצד השרת בלבד; הדפדפן
     *  לעולם לא כותב שם, ומשפחה היא דרישה בכל תנועה חדשה.
     *
     *  🔴 **סטטוס ופרטים נפרדים לחלוטין.** `txStatusUpdateOk` מטפל
     *  בסטטוס ואוכף מעבר חוקי; `txDetailsUpdateOk` מטפל בשאר ו**אוסר
     *  לגעת בסטטוס**. בלי ההפרדה, "עריכת פרטים" היתה דלת אחורית
     *  לקפוץ מ"הוגשה" ל"שולם" בלי לעבור באישור.
     * ====================================================================== */
    function txAllowedFields() {
      return ['מזהה', 'חודש הגשה', 'תאריך רכישה', 'ספק/נמען', 'בנק', 'סכום',
              'סעיף', 'תת-סעיף', 'סוג הוצאה', 'מקור', 'סטטוס', 'הערת בדיקה',
              'תיאור', 'שם קובץ קבלה', 'קישור קבלה', 'מזהה משפחה',
              /* 🔴 תאריך ההגשה המדויק — `staleNudgeJob_` מחשבת ממנו כמה ימים
                 הבקשה תקועה. בלעדיו הנדנוד מפסיק לעבוד בשקט (צעד 09ב-4). */
              'הוגש בתאריך',
              'year', 'familyId', 'statusPending', 'mailPending',
              'schema', 'updatedAt'];
    }

    /* השדות שחייבים להופיע בכל מסמך חדש. */
    function txRequiredFields() {
      return ['מזהה', 'סכום', 'סטטוס', 'מקור', 'מזהה משפחה',
              'year', 'familyId', 'schema', 'updatedAt'];
    }

    /* 🔴 המזהה של המסמך נגזר מהתוכן — אחרת אפשר ליצור מסמך בשם של
       שנה אחת ולשים בו שנה אחרת, והשאילתה לפי שנה תפספס אותו. */
    function txIdMatches(docId) {
      return docId == request.resource.data.year + '__' +
                      string(request.resource.data['מזהה']);
    }

    function txShapeOk(docId) {
      return request.resource.data.keys().hasOnly(txAllowedFields()) &&
             request.resource.data.keys().hasAll(txRequiredFields()) &&
             txIdMatches(docId) &&
             request.resource.data['מזהה'] is int &&
             request.resource.data['סכום'] is number &&
             request.resource.data.year is string &&
             request.resource.data.schema is int &&
             request.resource.data.familyId is string &&
             request.resource.data.familyId != '' &&
             request.resource.data.familyId == request.resource.data['מזהה משפחה'] &&
             request.resource.data.statusPending == false;
    }

    /* תושב פותח בקשת החזר על שם משפחתו בלבד, תמיד בסטטוס הפתיחה.
       ⚠️ `mailPending` מותר כאן — כלל אבטחה אינו יכול לשלוח מייל,
          והטריגר הוא זה ששולח. אבל הוא **בוליאני בלבד**, והתבנית
          נגזרת בשרת ממצב המסמך ולא משדה שהלקוח בוחר. */
    function txResidentCreateOk(docId) {
      return isMember() && txShapeOk(docId) &&
             request.resource.data.familyId == myFamilyId() &&
             request.resource.data['מקור'] == 'תושב' &&
             request.resource.data['סטטוס'] == 'הוגשה קבלה' &&
             request.resource.data['סכום'] > 0 &&
             (!request.resource.data.keys().hasAny(['mailPending']) ||
              request.resource.data.mailPending is bool) &&
             !request.resource.data.keys().hasAny(['הערת בדיקה']);
    }

    /* בעל הרשאת תקציב מזין הוצאה — כל מקור, אבל לא סטטוס סופי משלב אפס. */
    function txAdminCreateOk(docId) {
      return canSeeBudget() && txShapeOk(docId) &&
             (!request.resource.data.keys().hasAny(['mailPending']) ||
              request.resource.data.mailPending is bool) &&
             (request.resource.data['סטטוס'] == 'הוגשה קבלה' ||
              request.resource.data['סטטוס'] == 'הועבר להנה"ח');
    }

    /* ======================================================================
     *  Q1 (1.10.2026, אישור יועד) — "מקור" ו"משפחה" בעריכת הוצאה
     * ----------------------------------------------------------------------
     *  עד היום שלושת שדות הבעלות לא היו ברשימה, והשינוי נשמר רק דרך
     *  Apps Script (המסלול העוקף בונה את המסמך מחדש מהגיליון — ובמקרה
     *  נדיר, תוך שעה מהגשה, עלול לאבד 'הוגש בתאריך' או מייל שממתין).
     *
     *  🔴 **שלושתם יחד או אף אחד** — `familyId` הוא מה שכלל הקריאה
     *     (`canSeeFamilyTx`) בודק, ו'מזהה משפחה' הוא מה שהגיליון מציג.
     *     שני שדות שנפרדים = משפחה אחת רואה הוצאה שהגיליון משייך לאחרת.
     *  🔴 **משפחה קיימת בלבד** — `famRegistry/ids` הוא רשימת המזהים
     *     שהשרת כותב מטאב "תושבים" (`famRegistryWrite_`: בכל שינוי
     *     בתושבים + בכל שעה). מזהה שאינו שם = הוצאה שאף משפחה לא תראה.
     *     ⚠️ המסמך אינו קריא לאף אחד (אין לו `match` — נופל לכלל הסוגר).
     *        `get()` בתוך כלל עוקף את כללי הקריאה, אז זה עובד.
     *     ⚠️ רשימה ישנה (משפחה שנוספה לפני פחות משעה) = הכלל דוחה,
     *        והלקוח נופל ל-Apps Script כמו היום. לא שבירה — רק איטי.
     *  ⚠️ מעבר מ"בלי משפחה" למשפחה (או להפך) לא מגיע לכאן בכלל — רק
     *     השרת יודע להוריד/להחזיר את שם הרוכש (ר' EXB2 ב-dataService).
     * ====================================================================== */
    function txOwnerOk() {
      return request.resource.data.get('מקור', '') in ['מנהל', 'תושב'] &&
             request.resource.data.familyId is string &&
             request.resource.data.familyId != '' &&
             request.resource.data.familyId == request.resource.data.get('מזהה משפחה', '') &&
             request.resource.data.familyId in
               get(/databases/$(database)/documents/famRegistry/ids).data.ids;
    }

    /* עריכת פרטים — כל מה שאינו סטטוס. */
    function txDetailsUpdateOk() {
      return canSeeBudget() &&
             request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['חודש הגשה', 'תאריך רכישה', 'ספק/נמען', 'בנק', 'סכום',
                         'סעיף', 'תת-סעיף', 'סוג הוצאה', 'תיאור',
                         'שם קובץ קבלה', 'קישור קבלה', 'updatedAt',
                         'מקור', 'מזהה משפחה', 'familyId']) &&
             (!request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['מקור', 'מזהה משפחה', 'familyId']) || txOwnerOk()) &&
             request.resource.data['סכום'] is number &&
             request.resource.data['סכום'] > 0;
    }

    match /budgetTx/{docId} {
      allow read: if canSeeFamilyTx(resource.data.familyId);
      allow create: if txResidentCreateOk(docId) || txAdminCreateOk(docId);
      allow update: if txStatusUpdateOk() || txDetailsUpdateOk();
      allow delete: if canSeeBudget();
    }

    /* ========================================================================
     *  מונה המזהים הרצים   (צעד 09ב-1, 2026-09-15)
     * ------------------------------------------------------------------------
     *  🔴 **למה זה קיים:** לתנועה יש מזהה קצר (1, 2, 3…)
     *  שמופיע במיילים לתושבים ובשיחות. עד היום Apps Script
     *  ספר אותו מהגיליון; כשהדפדפן יכתוב תנועות ישירות
     *  אין מי שיספור — ושני אנשים שמזינים באותו רגע היו מקבלים
     *  את אותו מספר.
     *
     *  🔴 **הכלל הזה הוא כל מה שמגן:** חבר יכול לקדם את המונה
     *  **באחד בלבד**, לעולם לא להוריד ולא לקפוץ. הורדה היתה
     *  גורמת לתנועה הבאה **לדרוס תנועה קיימת**. הנזק הגרוע
     *  ביותר שאפשר לעשות דרך הכלל הזה הוא לשרוף מספרים —
     *  מספר חסר ברצף, לא נתון שנאבד.
     *
     *  ⚠️ **יצירה ומחיקה סגורות.** המונה נזרע ע"י Apps Script
     *  מתוך המזהה הגבוה בגיליון. מונה שהדפדפן היה יוצר
     *  לבד היה מתחיל מאפס ומתנגש בכל 150 התנועות הקיימות.
     * ====================================================================== */
    function counterBumpOk() {
      return isMember() &&
             request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['n', 'updatedAt']) &&
             request.resource.data.n is int &&
             request.resource.data.n == resource.data.n + 1;
    }

    match /counters/{id} {
      allow read: if isMember();
      allow update: if counterBumpOk();
      allow create, delete: if false;
    }

    /* ---------- דגלי זמן ריצה (צעד 05א) ---------- */

    /* קונפיגורציה של האפליקציה, לא נתונים: אילו תחומים נקראים
       ישירות מ-Firestore. כל חבר פעיל צריך אותה — גם אחראי הגינון
       החיצוני, שהמסכים שלו ישתמשו בה בעתיד. אין כאן שום מידע
       שהחשיפה שלו מזיקה — בוליאנים של אילו מסלולים דלוקים.

       🔴 **כתיבה אסורה לחלוטין.** מי שיכול לערוך את המסמך הזה
       יכול לכבות לכל השיכון מסלולים, או להדליק תחום שעדיין לא
       נבדק. השינוי עובר דרך Apps Script (פעולת flagSet, מנהל-על בלבד). */
    match /appConfig/{doc} {
      allow read: if isMember();
      allow write: if false;
    }

    /* ======================================================================
     *  סטטוס מנוי כושר   (צעד 10ב-1, 2026-09-15)
     * ----------------------------------------------------------------------
     *  🔴🔴 **כל אחד את שלו בלבד, ובלי שום חריג.** אין כאן
     *  מסלול למנהל ואין מסלול למשפחה: מנוי כושר הוא של
     *  **אדם**, ובשורת תושבים אחת יושבים שני בני זוג עם אותו
     *  `familyId` — כלל לפי משפחה היה חושף לבן/בת הזוג את
     *  המנוי של השני. המסנך הוא מזהה המסמך עצמו.
     *
     *  ⚠️ **מסך הניהול של המכון אינו עובר לכאן ולעולם לא יעבור**
     *     — הוא מציג שמות, ת.ז. ותשובות שאלון בריאות, ואלה
     *     נשארים בגיליון מאחורי `authorize_` עם PERM_GYM.
     *  ⚠️ **קוד הכניסה אינו במסמך הזה.** כללי Firestore מגנים על
     *     מסמכים ולא על שדות, ולכן קוד שהיה נוסע כאן היה נקרא
     *     גם ע"י מי שהמנוי שלו פג. ר' ההערה ב-`gymStatusSyncAll_`.
     * ==================================================================== */
    /* 🔴🔴 **`isMember()` ולא `signedIn()` — תוקן 16.9.2026.**
       הכלל המקורי הסתפק ב"המסמך שלך", והחמיץ את **מתג הכיבוי**:
       תושב שסומן "עזב" מקבל `members/{uid}.active = false` מיד
       (`fbSyncRow_`), ו-`authorize_` בשרת דוחה אותו באותו רגע. הכלל
       כאן המשיך לתת לו את המסמך — כלומר **רחב מהשרת**, וזה בדיוק
       מה שאסור. מי שעזב את השיכון היה ממשיך לראות את מנוי הכושר
       שלו כל עוד הוא מחובר.
       ⚠️ `isExternal == false` מאותה סיבה כמו בכל שאר הכללים:
          `authorize_` חוסם משתמש חיצוני מכל פעולה שאינה גינון. */
    function canSeeGymStatus(uid) {
      return isMember() && m().isExternal == false && request.auth.uid == uid;
    }

    match /gymStatus/{uid} {
      allow read: if canSeeGymStatus(uid);
      /* הגיליון מקור האמת; Apps Script כותב דרך OAuth ועוקף
         את הכללים. הדפדפן לעולם אינו כותב כאן. */
      allow write: if false;
    }

    /* ======================================================================
     *  קוד הכניסה למכון   (צעד 10ב-3, 2026-09-16)
     * ----------------------------------------------------------------------
     *  🔴🔴 **הכלל היחיד כאן שתלוי בזמן, ובכוונה.**
     *  `handleGymMy_` בשרת מוסר את הקוד רק אם הסטטוס "פעיל"
     *  **וגם** `בתוקף עד >= היום` — בדיקה שנעשית בכל קריאה
     *  ולכן מדויקת לשנייה. הסנכרון לכאן, לעומת זאת, רץ פעם
     *  בשעה. כלל שהיה מסתפק ב"המסמך שלך" היה מותיר קוד בידי
     *  מי שהמנוי שלו פג — עד שעה של גישה שהשרת כבר שולל,
     *  כלומר **כלל רחב מהשרת**, וזה בדיוק מה שאסור.
     *  לכן המסמך נושא `validUntil` כחותמת זמן, והכלל משווה
     *  אליה את `request.time`. הפקיעה מדויקת לשנייה.
     *
     *  🔴 **וזו הסיבה שזה מסמך נפרד מ-`gymStatus`.** כלל פועל על
     *  מסמך שלם ואינו יודע לסנן שדות; קוד שהיה יושב בתוך
     *  מסמך הסטטוס היה נקרא תמיד ע"י בעליו.
     *
     *  ⚠️ **`is timestamp` אינו קישוט.** שדה חסר או מסוג אחר
     *     היה מפיל את ההשוואה לשגיאת הערכה. כאן זה נכשל-סגור
     *     ממילא, אבל הצורה המפורשת אומרת את זה בקול.
     *  ⚠️ המסמך גם **נכתב מלכתחילה רק למי שזכאי** ונמחק ממי
     *     שאינו (ר' `gymStatusSyncAll_`). שני שערים בלתי
     *     תלויים; טעות באחד אינה מספיקה כדי לדלוף.
     * ==================================================================== */
    /* 🔴 **פונקציה בעלת שם, ולא תנאי פרוש בתוך ה-`match`.** זה כלל
       הקובץ מ-15.9: תנאי שנדחף בשורה אחת בתוך `match` הוא בדיוק מה
       שמחליק פנימה בלי שאיש יראה אותו. יש בדיקה שאוכפת את זה. */
    function canSeeGymCode(uid) {
      /* 🔴🔴 **`canSeeGymStatus` ולא `signedIn()` — תוקן 16.9.2026, לפני
         הפרסום הראשון.** התנאי המקורי בדק רק "המסמך שלך" + תוקף, והחמיץ
         את מתג הכיבוי: תושב שעזב מקבל `active:false` מיד, `authorize_`
         דוחה אותו באותו רגע — אבל `gymUidByEmail_` בונה את מפת
         האימיילים מטאב התושבים **בלי להסתכל בסטטוס**, ולכן הסנכרון
         השעתי היה ממשיך לכתוב לו קוד עד תום תקופת המנוי.
         מי שעזב את השיכון היה שומר את **קוד הדלת** של המכון לחודשים.
         ⚠️ שני התנאים אינם עודפים זה לזה: `validUntil` סוגר את פער
            השעה מול פקיעת המנוי, ו-`isMember()` סוגר את פער העזיבה.
            כל אחד מהם לבדו משאיר דלת פתוחה. */
      return canSeeGymStatus(uid) &&
             resource.data.validUntil is timestamp &&
             request.time < resource.data.validUntil;
    }

    match /gymCode/{uid} {
      allow read: if canSeeGymCode(uid);
      allow write: if false;
    }

    /* ======================================================================
     *  מוני עמוד הבית   (פעולה 3, 2026-09-16)
     * ----------------------------------------------------------------------
     *  חמש תגיות ספירה, כל אחת מספר אחד. אין כאן שום
     *  מידע אישי — לא שם, לא אימייל, ולא מזהה משפחה.
     *
     *  🔴🔴 **מסמך לכל הרשאה, וזו הסיבה היחידה לפיצול.**
     *  כלל פועל על מסמך שלם ולא על שדה. מסמך אחד עם חמש
     *  הספירות היה נותן למנהל המכון גם את מספר בקשות
     *  ההרשמה הממתינות — **רחב מהשרת**, שבו `handleHomeExtras_`
     *  בודק כל מקטע מול ההרשאה שלו בנפרד.
     *
     *  ⚠️ מזהה המסמך הוא ASCII במכוון (`residents` ולא `תושבים`) —
     *     השוואה למחרוזת עברית בשפת הכללים עובדת, אבל
     *     שם אוסף/מסמך עברי הוא נתיב שצריך קידוד, ו-`fsUrl_`
     *     מרכיב נתיבים בשרשור פשוט. **ההרשאות עצמן** נשארות
     *     עברית, כי אלה הערכים שיושבים ב-`members/{uid}.perms`.
     *  ⚠️ הדפדפן לעולם אינו כותב: המסמכים נגזרים מהגיליון
     *     בלבד, ושני מקורות כתיבה הם שני מספרים שיסתרו זה את זה.
     * ==================================================================== */
    function canSeeHomeCount(id) {
      return isMember() && m().isExternal == false &&
             ((id == 'residents' && hasPerm('תושבים')) ||
              (id == 'gym'       && hasPerm('מכון')) ||
              (id == 'club'      && hasPerm('מועדון')) ||
              (id == 'garden'    && hasPerm('גינון')));
    }

    /* 🔴 שלב 2 (3.10.26 ערב) — ההגדרות שתושב צריך (סיסמת רשת המועדון) בלי
       המטען הראשי. **לא ב-appConfig**: אותו קורא גם הקבלן החיצוני, והמטען
       הקפיד שלא לתת לו את הסיסמה (RESIDENT_SETTINGS_ALLOW ריק למשתמש חיצוני).
       ר' residentConfigDoc_ ב-Code.gs. */
    match /residentConfig/{doc} {
      allow read: if isMember() && !isExternalUser();
      allow write: if false;
    }

    match /homeCounts/{id} {
      allow read: if canSeeHomeCount(id);
      allow write: if false;
    }

    /* ======================================================================
     *  שריוני המועדון — מסמך למשפחה   (צעד 12א, 2026-09-16)
     * ----------------------------------------------------------------------
     *  🔑 **הכלל מעתיק בדיוק את `handleMyClubReservations_`**, שמסנן
     *  לפי הזהות שבמושב החתום ומחזיר לתושב **רק את השריונים שלו**.
     *  החלטת יועד (16.9): תושב רואה את שלו בלבד — לא את לוח התפוסה.
     *
     *  🔴🔴 **`fid != ''` אינו קישוט.** תושב שאין לו מזהה משפחה
     *  יקבל `myFamilyId()` ריק, ומסמך שנכתב בטעות תחת מזהה ריק
     *  היה נפתח לכל מי שאין לו מזהה. אותה נעילה בדיוק כמו
     *  ב-`canSeeFamilyTx`, ומאותה סיבה.
     *
     *  ⚠️ **מזהה משפחה הוא משק בית, לא אדם** — שני בני זוג חולקים
     *     שורה ומזהה, ולכן רואים את אותם שריונים. זו ההתנהגות של
     *     השרת היום (`clubIdentity_` מתאים לפי שם משפחה/מזהה), לא
     *     שינוי.
     *  ⚠️ **במסמך אין אימייל ואין הערה** — ר' `clubResvSyncAll_`.
     * ==================================================================== */
    function canSeeClubResv(fid) {
      return isMember() && m().isExternal == false &&
             fid is string && fid != '' && fid == myFamilyId();
    }

    match /clubReservations/{fid} {
      allow read: if canSeeClubResv(fid);
      allow write: if false;
    }

    /* ======================================================================
     *  צעדי הסיור — מסמך לכל קהל   (צעד 12ב, 2026-09-16)
     * ----------------------------------------------------------------------
     *  🔑 **הכלל מעתיק את הפילטר של `handleTour_`**: צעד שמיועד
     *  למנהלים לא יוצא למי שאינו מנהל, וצעד שקהלו הוא **שם הרשאה**
     *  יוצא רק לבעלי אותה הרשאה (ומנהל-על רואה הכול, דרך `hasPerm`).
     *
     *  🔴 **הפיצול למסמך לכל קהל הוא מה שמאפשר את זה בכלל.** קריאת
     *  אוסף שלם נדחית אם מסמך אחד בו אסור לקורא — Firestore אינו
     *  מסנן. מסמך לכל צעד עם שדה "קהל" היה אומר שתושב רגיל לא יכול
     *  לקרוא את האוסף כלל.
     *
     *  ⚠️ **אין `perm-residents`, ויש `residents`.** "תושבים" בעמודת
     *     הקהל פירושו **תושב שאינו מנהל** (תוקן 16.9), ולא בעל הרשאת
     *     "תושבים". אי-אפשר לכוון צעד לבעלי ההרשאה הזאת — וזו
     *     ההתנהגות שהמודול תיאר מלכתחילה.
     *  ⚠️ המסמכים האלה אינם נתונים של אדם — הם תוכן שיווקי של
     *     האפליקציה. מה שאישי הוא רק "מה כבר ראיתי", והוא באוסף נפרד.
     * ==================================================================== */
    /* 4.10.26 — `isSuper()` הוסר מכאן: מי שיש לו 'על' כבר עונה ל-size() > 0, ולכן
       התוצאה זהה — רק בלי isMember שנייה (תקרת הביטויים, ר' hasPerm). */
    function isAdminUser() {
      return isMember() && m().perms.size() > 0;
    }

    function canSeeTourDoc(id) {
      return isMember() && m().isExternal == false && (
        id == 'all' ||
        (id == 'admins'      && isAdminUser()) ||
        /* 🔴 נוסף 16.9 עם תיקון הקהל "תושבים" בשרת: עד אז הוא נפל
           פעמיים ב-`handleTour_` ואיש לא ראה צעד כזה. מעכשיו הוא
           מציין **תושב שאינו מנהל**, והכלל מעתיק בדיוק את התנאי
           `return !isAdmin` שם. ⚠️ ולכן הוא **שולל** הרשאה במקום
           לדרוש אותה — היחיד כזה בקובץ, ובכוונה. */
        (id == 'residents'   && !isAdminUser()) ||
        (id == 'perm-super'  && hasPerm('על')) ||
        (id == 'perm-budget' && hasPerm('תקציב')) ||
        (id == 'perm-club'   && hasPerm('מועדון')) ||
        (id == 'perm-gym'    && hasPerm('מכון')) ||
        (id == 'perm-garden' && hasPerm('גינון'))
      );
    }

    match /tourSteps/{id} {
      allow read: if canSeeTourDoc(id);
      allow write: if false;
    }

    /* "מה כבר ראיתי" — מספר אחד, וכל אחד את שלו בלבד.
       🔴 `isMember()` ולא `signedIn()`: אותו מתג כיבוי כמו בכל השאר.
       🔴 והדפדפן אינו כותב גם כאן — `markTourSeen` עובר דרך Apps
          Script, שכותב גם לגיליון וגם לכאן. שני מקורות כתיבה היו
          מאפשרים למשתמש לקבוע לעצמו "ראיתי" בלי שהגיליון יידע. */
    function canSeeTourSeen(uid) {
      return isMember() && request.auth.uid == uid;
    }

    match /tourSeen/{uid} {
      allow read: if canSeeTourSeen(uid);
      allow write: if false;
    }

    /* 🔴 **`active` הוא מתג הכיבוי.** תושב שסומן "עזב" בגיליון חייב לאבד
       גישה — ו-`authorize_` בצד Apps Script אוכף את זה, אבל כללי האבטחה
       רואים רק את המסמך הזה. לכן `isMember()` דורש `active == true`.
       ✅ `fbSyncRow_` כותב `active: false` ברגע שהתושב מסומן "עזב" או
          שהוסרו הרשאותיו — בכל ארבעת מסלולי הכתיבה. המתג עובד.

       ---------- רשומת החבר עצמה ---------- */

    match /members/{uid} {
      /* קריאה: כל אחד את שלו בלבד. שימושי לאבחון ("מה המערכת חושבת שאני?")
         ואינו חושף כלום — המשתמש כבר יודע מה ההרשאות שלו. */
      allow read: if signedIn() && request.auth.uid == uid;
      /* 🔴 **כתיבה אסורה לחלוטין, לכל אחד.** המסמך הזה הוא מקור ההרשאות;
         משתמש שיכול לערוך אותו יכול להעניק לעצמו כל הרשאה שירצה. Apps Script
         כותב דרך חשבון שירות, שעוקף את הכללים האלה ואינו זקוק להיתר כאן. */
      allow write: if false;
    }


    /* ========================================================================
     *  המלצות תושבים על שירותים + לייק/דיסלייק/תגובות   (אפיון 22.9.26,
     *  [[cba-service-reactions-recommendations-spec-2026-09-22]] — WAVE 1,
     *  טרם קומיט/Publish)
     * ------------------------------------------------------------------------
     *  🔴 שלושה אוספים חדשים, כל אחד עומד בפני עצמו — מודל ב' (Firestore
     *  הוא המסד החי, הדפדפן כותב ישירות), לא עותק-קריאה מהגיליון:
     *  - residentServiceCards — כרטיס שנוצר ע"י תושב (מקביל לכרטיס שירות
     *    רשמי, אבל נכתב ישירות מהדפדפן — לא דרך saveServices_/הגיליון).
     *  - serviceReactions — לייק/דיסלייק, מסמך אחד למשפחה לכל כרטיס
     *    (מזהה המסמך = "<cardId>_<familyId>", כתיבה שנייה דורסת ולא
     *    משכפלת קול — ואי אפשר "לגנוב" קול תחת מזהה חדש).
     *  - serviceComments — תגובת טקסט חופשי, מסמך לכל תגובה.
     *  שני האחרונים חלים גם על כרטיסי שירות **רשמיים**
     *  (cardType:"official", cardId = "מזהה שירות" מהגיליון) וגם על
     *  כרטיסי תושבים (cardType:"resident") — אותו אוסף, אין צורך
     *  להכיר את סוג הכרטיס כדי לאכוף הרשאה, רק את זהות הכותב.
     *  🔒 אין שם/טלפון/אימייל באף מסמך כאן — רק familyId. שם המשפחה
     *  המוצג נגזר בלקוח מ-`familyDisplayName()` הקיים (dataService.js).
     * ====================================================================== */

    /* ---------- כרטיסי המלצה של תושבים ---------- */

    function rsvcCreateFields() {
      return ['id', 'familyId', 'title', 'body', 'mapsUrl',
              'createdAt', 'updatedAt', 'active', 'schema',
              /* 27.9.26 — סכימת "המלצות השיכון" (resRecommendations): שדות
                 אופציונליים בלבד, על גבי מה שהיה קיים — לא מחליפים כלום.
                 group/labels/kosher משמשים גם המלצות שתושב מוסיף עכשיו דרך
                 הטופס המורחב; phone/city/kupah/note/source/originalText
                 שייכים בעיקר לשורות מיובאות (ר' rsvcAdminEditOk למטה). */
              'group', 'phone', 'city', 'kupah', 'labels', 'note',
              'source', 'originalText', 'kosher',
              /* 27.9.26 — "אחראי מטעם הוועד" (תצוגה בלבד) + שלושת סמלילי
                 יצירת הקשר (מוקד טלפוני / מוקד וואטסאפ / קבוצת וואטסאפ
                 שיכון). כולם אופציונליים, אותו דפוס כמו phone/city/kupah
                 למעלה. */
              'committeeItemId', 'hotlinePhone', 'whatsappHotline',
              'whatsappGroupLink',
              /* 28.9.26 — כתובת ואתר העסק (השלמת פרטים אחרי הצוות האדום על
                 המדריך). אופציונליים, מחרוזות עם תקרת אורך — ר' rrOptFieldsOk. */
              'address', 'website'];
    }

    /* שדות "המלצות השיכון" — כולם אופציונליים, ולכן נבדקים רק כשקיימים. */
    function rrOptFieldsOk() {
      return (!request.resource.data.keys().hasAny(['group']) ||
              (request.resource.data.group is string && request.resource.data.group.size() <= 60)) &&
             (!request.resource.data.keys().hasAny(['phone']) ||
              (request.resource.data.phone is string && request.resource.data.phone.size() <= 30)) &&
             (!request.resource.data.keys().hasAny(['city']) ||
              (request.resource.data.city is string && request.resource.data.city.size() <= 60)) &&
             (!request.resource.data.keys().hasAny(['kupah']) ||
              (request.resource.data.kupah is string && request.resource.data.kupah.size() <= 30)) &&
             (!request.resource.data.keys().hasAny(['labels']) ||
              (request.resource.data.labels is list && request.resource.data.labels.size() <= 10)) &&
             (!request.resource.data.keys().hasAny(['note']) ||
              (request.resource.data.note is string && request.resource.data.note.size() <= 300)) &&
             (!request.resource.data.keys().hasAny(['source']) ||
              (request.resource.data.source is string && request.resource.data.source.size() <= 30)) &&
             (!request.resource.data.keys().hasAny(['originalText']) ||
              (request.resource.data.originalText is string && request.resource.data.originalText.size() <= 3000)) &&
             (!request.resource.data.keys().hasAny(['kosher']) ||
              request.resource.data.kosher is bool) &&
             (!request.resource.data.keys().hasAny(['committeeItemId']) ||
              (request.resource.data.committeeItemId is string && request.resource.data.committeeItemId.size() <= 40)) &&
             (!request.resource.data.keys().hasAny(['hotlinePhone']) ||
              (request.resource.data.hotlinePhone is string && request.resource.data.hotlinePhone.size() <= 30)) &&
             (!request.resource.data.keys().hasAny(['whatsappHotline']) ||
              (request.resource.data.whatsappHotline is string && request.resource.data.whatsappHotline.size() <= 30)) &&
             (!request.resource.data.keys().hasAny(['whatsappGroupLink']) ||
              (request.resource.data.whatsappGroupLink is string && request.resource.data.whatsappGroupLink.size() <= 300)) &&
             (!request.resource.data.keys().hasAny(['address']) ||
              (request.resource.data.address is string && request.resource.data.address.size() <= 150)) &&
             (!request.resource.data.keys().hasAny(['website']) ||
              (request.resource.data.website is string && request.resource.data.website.size() <= 300));
    }

    function rsvcShapeOk() {
      return request.resource.data.keys().hasOnly(rsvcCreateFields()) &&
             request.resource.data.keys().hasAll(
               ['id', 'familyId', 'title', 'body', 'active', 'schema']) &&
             request.resource.data.familyId is string &&
             request.resource.data.familyId != '' &&
             request.resource.data.title is string &&
             request.resource.data.title.size() > 0 &&
             request.resource.data.title.size() <= 80 &&
             request.resource.data.body is string &&
             request.resource.data.body.size() <= 1500 &&
             (!request.resource.data.keys().hasAny(['mapsUrl']) ||
              (request.resource.data.mapsUrl is string &&
               request.resource.data.mapsUrl.size() <= 300)) &&
             request.resource.data.active is bool &&
             request.resource.data.schema is int &&
             rrOptFieldsOk();
    }

    /* יצירה: רק בשם המשפחה שלו, ותמיד פעיל — מתפרסם מיד, אין אישור מנהל
       מראש (הוחלט 22.9.26). 27.9.26 — resRecommendations מוסיף כאן שדות
       אופציונליים (group ועוד, למשל כשתושב בוחר קבוצה בטופס), אבל התנאי
       על הבעלות/הפעילות לא השתנה. */
    function rsvcCreateOk() {
      return isMember() && m().isExternal == false &&
             request.resource.data.familyId == myFamilyId() &&
             request.resource.data.active == true &&
             rsvcShapeOk();
    }

    /* עריכה עצמית: היוצר יכול לגעת רק בתוכן — עכשיו כולל את שדות
       resRecommendations — לעולם לא בבעלות. */
    function rsvcOwnerUpdateOk() {
      return isMember() && m().isExternal == false &&
             resource.data.familyId == myFamilyId() &&
             request.resource.data.familyId == resource.data.familyId &&
             request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['title', 'body', 'mapsUrl', 'updatedAt',
                         'group', 'phone', 'city', 'kupah', 'labels', 'note', 'kosher',
                         'committeeItemId', 'hotlinePhone', 'whatsappHotline', 'whatsappGroupLink',
                         'address', 'website']) &&
             rsvcShapeOk();
    }

    /* מנהל-על נוגע רק ב-active — זה כפתור "הסתרה", לא עריכת תוכן תושב. */
    function rsvcAdminHideOk() {
      return isSuper() &&
             request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['active', 'updatedAt']) &&
             request.resource.data.familyId == resource.data.familyId;
    }

    /* 27.9.26 — עריכה מלאה, כולל כרטיסים מיובאים (אפיון resRecommendations
       סעיף 3): מנהל-על או בעל הרשאת "שירותים" — hasPerm('שירותים') כבר
       מחזיר אמת לשניהם (ר' ההערה ליד hasPerm למעלה בקובץ). נוגעים בתוכן,
       לא בבעלות — id/familyId קבועים, זו "עריכה" ולא "החרמה". */
    function rsvcAdminEditOk() {
      return hasPerm('שירותים') &&
             request.resource.data.familyId == resource.data.familyId &&
             request.resource.data.id == resource.data.id &&
             rsvcShapeOk();
    }

    match /residentServiceCards/{id} {
      allow read: if canSeeServices();
      allow create: if rsvcCreateOk();
      allow update: if rsvcOwnerUpdateOk() || rsvcAdminHideOk() || rsvcAdminEditOk();
      /* מחיקה: היוצר מוחק את שלו כרגיל, ומעכשיו גם מנהל-על/"שירותים" —
         אפיון resRecommendations סעיף 3 ("עריכה/מחיקה של כל כרטיס, כולל
         מיובאים"). מנהל יכול להעדיף הסתרה (rsvcAdminHideOk) על כרטיס תושב
         עצמו; מחיקה אמיתית שמורה בעיקר לכרטיסים מיובאים/פגומים. ⚠️ פתוח:
         מחיקה משאירה יתומות את התגובות/הלייקים על הכרטיס — ר' הערת "פתוח"
         בסוף הבלוק. */
      allow delete: if (isMember() && m().isExternal == false &&
                       resource.data.familyId == myFamilyId()) ||
                       hasPerm('שירותים');
    }

    /* ---------- לייק/דיסלייק ---------- */

    function ssrShapeOk(docId) {
      return request.resource.data.keys().hasOnly(
               ['cardId', 'cardType', 'familyId', 'value', 'updatedAt']) &&
             request.resource.data.keys().hasAll(
               ['cardId', 'cardType', 'familyId', 'value']) &&
             request.resource.data.cardId is string &&
             request.resource.data.cardId != '' &&
             request.resource.data.cardType in ['official', 'resident'] &&
             request.resource.data.familyId == myFamilyId() &&
             request.resource.data.value in ['like', 'dislike'] &&
             docId == (request.resource.data.cardId + '_' + request.resource.data.familyId);
    }

    match /serviceReactions/{id} {
      allow read: if canSeeServices();
      /* create ו-update יחד: תושב שמשנה לייק↔דיסלייק כותב לאותו מזהה
         מסמך (upsert), לא יוצר שני. */
      allow create, update: if isMember() && m().isExternal == false && ssrShapeOk(id);
      /* ביטול הצבעה לגמרי — הוחלט שניתן לשנות/לבטל בכל עת. */
      allow delete: if isMember() && m().isExternal == false &&
                       resource.data.familyId == myFamilyId();
    }

    /* ---------- תגובות ---------- */

    function sscCreateFields() {
      return ['id', 'cardId', 'cardType', 'familyId', 'text', 'createdAt', 'updatedAt'];
    }

    function sscShapeOk() {
      return request.resource.data.keys().hasOnly(sscCreateFields()) &&
             request.resource.data.keys().hasAll(
               ['id', 'cardId', 'cardType', 'familyId', 'text', 'createdAt']) &&
             request.resource.data.cardId is string &&
             request.resource.data.cardId != '' &&
             request.resource.data.cardType in ['official', 'resident'] &&
             request.resource.data.familyId == myFamilyId() &&
             request.resource.data.text is string &&
             request.resource.data.text.size() > 0 &&
             request.resource.data.text.size() <= 500;
    }

    function sscCreateOk() {
      return isMember() && m().isExternal == false && sscShapeOk();
    }

    match /serviceComments/{id} {
      allow read: if canSeeServices();
      allow create: if sscCreateOk();
      /* אין עריכה — מוחקים ומקלידים מחדש (עדיף על אפשרות ל"שיפוץ בדיעבד"
         של מה שנאמר). תושב מוחק את שלו, מנהל-על יכול למחוק כל תגובה
         (הוחלט 22.9.26 — "אין מדיניות תוכן", כלומר בלי כלי אכיפה
         ייעודיים, אבל מנהל עדיין יכול לפעול ביוזמתו). */
      allow update: if false;
      allow delete: if isMember() && m().isExternal == false &&
                       (resource.data.familyId == myFamilyId() || isSuper());
    }

    /* ⏭ פתוח (לא חוסם WAVE 1, לטפל ב-WAVE הבא):
       1. מחיקת כרטיס המלצה משאירה יתומות את תגובותיו ולייקיו — אין
          מחיקת-מפל בכללי Firestore. תיקון סביר: הלקוח מוחק אותן
          בבאטש לפני מחיקת הכרטיס (best-effort, לא קריטי — הן ממילא
          לא מוצגות בלי הכרטיס). לא לבנות Cloud Function בשביל זה.
       2. אין עדיין בדיקה בקוד היכן `familyDisplayName()` כבר קיים
          בלקוח לפני השימוש בו במסכים החדשים (dataService.js:~2851).
    */

    /* ========================================================================
     *  דיווחי "לא מעודכן" על המלצת שירות — staleReports   (27.9.26,
     *  אפיון resRecommendations סעיף 5)
     * ------------------------------------------------------------------------
     *  כל תושב יכול לדגול המלצה כ"לא מעודכן" (טופס קצר: למה + הערה
     *  אופציונלית). הסטטוס תמיד גלוי באפליקציה לכולם — לא רק במייל (כלל
     *  קשיח בפרויקט) — ומייל למנהלים יוצא דרך המערכת הקיימת (notifyAdmins_,
     *  ר' Code.gs/Notify.gs), לא מנגנון נפרד.
     *  🔒 reporterFamilyId ולא uid/שם/מייל — אותו דפוס פרטיות בדיוק כמו
     *  residentServiceCards/serviceReactions/serviceComments למעלה.
     * ====================================================================== */
    function srShapeOk() {
      return request.resource.data.keys().hasOnly(
               ['id', 'cardId', 'cardName', 'group', 'why', 'note',
                'reporterFamilyId', 'status', 'createdAt', 'updatedAt']) &&
             request.resource.data.keys().hasAll(
               ['id', 'cardId', 'cardName', 'why', 'reporterFamilyId', 'status', 'createdAt']) &&
             request.resource.data.cardId is string && request.resource.data.cardId != '' &&
             request.resource.data.cardName is string && request.resource.data.cardName.size() <= 80 &&
             (!request.resource.data.keys().hasAny(['group']) ||
              (request.resource.data.group is string && request.resource.data.group.size() <= 60)) &&
             request.resource.data.why is string &&
             request.resource.data.why.size() > 0 && request.resource.data.why.size() <= 200 &&
             (!request.resource.data.keys().hasAny(['note']) ||
              (request.resource.data.note is string && request.resource.data.note.size() <= 1000)) &&
             request.resource.data.reporterFamilyId == myFamilyId() &&
             request.resource.data.status == 'open';
    }

    /* טיפול ע"י מנהל-על/"שירותים" — נוגעים רק בסטטוס, אף פעם לא בתוכן
       הדיווח או בזהות המדווח/הכרטיס. */
    function srAdminUpdateOk() {
      return hasPerm('שירותים') &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']) &&
             request.resource.data.status in ['open', 'done'] &&
             request.resource.data.cardId == resource.data.cardId &&
             request.resource.data.reporterFamilyId == resource.data.reporterFamilyId;
    }

    match /staleReports/{id} {
      /* קריאה פתוחה לכל חבר (לא רק מנהל) — הסטטוס חייב להיות גלוי
         באפליקציה לכולם, לא רק דרך המייל למנהל (כלל קשיח, ר' האפיון). */
      allow read: if canSeeServices();
      allow create: if isMember() && m().isExternal == false && srShapeOk();
      allow update: if srAdminUpdateOk();
      allow delete: if false;
    }

        /* ========================================================================
     *  RSVP לאירועי לוח הקהילתי   (2026-09-23, אפיון events-rsvp-spec)
     * ------------------------------------------------------------------------
     *  שני אוספים: eventRSVP/{eventId} — מסמך הגדרה, נכתב רק ע"י מנהל;
     *  eventRSVPResponses/{eventId_familyId} — מסמך תגובה לכל משפחה,
     *  נכתב ע"י המשפחה עצמה בלבד. שם משפחה/אימייל אינם נשמרים כאן.
     * ==================================================================== */
    function rsvpConfigShapeOk() {
      return request.resource.data.keys().hasOnly(['enabled', 'openedByUid', 'openedAt', 'category']) &&
             request.resource.data.enabled is bool &&
             request.resource.data.openedByUid is string &&
             request.resource.data.category is string;
    }

    match /eventRSVP/{eventId} {
      allow read: if isMember() && m().isExternal == false;
      /* 23.9 — הרשאת "תרבות" (או מנהל-על, דרך hasPerm) במקום "כל מנהל". */
      allow create, update: if hasPerm('תרבות') && rsvpConfigShapeOk();
      allow delete: if false;
    }

    function rsvpEventOpen(eventId) {
      return exists(/databases/$(database)/documents/eventRSVP/$(eventId)) &&
             get(/databases/$(database)/documents/eventRSVP/$(eventId)).data.enabled == true;
    }

    function rsvpResponseFields() {
      return ['eventId', 'familyId', 'status', 'adults', 'children', 'updatedAt'];
    }

    function rsvpResponseShapeOk() {
      return request.resource.data.keys().hasOnly(rsvpResponseFields()) &&
             request.resource.data.keys().hasAll(['eventId', 'familyId', 'status', 'adults', 'children']) &&
             request.resource.data.status in ['attending', 'not_attending'] &&
             request.resource.data.adults is int && request.resource.data.adults >= 0 &&
             request.resource.data.children is int && request.resource.data.children >= 0 &&
             docId == request.resource.data.eventId + '_' + request.resource.data.familyId;
    }

    match /eventRSVPResponses/{docId} {
      /* 23.9 (הכרעת יועד) — הספירה החיה על האירוע גלויה לכל תושב, ולכן
         כל חבר פעיל שאינו חיצוני קורא את התגובות. אין כאן שם או אימייל —
         רק מזהה משפחה ומספר נפשות. השמות עוברים רק דרך rsvpFamilyNames בשרת. */
      allow read: if isMember() && m().isExternal == false;
      allow create: if isMember() && m().isExternal == false &&
                       request.resource.data.familyId == myFamilyId() &&
                       rsvpEventOpen(request.resource.data.eventId) &&
                       rsvpResponseShapeOk();
      allow update: if isMember() && m().isExternal == false &&
                       resource.data.familyId == myFamilyId() &&
                       request.resource.data.eventId == resource.data.eventId &&
                       request.resource.data.familyId == resource.data.familyId &&
                       rsvpEventOpen(resource.data.eventId) &&
                       rsvpResponseShapeOk();
      allow delete: if false;
    }

    /* ========================================================================
     *  פרטי אירוע: הזמנה (תמונה) + לו"ז פנימי   (28.9.2026)
     * ------------------------------------------------------------------------
     *  eventInfo/{eventId}   — לו"ז, hasImage, שנה. קטן, נקרא לכל הלוח.
     *  eventImages/{eventId} — התמונה עצמה (data URL של JPEG), נקראת לפי דרישה.
     *  🔑 מפתח = מזהה האירוע ביומן גוגל ⇒ הנתונים זזים עם האירוע.
     *  קריאה: כל חבר פעיל שאינו חיצוני — בדיוק כמו eventRSVP (אותו קהל רואה
     *  את הלוח). כתיבה: "תרבות" או מנהל-על (hasPerm), כמו פתיחת אישור הגעה.
     *  אין כאן שם/אימייל/טלפון — רק uid של מי שעדכן.
     * ==================================================================== */
    function eventInfoShapeOk() {
      return request.resource.data.keys().hasOnly(['year', 'category', 'schedule', 'hasImage', 'updatedByUid', 'updatedAt']) &&
             request.resource.data.keys().hasAll(['year', 'schedule', 'hasImage', 'updatedByUid']) &&
             request.resource.data.year is int &&
             request.resource.data.schedule is string &&
             request.resource.data.schedule.size() <= 2000 &&
             request.resource.data.hasImage is bool &&
             request.resource.data.updatedByUid == request.auth.uid;
    }

    function eventImageShapeOk() {
      return request.resource.data.keys().hasOnly(['image', 'updatedByUid', 'updatedAt']) &&
             request.resource.data.image is string &&
             request.resource.data.image.size() <= 950000 &&
             request.resource.data.image.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$') &&
             request.resource.data.updatedByUid == request.auth.uid;
    }

    function canReadEventExtras() {
      return isMember() && m().isExternal == false;
    }

    match /eventInfo/{eventId} {
      allow read: if canReadEventExtras();
      allow create, update: if hasPerm('תרבות') && eventInfoShapeOk();
      allow delete: if false;
    }

    match /eventImages/{eventId} {
      allow read: if canReadEventExtras();
      allow create, update: if hasPerm('תרבות') && eventImageShapeOk();
      allow delete: if hasPerm('תרבות');
    }

    /* ========================================================================
     *  הודעות ותזכורות למנהלי אירועים   (28.9.2026)
     * ------------------------------------------------------------------------
     *  eventMessages/{id} — הודעה לתושבים על אירוע: עכשיו או בזמן שנקבע.
     *  הדפדפן רק **יוצר** (status='pending') ו**מבטל** (pending → canceled).
     *  השליחה והסימון (sending/sent/expired) — רק מהשרת (חשבון שירות).
     *  קריאה: רק מנהלי אירועים — תושב לא צריך לראות את התור.
     * ==================================================================== */
    function eventMessageShapeOk() {
      return request.resource.data.keys().hasOnly(['eventId', 'text', 'audience', 'sendAtMs', 'status', 'createdByUid', 'createdAt']) &&
             request.resource.data.keys().hasAll(['eventId', 'text', 'audience', 'sendAtMs', 'status', 'createdByUid']) &&
             request.resource.data.eventId is string && request.resource.data.eventId.size() <= 300 &&
             request.resource.data.text is string &&
             request.resource.data.text.size() >= 2 && request.resource.data.text.size() <= 240 &&
             request.resource.data.audience in ['all', 'attending', 'pending'] &&
             request.resource.data.sendAtMs is int &&
             request.resource.data.status == 'pending' &&
             request.resource.data.createdByUid == request.auth.uid;
    }

    match /eventMessages/{msgId} {
      allow read: if hasPerm('תרבות');
      allow create: if hasPerm('תרבות') && eventMessageShapeOk();
      allow update: if hasPerm('תרבות') &&
                       resource.data.status == 'pending' &&
                       request.resource.data.status == 'canceled' &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if false;
    }

    /* ========================================================================
     *  "הזכירו לי" — תזכורת אישית לאירוע   (29.9.2026)
     * ------------------------------------------------------------------------
     *  eventReminders/{eventId}_{familyId} — מסמך אחד למשפחה לאירוע.
     *  התושב יוצר / משנה (ערב לפני ↔ שעתיים לפני) / מבטל רק את של המשפחה
     *  שלו; המזהה חייב להיות eventId_familyId שלו. השליחה והסימון
     *  (sending/sent/expired) — רק מהשרת. אין כאן שם/מייל — רק מזהים.
     * ==================================================================== */
    function remShapeOk(docId) {
      return request.resource.data.keys().hasOnly(['eventId', 'familyId', 'offset', 'remindAtMs', 'status', 'createdByUid', 'createdAt']) &&
             request.resource.data.keys().hasAll(['eventId', 'familyId', 'offset', 'remindAtMs', 'status', 'createdByUid']) &&
             request.resource.data.eventId is string && request.resource.data.eventId.size() <= 300 &&
             myFamilyId() is string && myFamilyId().size() > 0 &&
             request.resource.data.familyId == myFamilyId() &&
             docId == request.resource.data.eventId + '_' + myFamilyId() &&
             request.resource.data.offset in ['day', '2h'] &&
             request.resource.data.remindAtMs is int &&
             request.resource.data.status == 'pending' &&
             request.resource.data.createdByUid == request.auth.uid;
    }

    function remMine() {
      return isMember() && m().isExternal == false && resource.data.familyId == myFamilyId();
    }

    match /eventReminders/{docId} {
      allow read: if remMine();
      allow create: if isMember() && m().isExternal == false && remShapeOk(docId);
      allow update: if remMine() && remShapeOk(docId);
      allow delete: if remMine();
    }

    /* ========================================================================
     *  "עדכון חדש" — מרכז ההתראות   (23.9.2026)
     * ------------------------------------------------------------------------
     *  מסמך אחד לכל משפחה, notifyInbox/{familyId}: לכל תחום השורה האחרונה
     *  שהופיעה לה באפליקציה ("שובץ לשבוע 27.9") והאם להציג נקודה. נכתב
     *  **רק מהשרת** (חשבון שירות). אין בו שם, מייל או טלפון — רק הטקסט
     *  שבטבלת ההתראות. כל משפחה קוראת את שלה בלבד.
     *  ⚠️ `myFamilyId() != ''` — אחרת '' == '' פותח מסמך בלי מזהה.
     *  ⚠️ הגנן החיצוני אינו מקבל שורות כאלה (הן לתושב על הבקשה שלו).
     *  התור של השרת (פוש בשעות שקט, שורות סיכום) יושב בגיליון ולא כאן —
     *  הטקסטים למנהלים נושאים שמות.
     * ==================================================================== */
    function canSeeInbox(fid) {
      return isMember() && myFamilyId() != '' && fid == myFamilyId();
    }

    match /notifyInbox/{fid} {
      allow read: if canSeeInbox(fid);
      allow write: if false;
    }

    /* ======================================================================
     *  דיווחים על האפליקציה — appReports/{id}   (גל 4, 24.9.2026)
     * ----------------------------------------------------------------------
     *  מודל ב': Firestore הוא המסד החי. הדפדפן כותב את הדיווח ישירות,
     *  וטאב "דיווחי אפליקציה" בגיליון הוא מראה בלבד (Apps Script כותב אותו).
     *  🔒 אין שם, מייל או טלפון במסמך — רק uid ו-familyId. השם והמייל
     *     נשלפים בשרת מהגיליון כשצריך לשלוח מייל.
     *  🔴 שלושה כותבים, שלוש רשימות שדות סגורות:
     *     · המדווח — יוצר פעם אחת, ומשלים תמונות על המסמך שלו בלבד.
     *     · מנהל-על — "טופל" ותשובה. לעולם לא נוגע במה שהמדווח כתב.
     *     · השרת — mailPending/pulse וכו' (חשבון שירות, עוקף כללים).
     *  ⚠️ הגנן החיצוני אינו מדווח כאן — בדיוק כמו submitAppReport_ בשרת,
     *     שהשער הכללי שלו חוסם חיצוני.
     * ==================================================================== */
    function arCreateFields() {
      return ['id', 'uid', 'familyId', 'kind', 'items', 'screen', 'ver', 'srvVer',
              'ua', 'perms', 'year', 'net', 'dialog', 'errors', 'trail', 'extra',
              'photos', 'photosExpected', 'photosIncomplete',
              'mailPending', 'mirrorPending', 'createdAt', 'schema'];
    }

    function arStrOk(f, max) {
      return !request.resource.data.keys().hasAny([f]) ||
             (request.resource.data[f] is string && request.resource.data[f].size() <= max);
    }

    function arTextOk() {
      return arStrOk('screen', 200) && arStrOk('ver', 60) && arStrOk('srvVer', 60) &&
             arStrOk('ua', 300) && arStrOk('perms', 200) && arStrOk('year', 40) &&
             arStrOk('net', 80) && arStrOk('dialog', 200) && arStrOk('errors', 2500) &&
             arStrOk('trail', 2500) && arStrOk('extra', 500);
    }

    function arShapeOk(docId) {
      return request.resource.data.keys().hasOnly(arCreateFields()) &&
             request.resource.data.keys().hasAll(
               ['id', 'uid', 'familyId', 'kind', 'items', 'photos',
                'mailPending', 'mirrorPending', 'createdAt', 'schema']) &&
             request.resource.data.id == docId &&
             request.resource.data.kind in ['תקלה', 'ייעול'] &&
             request.resource.data.items is list &&
             request.resource.data.items.size() >= 1 &&
             request.resource.data.items.size() <= 5 &&
             request.resource.data.items[0] is string &&
             request.resource.data.items[0].size() <= 300 &&
             request.resource.data.photos is list &&
             request.resource.data.photos.size() == 0 &&
             (!request.resource.data.keys().hasAny(['photosExpected']) ||
              (request.resource.data.photosExpected is int &&
               request.resource.data.photosExpected >= 0 &&
               request.resource.data.photosExpected <= 3)) &&
             (!request.resource.data.keys().hasAny(['photosIncomplete']) ||
              request.resource.data.photosIncomplete is bool) &&
             request.resource.data.mailPending == true &&
             request.resource.data.mirrorPending == true &&
             request.resource.data.createdAt == request.time &&
             request.resource.data.schema is int &&
             arTextOk();
    }

    /* יצירה: חבר פעיל, לא חיצוני, בשמו ובשם המשפחה שלו בלבד. */
    function arCreateOk(docId) {
      return isMember() && m().isExternal == false &&
             request.resource.data.uid == request.auth.uid &&
             request.resource.data.familyId == myFamilyId() &&
             arShapeOk(docId);
    }

    /* המדווח משלים את התמונות שהעלה — ורק אותן. */
    function arPhotosOk() {
      return isMember() && resource.data.uid == request.auth.uid &&
             request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['photos', 'photosIncomplete']) &&
             request.resource.data.photos is list &&
             request.resource.data.photos.size() <= 3 &&
             request.resource.data.photosIncomplete is bool;
    }

    /* מנהל-על: טופל/תשובה בלבד. mirrorPending חייב לעלות — אחרת הגיליון
       לא יידע על השינוי. */
    function arAdminOk() {
      return isSuper() &&
             request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['done', 'doneAt', 'reply', 'replyLast', 'replyAt',
                         'replyPending', 'mirrorPending']) &&
             (!request.resource.data.keys().hasAny(['done']) || request.resource.data.done is bool) &&
             (!request.resource.data.keys().hasAny(['reply']) ||
              (request.resource.data.reply is string && request.resource.data.reply.size() <= 4000)) &&
             (!request.resource.data.keys().hasAny(['replyLast']) ||
              (request.resource.data.replyLast is string && request.resource.data.replyLast.size() <= 1000)) &&
             (!request.resource.data.keys().hasAny(['replyPending']) ||
              request.resource.data.replyPending is bool) &&
             request.resource.data.mirrorPending == true;
    }

    function arReadOk() {
      return isSuper();
    }

    match /appReports/{docId} {
      allow read: if arReadOk();
      allow create: if arCreateOk(docId);
      allow update: if arPhotosOk() || arAdminOk();
      allow delete: if false;
    }

    /* ======================================================================
     *  דלת Nuki + WeWork   (25.9.2026, Door.gs)
     * ----------------------------------------------------------------------
     *  🔴 **הדפדפן לא כותב לאף אחד מהאוספים האלה.** יצירת שריון דורשת
     *  בדיקת תפוסה תחת נעילה + אירוע ביומן גוגל, ופתיחת דלת דורשת טוקן
     *  סודי — שניהם בשרת. כל `allow write` כאן הוא `false`.
     *  🔑 אף מסמך לא נושא שם, מייל או טלפון — רק familyId / uid.
     *  ⚠️ `m().isExternal == false` בכל שער: `authorize_` חוסם משתמש
     *     חיצוני מכל פעולה שאינה גינון, והכלל לא רשאי להיות רחב ממנו.
     * ==================================================================== */
    function canSeeWework() {
      return isMember() && m().isExternal == false;
    }
    /* 4.10.26 — אותו תנאי כמו canSeeWework() && hasPerm(p), עם isMember אחת במקום
       שתיים (תקרת הביטויים, ר' hasPerm). */
    function isInternalAdmin(p) {
      return isMember() && m().isExternal == false && permHas(m().perms, p);
    }

    /* כללי השריון — כל חבר (המסך בונה מהם את לוח השעות). */
    match /weworkConfig/{docId} {
      allow read: if canSeeWework();
      allow write: if false;
    }

    /* תפוסה לפי שעה — ספירות בלבד, בלי מי. */
    match /weworkDays/{docId} {
      allow read: if canSeeWework();
      allow write: if false;
    }

    /* שריון — המשפחה עצמה, ומנהל WeWork. שאילתה של תושב חייבת לסנן
       `familyId == שלי`, אחרת היא נדחית לפני שנקרא מסמך אחד.
       ⚠️ `fid != ''` תמיד — myFamilyId() מחזירה '' לשאינו-חבר. */
    function canSeeWwBooking(fid) {
      return canSeeWework() &&
             (hasPerm('WeWork') || (fid is string && fid != '' && fid == myFamilyId()));
    }
    match /weworkBookings/{docId} {
      allow read: if canSeeWwBooking(resource.data.familyId);
      allow write: if false;
    }

    /* מצב הדלת לציבור: off/sim/live ו"המכון עבר לדלת". בלי סודות. */
    match /doorConfig/{docId} {
      allow read: if canSeeWework();
      allow write: if false;
    }

    /* סוללה/חיבור — מנהל המכון בלבד. */
    function canSeeDoorState() {
      return isInternalAdmin('מכון');
    }
    match /doorState/{docId} {
      allow read: if canSeeDoorState();
      allow write: if false;
    }

    /* יומן הפתיחות — מנהל המכון את הכול; מנהל WeWork רק את כניסות
       ה-WeWork (שאילתה שלו חייבת לסנן `kind == 'wework'`). */
    function canSeeDoorLog(kind) {
      return isInternalAdmin('מכון') || (isInternalAdmin('WeWork') && kind == 'wework');
    }
    match /doorLog/{docId} {
      allow read: if canSeeDoorLog(resource.data.kind);
      allow write: if false;
    }

    /* מצב הזמנת Nuki של מנוי — הוא עצמו, ומנהל המכון. */
    function canSeeGymNuki(uid) {
      return canSeeGymStatus(uid) || isInternalAdmin('מכון');
    }
    match /gymNuki/{uid} {
      allow read: if canSeeGymNuki(uid);
      allow write: if false;
    }

    /* ======================================================================
     *  מכון הכושר — מראה ב-Firestore   (25.9.2026, GymFirestore.gs)
     * ----------------------------------------------------------------------
     *  gymMembers: סטטוס/מסלול/תאריכים/תשלומים + familyId/uid, ומ-3.10.26 (schema 2)
     *  גם הצהרת בריאות, חתימה, הערות מנהל ויומן אירועים (החלטת יועד). **בלי** שם,
     *  מייל, טלפון, ת.ז., תאריך לידה — נתוני גיליון "תושבים". רשימת היתר.
     *  קריאה: מנהל מכון (לא חיצוני). כתיבה: שרת, ומ-3.10.26 גם מנהל מכון (עדכון הקרנה בלבד — ר' מטה).
     *  gymConfig/public: מסלולים, תקנון, נוסח השאלות, פייבוקס — כל חבר.
     *  gymConfig/admin: הגדרות המכון בלי קוד הכניסה — מנהל מכון.
     * ==================================================================== */
    /* ====================================================================
     *  מכון כושר — כתיבה מהדפדפן (שלבים 2-3, 3.10.26, בקשת יועד "שמירה מיידית")
     * --------------------------------------------------------------------
     *  🔴 **שני כללים, ושניהם למנהל מכון פנימי בלבד** (isInternalAdmin('מכון')):
     *   1. gymOps/{opId} — **הכוונה**. יצירה בלבד (בלי עדכון/מחיקה — השרת מוחק).
     *      · רשימת שדות סגורה, status חייב להיות 'pending', type מרשימה סגורה.
     *      · `by` חייב להיות המייל של המחובר — אי אפשר לרשום פעולה "בשם" מנהל אחר.
     *      · body.id חייב להיות memberId, והמנוי חייב להתקיים.
     *   2. gymMembers/{id} — **ההקרנה האופטימית**. עדכון בלבד (בלי יצירה/מחיקה),
     *      ורק רשימת שדות סגורה של סטטוס/תאריכים/סכומים/יומן. **לא** אפשר לגעת
     *      ב-familyId/uid/slot/הצהרה/חתימה/שאלון/schema.
     *  ⚠️ ההקרנה אינה האמת: השרת מחיל את ה-op על הגיליון ומשכתב את המסמך מהגיליון.
     *     לכן גם בהנחה גרועה (מנהל זדוני) הנזק מוגבל לתצוגה עד הסנכרון — ויומן
     *     הפעולות בגיליון הוא הרישום האמיתי.
     * ==================================================================== */
    function gymOpTypes() {
      return ['recordGymPayment', 'confirmGymPayment', 'updateGymPayment', 'voidGymPayment',
              'activateGymManual', 'extendGymMembership', 'updateGymMembership'];
    }
    function gymStatuses() {
      return ['ממתין להצהרה', 'ממתין לאישור רופא', 'ממתין לאישור', 'ממתין לתשלום', 'ממתין לאימות',
              'פעיל', 'פג תוקף', 'מוקפא', 'נדחה', 'בוטל'];
    }
    function gymMemberPatchKeys() {
      return ['סטטוס', 'סטטוס תשלום', 'בתוקף עד', 'תאריך התחלה', 'סה"כ שולם', 'תשלום אחרון',
              'חודשים ששולמו', 'מצב סנכרון', 'מחיר מוסכם', 'מסלול', 'אמצעי תשלום', 'אסמכתא',
              'אומת בתאריך', 'אומת ע"י', 'טופל בתאריך', 'טופל ע"י', 'הערות מנהל', 'log', 'updatedAt'];
    }
    function gymOpOk() {
      let d = request.resource.data;
      return d.keys().hasOnly(['memberId', 'type', 'body', 'by', 'createdAt', 'status', 'schema', 'eventId']) &&
             d.keys().hasAll(['memberId', 'type', 'body', 'by', 'createdAt', 'status', 'schema']) &&
             d.type in gymOpTypes() &&
             d.status == 'pending' &&
             d.schema == 1 &&
             d.memberId is string && d.memberId.size() > 0 && d.memberId.size() <= 20 &&
             d.by is string && d.by == request.auth.token.email.lower() &&
             d.createdAt is string && d.createdAt.size() <= 40 &&
             d.body is map && d.body.size() <= 15 && d.body.id == d.memberId &&
             (!d.keys().hasAny(['eventId']) || (d.eventId is string && d.eventId.size() <= 60)) &&
             exists(/databases/$(database)/documents/gymMembers/$(d.memberId));
    }
    match /gymOps/{opId} {
      allow read: if isInternalAdmin('מכון');
      allow create: if isInternalAdmin('מכון') && gymOpOk();
      allow update, delete: if false;
    }
    match /gymMembers/{docId} {
      allow read: if canSeeDoorState();
      allow update: if isInternalAdmin('מכון') &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(gymMemberPatchKeys()) &&
                       request.resource.data.log is list && request.resource.data.log.size() <= 60 &&
                       request.resource.data['סטטוס'] in gymStatuses();
      allow create, delete: if false;
    }
    function canSeeGymConfig(docId) {
      return (docId == 'public' && canSeeWework()) || isInternalAdmin('מכון');
    }
    match /gymConfig/{docId} {
      allow read: if canSeeGymConfig(docId);
      allow write: if false;
    }

    /* ========================================================================
     *  ועד השיכון v2 — מסמך יחיד committee/tree   (2026-09-25)
     * ------------------------------------------------------------------------
     *  Firestore הוא המסד החי של עץ הוועד (מודל ב'). הגיליון הישן "עץ ועד
     *  השיכון" נשאר רק כמקור להעברה הראשונה; הגיבוי הוא טאב _נתוני_.
     *  ר' js/screens/committeeTree.js.
     *
     *  🔒 קריאה — בדיוק כמו handleCommitteeTree_ בשרת: authorize_(…, null)
     *     חוסם משתמש חיצוני, ולכן גם כאן `isExternal == false`.
     *  🔒 כתיבה — מנהל-על בלבד, כמו saveCommitteeTree ב-ACTION_PERMS.
     *  🔒 `rev` עולה באחד בדיוק בכל שמירה. זה מה שמונע משני מנהלים לדרוס
     *     זה את זה: שמירה שנבנתה על גרסה ישנה נדחית כאן גם אם הדפדפן
     *     "שכח" לבדוק. יצירה רק עם rev == 1, ומחיקה סגורה.
     *  ⚠️ במסמך אין שמות תושבים — רק familyId + מספר דייר. שם חופשי נשמר
     *     רק לאדם מחוץ לשיכון (מב"ס, קבלן), שממילא אין לו רשומת תושב.
     *  ⚠️ הכלל לא בודק את התוכן של כל תפקיד ברשימה (כללי Firestore לא
     *     יודעים לעבור על רשימה). זה מקובל כי הכותב היחיד הוא מנהל-על.
     * ====================================================================== */
    function canSeeCommittee() {
      return isMember() && m().isExternal == false;
    }

    function committeeWriter() {
      return isSuper() && m().isExternal == false;
    }

    function committeeShapeOk() {
      return request.resource.data.keys().hasOnly(
               ['schema', 'rev', 'roles', 'cats', 'updatedAt', 'updatedBy']) &&
             request.resource.data.keys().hasAll(
               ['schema', 'rev', 'roles', 'cats', 'updatedAt', 'updatedBy']) &&
             request.resource.data.schema == 1 &&
             request.resource.data.rev is int &&
             request.resource.data.roles is list &&
             request.resource.data.roles.size() <= 300 &&
             request.resource.data.cats is list &&
             request.resource.data.cats.size() >= 1 &&
             request.resource.data.cats.size() <= 40 &&
             request.resource.data.updatedBy == request.auth.uid &&
             request.resource.data.updatedAt == request.time;
    }

    function committeeCreateOk(docId) {
      return docId == 'tree' && committeeWriter() && committeeShapeOk() &&
             request.resource.data.rev == 1;
    }

    function committeeUpdateOk() {
      return committeeWriter() && committeeShapeOk() &&
             request.resource.data.rev == resource.data.rev + 1;
    }

    match /committee/{docId} {
      allow read: if canSeeCommittee();
      allow create: if committeeCreateOk(docId);
      allow update: if committeeUpdateOk();
      allow delete: if false;
    }


    /* ========================================================================
     *  🌱  דשא והשקיה   (2026-10-04 · אפיון: claude/lawn-irrigation-2026-10.md)
     * ------------------------------------------------------------------------
     *  שלושה אוספים, מפוצלים **לפי מי רשאי לקרוא** — כלל פועל על מסמך שלם,
     *  ולכן החלוקה היא החלטת פרטיות ולא החלטת ביצועים:
     *
     *    gardenLawns      גבולות המדשאות (שם + צורה + rev). **כל חבר פעיל
     *                     קורא** — טופס הדיווח של התושב מציג את הגבול כשהנעיצה
     *                     נופלת בתוך מדשאה. אין כאן נתון על אדם, ואין מצב דשא.
     *    gardenAssets     ממטרות, מחשבי השקיה, צנרת, ו**מצב הדשא** (תקין/יבש/מת),
     *                     וגם **כתמים** (מקטע בתוך מדשאה — kind 'patch'). הגינון בלבד
     *                     (כולל הגנן החיצוני — הכרעת יועד 3.10).
     *                     🔴 כתם יושב כאן ולא ב-gardenLawns: הוא קיים רק איפה שהמצב
     *                     שונה מהמדשאה סביבו — כלומר הגבול שלו *הוא* מצב. (צוות אדום 4.10)
     *    gardenLawnEdits  דיוק גבול שתושב צירף לדיווח שלו. מזהה המסמך = מזהה
     *                     הדיווח (אחד לדיווח, "נסה שוב" לא מכפיל). התושב יוצר
     *                     בלבד; הגינון מחליט "עדכון"/"להשאיר".
     *
     *  🔑 **אין מחיקה לאיש** — הסרה היא `archived: true`. תקלה שמשויכת לממטרה
     *     (`assets` על המשימה) לא תצביע לעולם על מסמך שנעלם.
     *  🔑 נקודות = רשימה שטוחה [x0,y0,x1,y1,…] בשבר 0–1 של עולם המפה (אותן
     *     יחידות כמו נעיצת תקלה). Firestore אינו שומר רשימה בתוך רשימה.
     *  🔑 `rev` עולה באחד בדיוק בכל עדכון גבול — זה מה שמאפשר לגנן לראות
     *     שדיוק של תושב נעשה על גרסה ישנה של המדשאה.
     * ====================================================================== */
    function lwFields() {
      return ['id', 'name', 'shape', 'pts', 'cx', 'cy', 'r', 'rx', 'ry',
              'rev', 'archived', 'updatedAt', 'updatedBy', 'schema'];
    }

    /* 🔴 צוות אדום 4.10 — כל תושב מוריד את האוסף הזה: מספר בטווח 0–1 או חסר.
       (ערכי pts עצמם אינם נבדקים אחד-אחד — אין לולאות בכללים; הגבול הוא
       אורך הרשימה, והלקוח ממיר כל ערך למספר.) */
    function lwNum(f) {
      return !(f in request.resource.data) ||
             (request.resource.data[f] is number &&
              request.resource.data[f] >= 0 && request.resource.data[f] <= 1);
    }

    function lwGeomOk() {
      return lwNum('cx') && lwNum('cy') && lwNum('r') && lwNum('rx') && lwNum('ry') &&
             (request.resource.data.shape == 'poly' ||
              (request.resource.data.get('cx', null) is number &&
               request.resource.data.get('cy', null) is number));
    }

    function lwPtsOk() {
      return request.resource.data.get('pts', []) is list &&
             request.resource.data.get('pts', []).size() <= 240 &&
             request.resource.data.get('pts', []).size() % 2 == 0 &&
             (request.resource.data.shape != 'poly' ||
              request.resource.data.get('pts', []).size() >= 6);
    }

    function lwShapeOk() {
      return request.resource.data.keys().hasOnly(lwFields()) &&
             request.resource.data.keys().hasAll(['id', 'name', 'shape', 'rev',
                                                  'updatedAt', 'updatedBy', 'schema']) &&
             request.resource.data.name is string &&
             request.resource.data.name.size() <= 60 &&
             ['poly', 'circle', 'ellipse'].hasAny([request.resource.data.shape]) &&
             request.resource.data.rev is int &&
             request.resource.data.get('archived', false) is bool &&
             request.resource.data.updatedAt == request.time &&
             request.resource.data.updatedBy == request.auth.uid &&
             request.resource.data.schema is int &&
             lwPtsOk() && lwGeomOk();
    }

    function lwCreateOk(docId) {
      return hasPerm('גינון') && lwShapeOk() &&
             request.resource.data.id == docId &&
             request.resource.data.rev == 1;
    }

    function lwUpdateOk() {
      return hasPerm('גינון') && lwShapeOk() &&
             request.resource.data.id == resource.data.id &&
             request.resource.data.rev == resource.data.rev + 1;
    }

    match /gardenLawns/{docId} {
      allow read: if isMember();
      allow create: if lwCreateOk(docId);
      allow update: if lwUpdateOk();
      allow delete: if false;
    }

    function gaFields() {
      return ['id', 'kind', 'name', 'x', 'y', 'pts', 'ctrl', 'station', 'type', 'range',
              'lawnId', 'status', 'note', 'archived', 'updatedAt', 'updatedBy', 'schema',
              /* כתם (kind 'patch') — צורה כמו מדשאה, והמדשאה שהוא בתוכה. */
              'shape', 'cx', 'cy', 'r', 'rx', 'ry', 'parentId'];
    }

    function gaNum(f, max) {
      return !(f in request.resource.data) ||
             (request.resource.data[f] is number &&
              request.resource.data[f] >= 0 && request.resource.data[f] <= max);
    }

    function gaStr(f, max) {
      return request.resource.data.get(f, '') is string &&
             request.resource.data.get(f, '').size() <= max;
    }

    /* מצב דשא: מסמך 'lawn' קשור למדשאה שלו (מזהה = lawnId), וכתם נושא מצב משלו.
       לשאר הסוגים אין מצב. (צוות אדום 4.10) */
    function gaKindOk(docId) {
      return (request.resource.data.kind != 'lawn' ||
              (request.resource.data.get('lawnId', '') == docId &&
               ['ok', 'dry', 'dead'].hasAny([request.resource.data.get('status', '')]))) &&
             (request.resource.data.kind != 'patch' ||
              (['ok', 'dry', 'dead'].hasAny([request.resource.data.get('status', '')]) &&
               ['poly', 'circle', 'ellipse'].hasAny([request.resource.data.get('shape', '')]))) &&
             (['lawn', 'patch'].hasAny([request.resource.data.kind]) ||
              request.resource.data.get('status', '') == '');
    }

    function gaShapeOk() {
      return request.resource.data.keys().hasOnly(gaFields()) &&
             request.resource.data.keys().hasAll(['id', 'kind', 'updatedAt', 'updatedBy', 'schema']) &&
             ['spr', 'ctrl', 'pipe', 'lawn', 'patch'].hasAny([request.resource.data.kind]) &&
             gaStr('name', 60) && gaStr('note', 300) && gaStr('ctrl', 40) &&
             gaStr('lawnId', 40) && gaStr('parentId', 40) &&
             gaNum('x', 1) && gaNum('y', 1) && gaNum('cx', 1) && gaNum('cy', 1) &&
             gaNum('r', 1) && gaNum('rx', 1) && gaNum('ry', 1) &&
             gaNum('range', 50) && gaNum('station', 99) &&
             ['', 'ok', 'dry', 'dead'].hasAny([request.resource.data.get('status', '')]) &&
             ['', 'pop', 'rot', 'drip'].hasAny([request.resource.data.get('type', '')]) &&
             request.resource.data.get('archived', false) is bool &&
             request.resource.data.get('pts', []) is list &&
             request.resource.data.get('pts', []).size() <= 240 &&
             request.resource.data.get('pts', []).size() % 2 == 0 &&
             request.resource.data.updatedAt == request.time &&
             request.resource.data.updatedBy == request.auth.uid &&
             request.resource.data.schema is int;
    }

    function gaCreateOk(docId) {
      return hasPerm('גינון') && gaShapeOk() && gaKindOk(docId) && request.resource.data.id == docId;
    }

    /* `kind` אינו משתנה — ממטרה לא הופכת לצינור. */
    function gaUpdateOk(docId) {
      return hasPerm('גינון') && gaShapeOk() && gaKindOk(docId) &&
             request.resource.data.id == resource.data.id &&
             request.resource.data.kind == resource.data.kind;
    }

    /* שם משלו ולא canSeeGardenTasks — כדי ששינוי עתידי בכלל המשימות לא ישנה
       בשקט מי קורא את נכסי ההשקיה. (צוות אדום 4.10) */
    function canSeeGardenAssets() {
      return hasPerm('גינון');
    }

    match /gardenAssets/{docId} {
      allow read: if canSeeGardenAssets();
      allow create: if gaCreateOk(docId);
      allow update: if gaUpdateOk(docId);
      allow delete: if false;
    }

    /* 🔴 **הדיווח הוא של המשפחה שלי.** בלי זה כל תושב היה יכול לצרף
       "דיוק" לדיווח של שכן — לא חשיפה, אבל הזרקת עבודה לתור של הגנן
       בשם מישהו אחר. ⚠️ `myFamilyId() != ''` — ר' `canSeeFamilyTx`. */
    function leMyReport(docId) {
      return myFamilyId() != '' &&
             get(/databases/$(database)/documents/gardenReports/$(docId)).data.familyId == myFamilyId();
    }

    function leCreateOk(docId) {
      return isMember() && m().isExternal == false &&
             request.resource.data.keys().hasOnly(['id', 'lawnId', 'pts', 'baseRev', 'uid',
                                                   'status', 'createdAt', 'updatedAt', 'schema']) &&
             request.resource.data.keys().hasAll(['id', 'lawnId', 'pts', 'baseRev', 'uid',
                                                  'status', 'createdAt', 'updatedAt', 'schema']) &&
             request.resource.data.id == docId &&
             request.resource.data.uid == request.auth.uid &&
             request.resource.data.status == 'pending' &&
             request.resource.data.lawnId is string &&
             request.resource.data.baseRev is int &&
             request.resource.data.baseRev >= 1 &&
             /* 🔴 צוות אדום 4.10 — הגרסה שעליה נעשה הדיוק אינה עתידית. מדשאה
                שלא קיימת = get() נכשל = נדחה (אותו מספר קריאות כמו exists). */
             get(/databases/$(database)/documents/gardenLawns/$(request.resource.data.lawnId)).data.rev >=
               request.resource.data.baseRev &&
             request.resource.data.pts is list &&
             request.resource.data.pts.size() >= 6 &&
             request.resource.data.pts.size() <= 240 &&
             request.resource.data.pts.size() % 2 == 0 &&
             request.resource.data.createdAt == request.time &&
             request.resource.data.updatedAt == request.time &&
             request.resource.data.schema is int &&
             leMyReport(docId);
    }

    /* התושב קורא רק את שלו (השאילתה שלו מסננת `uid == שלי`); הגינון — הכול. */
    function leReadOk() {
      return hasPerm('גינון') ||
             (isMember() && m().isExternal == false && resource.data.uid == request.auth.uid);
    }

    /* החלטה פעם אחת, ממצב "ממתין" בלבד, בשם עצמך. הגבול עצמו מתעדכן
       ב-gardenLawns (lwUpdateOk) — כאן נרשמת רק ההחלטה. */
    function leDecideOk() {
      return hasPerm('גינון') &&
             resource.data.status == 'pending' &&
             request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'decidedBy', 'decidedAt', 'updatedAt']) &&
             ['approved', 'rejected'].hasAny([request.resource.data.status]) &&
             request.resource.data.decidedBy == request.auth.uid &&
             request.resource.data.decidedAt == request.time &&
             request.resource.data.updatedAt == request.time;
    }

    match /gardenLawnEdits/{docId} {
      allow read: if leReadOk();
      allow create: if leCreateOk(docId);
      allow update: if leDecideOk();
      allow delete: if false;
    }

    /* ---------- ברירת המחדל ---------- */

    /* 🔴 **הכול אסור, אלא אם נפתח במפורש למעלה.**
       ⚠️ הכלל הזה חייב להישאר **אחרון**, ואסור להחליף אותו ב-`allow read`
       גורף "רק עד שנסדר את זה" — זו בדיוק הנוסחה שחושפת מסד נתונים שלם.
       כל תחום שייפתח בעתיד מקבל בלוק `match` משלו **מעל** השורה הזאת. */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
