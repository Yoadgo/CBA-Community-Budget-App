rules_version = '2';

/* ============================================================================
 *  כללי האבטחה של Firestore — CBA / AtmoSync        (צעד 02ד, 2026-09-14)
 * ----------------------------------------------------------------------------
 *  🔴 **הקובץ הזה הוא השרת.** בארכיטקטורה שאליה אנחנו עוברים הדפדפן קורא
 *  ישירות מ-Firestore, בלי Apps Script באמצע — ולכן מה שכתוב כאן הוא הדבר
 *  היחיד שמפריד בין תושב לבין הנתונים של כל שאר השיכון. טעות כאן אינה קוד
 *  שנשבר אלא **נתונים שנחשפים בשקט**.
 *
 *  ⚠️ **המצב בצעד הזה: עדיין אין שום אוסף פתוח לקריאה.** הקובץ מניח את
 *     *התשתית* — פונקציות העזר שקוראות את `members/{uid}` — ומוודא שהן
 *     עובדות, לפני שתחום ראשון (הגינון, צעד 03) ייפתח בכלל. זו אותה שיטה
 *     של "פונקציה על גבי פונקציה": שער שנבדק לפני שיש מה לשמור עליו.
 *
 *  🔑 **מקור האמת להרשאות הוא `members/{uid}`**, שנכתב **אך ורק** ע"י
 *     Apps Script דרך חשבון שירות (חשבון שירות עוקף את הכללים האלה לגמרי,
 *     ולכן אין צורך — ואסור — לאפשר לדפדפן לכתוב לשם). ר' handleFirebaseLink_.
 *
 *  ⚠️ **עלות:** כל `get()` בתוך כלל נספר כקריאת מסמך מול מכסת Spark
 *     (50,000/יום). Firestore ממטמן את ה-`get()` בתוך הערכה אחת, ולכן
 *     `member()` נקראת פעם אחת לכל בקשה — אבל **אסור להוסיף get() נוסף**
 *     בלי לחשוב על המכסה.
 *
 *  🔴 **תנאי סף שעדיין פתוח (נפתח ב-02ג):** `savePermissions` ב-Apps Script
 *     עדיין אינו מעדכן את `members/{uid}`. כלומר שלילת הרשאה תיכנס לתוקף
 *     רק בהתחברות הבאה של אותו משתמש. **אסור לפתוח שום אוסף לקריאה לפי
 *     הרשאה לפני שזה נסגר.** היום זה לא מסוכן כי אין אוסף פתוח בכלל.
 * ========================================================================== */

service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------- פונקציות עזר ---------- */

    function signedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function memberPath() {
      return /databases/$(database)/documents/members/$(request.auth.uid);
    }

    /* ⚠️ `exists()` לפני `get()` — משתמש שהתחבר ל-Firebase אבל עדיין אין לו
       רשומת חבר (למשל ההתחברות הצליחה והקישור לשרת נכשל) אינו שגיאה, הוא
       פשוט לא-חבר. בלי הבדיקה הזו הכלל היה נכשל בחריגה במקום להחזיר "אסור". */
    function isMember() {
      return signedIn() && exists(memberPath()) && member().active == true;
    }

    function member() {
      return get(memberPath()).data;
    }

    function perms() {
      return isMember() ? member().perms : [];
    }

    function isSuper() {
      return isMember() && ('על' in member().perms);
    }

    /* מנהל-על מקבל כל הרשאה, בדיוק כמו ב-authorize_ בצד Apps Script.
       ⚠️ **שתי המערכות חייבות להסכים על הכלל הזה.** אם הוא ישתנה בצד אחד
       בלבד, אותו משתמש יראה דברים שונים בשני המסלולים — וזה בדיוק סוג
       הסטייה השקטה שכלל הסטייה הגלויה בא למנוע. */
    function hasPerm(p) {
      return isMember() && (isSuper() || (p in member().perms));
    }

    function myFamilyId() {
      return isMember() ? member().familyId : '';
    }

    function isExternalUser() {
      return isMember() && member().isExternal == true;
    }

    /* 🔴 **`active` הוא מתג הכיבוי.** תושב שסומן "עזב" בגיליון חייב לאבד
       גישה — ו-`authorize_` בצד Apps Script אוכף את זה, אבל כללי האבטחה
       רואים רק את המסמך הזה. לכן `isMember()` דורש `active == true`.
       ⚠️ **פתוח: סימון "עזב" בגיליון עדיין אינו מכבה את השדה הזה.**
          היום זה לא מסוכן כי אין שום אוסף פתוח לקריאה — אבל זהו **חוסם
          מוצהר לצעד 03**, ואסור לפתוח תחום ראשון לפני שהוא נסגר.

       ---------- רשומת החבר עצמה ---------- */

    match /members/{uid} {
      /* קריאה: כל אחד את שלו בלבד. שימושי לאבחון ("מה המערכת חושבת שאני?")
         ואינו חושף כלום — המשתמש כבר יודע מה ההרשאות שלו. */
      allow read: if signedIn() && request.auth.uid == uid;
      /* 🔴 **כתיבה אסורה לחלוטין, לכל אחד.** המסמך הזה הוא מקור ההרשאות;
         משתמש שיכול לערוך אותו יכול להעניק לעצמו כל הרשאה שירצה. Apps Script
         כותב דרך חשבון שירות, שעוקף את הכללים האלה ואינו זקוק להיתר כאן. */
      allow write: if false;
    }

    /* ---------- ברירת המחדל ---------- */

    /* 🔴 **הכול אסור, אלא אם נפתח במפורש למעלה.**
       ⚠️ הכלל הזה חייב להישאר **אחרון**, ואסור להחליף אותו ב-`allow read`
       גורף "רק עד שנסדר את זה" — זו בדיוק הנוסחה שחושפת מסד נתונים שלם.
       כל תחום שייפתח בעתיד מקבל בלוק `match` משלו **מעל** השורה הזאת. */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
