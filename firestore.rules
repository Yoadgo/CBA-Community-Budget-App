rules_version = '2';

/* ============================================================================
 *  כללי האבטחה של Firestore — CBA / AtmoSync        (צעד 02ד, 2026-09-14)
 * ----------------------------------------------------------------------------
 *  🔴 **הקובץ הזה הוא השרת.** בארכיטקטורה שאליה אנחנו עוברים הדפדפן קורא
 *  ישירות מ-Firestore, בלי Apps Script באמצע — ולכן מה שכתוב כאן הוא הדבר
 *  היחיד שמפריד בין תושב לבין הנתונים של כל שאר השיכון. טעות כאן אינה קוד
 *  שנשבר אלא **נתונים שנחשפים בשקט**.
 *
 *  ✅ **תחום ראשון פתוח לקריאה (צעד 03ב, 2026-09-15): תוכנית העבודה של הגינון.**
 *     `gardenPlan` ו-`gardenMeta` — הגדרות עבודה בלבד, **בלי שום מידע אישי**.
 *     ו-`services` (צעד 04ב) — שירותים לתושב. 🔴 עמודת `עודכן ע"י`
 *     (אימייל של מנהל) **אינה מסונכרנת לשם** — ר' servicesSyncAll_.
 *     כל שאר האוספים עדיין חסומים לחלוטין תחת ברירת המחדל.
 *
 *  🔑 **מקור האמת להרשאות הוא `members/{uid}`**, שנכתב **אך ורק** ע"י
 *     Apps Script דרך חשבון שירות (חשבון שירות עוקף את הכללים האלה לגמרי,
 *     ולכן אין צורך — ואסור — לאפשר לדפדפן לכתוב לשם). ר' handleFirebaseLink_.
 *
 *  ⚠️ **עלות:** כל `get()` בתוך כלל נספר כקריאת מסמך מול מכסת Spark
 *     (50,000/יום). Firestore ממטמן את ה-`get()` בתוך הערכה אחת, ולכן
 *     `member()` נקראת פעם אחת לכל בקשה — אבל **אסור להוסיף get() נוסף**
 *     בלי לחשוב על המכסה.
 *
 *  ✅ **תנאי הסף נסגר (02ג):** `savePermissions` מסנכרן את `members/{uid}` מיידית,
 *     ו-`fbSyncRow_` מחווט לכל ארבעת מסלולי הכתיבה לשורת התושב. שלילת
 *     הרשאה או סימון "עזב" נכנסים לתוקף מיד. זה מה שהתיר לפתוח
 *     תחום ראשון לקריאה לפי הרשאה.
 * ========================================================================== */

service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------- פונקציות עזר ---------- */

    function signedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    /* ⚠️ **פונקציה בכללי Firestore לא מחזירה נתיב.** הנתיב נבנה בתוך
       `get()`/`exists()` עצמם — זה הדפוס המתועד, והיחיד שאפשר לסמוך עליו. */
    function memberExists() {
      return signedIn() && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }

    function m() {
      return get(/databases/$(database)/documents/members/$(request.auth.uid)).data;
    }

    function isMember() {
      return memberExists() && m().active == true;
    }

    function isSuper() {
      return isMember() && ('על' in m().perms);
    }

    /* מנהל-על מקבל כל הרשאה, בדיוק כמו ב-authorize_ בצד Apps Script.
       ⚠️ **שתי המערכות חייבות להסכים על הכלל הזה.** אם הוא ישתנה בצד אחד
       בלבד, אותו משתמש יראה דברים שונים בשני המסלולים — וזה בדיוק סוג
       הסטייה השקטה שכלל הסטייה הגלויה בא למנוע. */
    function hasPerm(p) {
      return isMember() && (isSuper() || (p in m().perms));
    }

    function myFamilyId() {
      return isMember() ? m().familyId : '';
    }

    function isExternalUser() {
      return isMember() && m().isExternal == true;
    }

    /* ---------- תוכנית העבודה של הגינון (צעד 03ב) ---------- */

    /* 🔴 **שתי הדרישות אינן עודפות.**
       הראשונה, `hasPerm('גינון')` — רק מי שעוסק בגינון רואה את התוכנית.
       השנייה, `isExternal == false` — **מידור, לא הסתרה.** אחראי הגינון
       החיצוני מבצע משימות אבל אינו רואה את תוכנית העבודה — היא סמכות
       המנהל. `handleGardenPlan_` אוכף את זה בשרת מהיום הראשון; אם הכלל
       כאן לא יאכוף אותו גם, פתחנו לו דלת אחורית בדיוק לדבר היחיד
       שמידרנו ממנו.

       ⚠️ **`== false` ולא `!= true` — בכוונה.** שדה חסר במסמך היה עובר
       את `!= true` ומעניק גישה. `handleFirebaseLink_` כותב את השדה תמיד,
       ולכן הצורה הנוקשה נכשלת-סגור בלי לחסום אף משתמש אמיתי.

       ⚠️ **עלות:** `canSeePlan()` עולה `exists()` אחד ו-`get()` אחד על
       `members/{uid}`. Firestore ממטמן אותם בתוך הערכה אחת, ולכן קריאת
       כל התוכנית עולה 19 מסמכים + קריאה אחת לכלל, לא 20 קריאות לכלל. */
    function canSeePlan() {
      return hasPerm('גינון') && m().isExternal == false;
    }

    match /gardenPlan/{id} {
      allow read: if canSeePlan();
      /* 🔴 הדפדפן לעולם אינו כותב. כל שינוי עובר דרך Apps Script אל
         הגיליון, ומשם מסונכרן לכאן ע"י חשבון השירות (שעוקף כללים).
         שני מקורות כתיבה = שני מקורות אמת שיסתרו זה את זה בשקט. */
      allow write: if false;
    }

    /* 🔑 **נפתח לאחראי הגינון החיצוני** (הכרעת יועד, 16.9). הרשימות
       האלה הן שמות האזורים והקטגוריות — והוא כבר רואה אותם על כל
       משימה שהוא מבצע. להסתיר ממנו את הרשימה בזמן שמציגים לו את
       הערכים אינה הגנה, והיא שוברת את קיבוץ המסך במסלול Firestore.
       ⚠️ **תוכנית העבודה עצמה נשארת חסומה לו** (`canSeePlan`) — שם
          המידור אמיתי, וזה בדיוק ההבדל. */
    match /gardenMeta/{doc} {
      allow read: if canSeeGardenTasks();
      allow write: if false;
    }

    /* ========================================================================
     *  🔴🔴  דיווחי הגינון של התושב   (2026-09-16)
     * ------------------------------------------------------------------------
     *  **התקלה שזה פותר, במילים של יועד:** "תושב אחר ממש לא רואה
     *  דיווחים של שכנים."
     *
     *  🔴 **וזו בדיוק הסיבה שהאוסף מפוצל למסמך לכל דיווח.** כלל
     *  אבטחה פועל על **מסמך שלם** ואינו יודע לסנן שורות בתוכו.
     *  מסמך אחד שמחזיק את כל הדיווחים היה חושף את כולם לכל מי
     *  שמותר לו לקרוא אותו — אין כלל שמונע את זה, כי אין מה
     *  לאכוף עליו. אותו שיקול בדיוק, ומאותה סיבה, קבע את החלוקה
     *  בתנועות התקציב.
     *
     *  🔴 **ומכאן נובע דבר שני, פחות מובן מאליו:** Firestore מאשר
     *  **שאילתה** רק אם אפשר להוכיח אותה מראש מול הכלל. שאילתה על
     *  האוסף בלי מסנן `familyId` נדחית **לפני** שנקרא ולו מסמך
     *  אחד. כלומר אין מסלול של "לקרוא הכול ולסנן בדפדפן" — לא כי
     *  זה אסור, אלא כי זה בלתי-אפשרי.
     *
     *  ⚠️ **שלושת התנאים — כל אחד נחוץ**, בדיוק כמו ב-`canSeeFamilyTx`:
     *    1. `is string` — שדה חסר או מסוג אחר מפיל את הכלל סגור.
     *    2. `!= ''` — **הקריטי.** `myFamilyId()` מחזירה `''` למי שאינו
     *       חבר או ששדה המשפחה שלו ריק, ובלי התנאי הזה `'' == ''`
     *       היה פותח לו כל מסמך חסר-משפחה. הסנכרון בשרת מדלג על
     *       שורה בלי מזהה משפחה ולכן אין מסמך כזה — **והכלל אינו
     *       נשען על זה.** שתי הגנות, בכוונה.
     *    3. השוואה למשפחה שלו — וזה הלב.
     *
     *  🔑 **שני בני המשפחה רואים את אותם דיווחים** (הכרעת יועד):
     *  המפתח הוא `familyId` ולא `uid`. בן זוג שרואה את הדיווח על
     *  הממטרה בחצר המשותפת הוא התנהגות רצויה, לא דליפה.
     *
     *  ⚠️ **המנהל אינו נכלל כאן, בכוונה.** מסכי הניהול של הדיווחים
     *  עדיין קוראים מ-Apps Script. כלל שפותח להם את האוסף עכשיו
     *  היה מעניק גישה שאיש אינו משתמש בה — וזה בדיוק סוג החשיפה
     *  השקטה שהצוות האדום תפס ב-16.9 (קוד דלת של מכון הכושר).
     *  פתיחה למנהל היא החלטה נפרדת, בצעד שבו המסך שלו באמת עובר.
     *
     *  🔴🔴 **`isExternal == false` — נוסף 16.9 אחרי סקירת צוות אדום,
     *  והוא לא היה כאן.** בלעדיו האחראי החיצוני שהוא גם תושב היה
     *  קורא את הדיווחים של **הבית שלו עצמו** — לא דליפה של אחרים,
     *  ולכן קל לפטור את זה כ"לא נורא". **וזו בדיוק הטעות.**
     *
     *  הכלל שנשבר כאן אינו "כמה נזק" אלא **הכללים לעולם אינם רחבים
     *  מהשרת**. ב-`authorize_` יושבת שורה אחת:
     *      if (perm.isExternal && need !== PERM_GARDEN) → חסום
     *  ו-`handleMyGardenReports_` קורא עם `need = null`. כלומר
     *  **השרת חוסם אותו מהדיווחים, ו-Firestore היה פותח.**
     *
     *  ⚠️ ברגע שמתירים חריגה אחת "כי היא לא מזיקה", אי אפשר עוד
     *     לענות על "האם הכללים מסכימים עם השרת" בלי לעבור אחד-אחד.
     *     האינווריאנטה היא הנכס, לא המקרה הפרטי.
     *
     *  🔑 **ומכאן ההבדל מ-`canSeeGardenTasks` מקבל הסבר מדויק:**
     *  משימות נקראות עם `need = PERM_GARDEN`, ולכן אותה שורה
     *  עצמה **מתירה** לו. שני הכללים שונים כי שני ה-`need` שונים —
     *  לא כי החלטנו כך, אלא כי כך השרת מתנהג.
     *
     *  🔒 **מה אין במסמך:** שם המדווח והטלפון נשארים בגיליון.
     *  המסמך נושא `familyId` בלבד — הוא גשר, לא זהות.
     * ====================================================================== */
    function canSeeGardenReport(fid) {
      return isMember() && m().isExternal == false &&
             fid is string && fid != '' && fid == myFamilyId();
    }

    /* ========================================================================
     *  🔴🔴  כתיבת דיווחי גינון מהדפדפן   (2026-09-16, ההיפוך)
     * ------------------------------------------------------------------------
     *  ⚠️⚠️ **זה שינוי באופי של הקובץ.** עד כאן כמעט כל אוסף הוא
     *  קריאה-בלבד, והמשפט "הדפדפן לעולם אינו כותב" חוזר בכל בלוק.
     *  כאן הוא מפסיק להיות נכון לגינון, כי Firestore הופך למסד החי
     *  והגיליון לגיבוי. כלל קריאה שגוי **חושף**; כלל כתיבה שגוי נותן
     *  לשנות נתונים של אחרים. זו קטגוריית סיכון אחרת, ולכן הבלוק
     *  הזה מפורט יותר מכל מה שמעליו.
     *
     *  🔴 **ההפרדה שמחזיקה הכול:** מסמך הדיווח נושא שני סוגי מידע —
     *  מה ש**התושב אמר** (כותרת, תיאור, מיקום, משוב) ומה ש**הצוות
     *  עשה** (שלב, סגירה, קישור למשימה, חלון משוב). ברגע שהתושב הוא
     *  הכותב, שניהם יושבים באותו מסמך והכלל הוא הדבר היחיד שמפריד.
     *  בלי ההפרדה תושב פותח תקלה ומיד מסמן אותה "הושלם", או פותח
     *  לעצמו חלון משוב אינסופי.
     * ====================================================================== */

    /* השדות שתושב רשאי לשלוח ביצירה — רשימה סגורה. */
    function grCreateFields() {
      return ['id', 'familyId', 'date', 'category', 'area', 'title', 'desc',
              'place', 'x', 'y', 'photos', 'taskId', 'clientRef',
              /* 🔴 תיבת הדואר — הדפדפן מרים דגל, והעבודה השעתית
                 שולחת ומורידה אותו. כלל אבטחה אינו יכול לשלוח מייל
                 (אין Cloud Functions בתוכנית החינמית), ולכן זה
                 המנגנון. בוליאני בלבד: **התבנית והנמענים נגזרים
                 בשרת מתוכן המסמך**, לא משדה שהלקוח בוחר. */
              'mailPending',
              /* 🔴 **כמה תמונות נשלחו מול כמה נחתו.** עד היום תמונה
                 שנכשלה נבלעה בשקט בשרת והתושב קיבל "נשלח" כרגיל —
                 כלומר שלח שלוש, נחתה אחת, ואיש לא ידע. השדות האלה
                 הופכים את הפער לנתון: התושב רואה אותו, המנהל רואה
                 אותו, והעבודה השעתית סורקת `photosIncomplete == true`
                 ומתריעה על מה שאיש לא השלים.
                 ⚠️ שוויון בלבד — השוואה בין שני שדות הייתה דורשת
                    אינדקס, והקונסולה חסומה. */
              'photosExpected', 'photosIncomplete',
              'year', 'schema', 'updatedAt'];
    }

    /* השדות שהצוות מחזיק — תושב לעולם אינו שולח אותם ביצירה.
       ⚠️ הם נוצרים כברירת מחדל בקריאה (שדה חסר = ריק), ולא
          כערכים שהלקוח בוחר. */
    function grTeamFields() {
      return ['stage', 'flag', 'closure', 'closeWhy', 'mergedInto',
              'feedback', 'feedbackUntil', 'canFeedback'];
    }

    function grShapeOk() {
      return request.resource.data.keys().hasOnly(grCreateFields()) &&
             request.resource.data.keys().hasAll(
               ['id', 'familyId', 'title', 'category', 'schema']) &&
             /* 🔴 אף שדה של הצוות — ר' ההפרדה בראש הבלוק. */
             !request.resource.data.keys().hasAny(grTeamFields()) &&
             request.resource.data.familyId is string &&
             request.resource.data.familyId != '' &&
             request.resource.data.title is string &&
             request.resource.data.title.size() > 0 &&
             request.resource.data.title.size() <= 60 &&
             request.resource.data.category is string &&
             request.resource.data.category != '' &&
             request.resource.data.schema is int &&
             (!request.resource.data.keys().hasAny(['mailPending']) ||
              request.resource.data.mailPending is bool);
    }

    /* מיקום: או נעיצה מנורמלת 0–1, או מיקום מילולי. בדיוק התנאי
       שהשרת אכף עד היום ב-`submitGardenReport_`. */
    function grPlaceOk() {
      return (request.resource.data.get('x', null) == null &&
              request.resource.data.get('y', null) == null &&
              request.resource.data.get('place', '') != '') ||
             (request.resource.data.get('x', null) is number &&
              request.resource.data.get('y', null) is number &&
              request.resource.data.x >= 0 && request.resource.data.x <= 1 &&
              request.resource.data.y >= 0 && request.resource.data.y <= 1);
    }

    /* 🔴 יצירה בלבד למשפחה שלו, ורק כשהוא תושב פעיל שאינו חיצוני —
       בדיוק כמו `canSeeGardenReport`, כי אותו שער בדיוק חל בשרת. */
    function grCreateOk() {
      return isMember() && m().isExternal == false &&
             request.resource.data.familyId == myFamilyId() &&
             grShapeOk() && grPlaceOk();
    }

    /* התושב רשאי לכתוב **משוב בלבד**, ורק על מסמך קיים שלו.
       ⚠️ `affectedKeys().hasOnly` הוא הלב: הוא מונע ממנו לגעת
          ב-`stage`, ב-`familyId` או בתיאור אחרי ההגשה. */
    function grFeedbackOk() {
      return isMember() && m().isExternal == false &&
             resource.data.familyId == myFamilyId() &&
             request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['feedback', 'feedbackNote', 'feedbackAt', 'updatedAt']) &&
             /* חלון המשוב נאכף כאן ולא רק במסך — המסך הוא נוחות,
                הכלל הוא ההגבלה. 0 = משימה שלא אושרה, ואז אין חלון. */
             resource.data.canFeedback == true &&
             (resource.data.get('feedbackUntil', 0) == 0 ||
              request.time.toMillis() <= resource.data.get('feedbackUntil', 0));
    }

    /* 🔴 **השלמת תמונות לדיווח שכבר הוגש.** ההעלאה היא תמונה-תמונה,
       ולכן דיווח יכול להיוולד עם חלק מהתמונות — והתושב חוזר להשלים.
       ⚠️ **`photos` בלבד**, ולא תיאור/כותרת/מיקום: דיווח אינו נערך
          אחרי ההגשה, וזה לא פתח לערוך אותו בדלת האחורית.
       ⚠️ מזהי Drive שנכתבים כאן אינם מסוכנים: הצפייה עוברת דרך
          `gardenPhoto` ב-Apps Script, שבודק הרשאה בעצמו. */
    function grPhotosOk() {
      return isMember() && m().isExternal == false &&
             resource.data.familyId == myFamilyId() &&
             request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['photos', 'photosIncomplete', 'updatedAt']);
    }

    /* הצוות מזיז את הדיווח בתהליך. ⚠️ **`familyId` אינו ברשימה —
       גם לא למנהל.** שינוי בעלות על דיווח אינו פעולה שקיימת. */
    function grTeamUpdateOk() {
      return hasPerm('גינון') &&
             request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['stage', 'flag', 'closure', 'closeWhy', 'mergedInto',
                         'taskId', 'canFeedback', 'feedbackUntil',
                         'photos', 'photosIncomplete', 'updatedAt']);
    }

    match /gardenReports/{id} {
      allow read: if canSeeGardenReport(resource.data.familyId);
      /* ⚠️ `create` ולא `write`: מסמך קיים נכשל מעצמו, ולכן תושב
         אינו יכול לדרוס דיווח של שכן בכך שינחש מזהה. */
      allow create: if grCreateOk();
      allow update: if grFeedbackOk() || grPhotosOk() || grTeamUpdateOk();
      /* 🔴 אין מחיקה, לאיש. דיווח שנסגר מקבל `closure`, לא היעלמות. */
      allow delete: if false;
    }

    /* ========================================================================
     *  משימות הגינון   (2026-09-16)
     * ------------------------------------------------------------------------
     *  🔴 **הכלל כאן רחב יותר מזה של `gardenPlan`, וזה נראה כמו
     *  סתירה. הוא לא.**
     *
     *  בתוכנית העבודה האחראי החיצוני **חסום במפורש** (`canSeePlan`
     *  דורש `isExternal == false`) — המידור שם אמיתי: התוכנית היא
     *  סמכות המנהל.
     *
     *  במשימות הוא **אינו** חסום, כי `handleGardenTasks_` אינו חוסם
     *  אותו: מאז 9.9 ה-scope `all` מחזיר את כל המשימות לכל מי שיש
     *  לו `PERM_GARDEN`, והחיצוני בכללם. ההגבלה על `pending` חלה רק
     *  על ה-scopes הישנים, ואינה מגיעה ל-`all` שהמסך משתמש בו.
     *
     *  ⚠️ **ולכן `hasPerm('גינון')` לבדו הוא בדיוק מה שהשרת נותן —
     *  לא פחות ולא יותר.** כלל צר יותר כאן היה שובר לגנן את המסך
     *  במסלול Firestore בלבד; כלל רחב יותר היה הרחבה שקטה.
     *  אימתתי את זה בקוד ולא הנחתי.
     *
     *  🔒 **מה אין במסמך:** `updatedBy` ('עודכן על ידי') ירד — שם של
     *  אדם שאף מסך אינו מציג. `approvedBy` נשאר, כי הוא **כן** מוצג
     *  (gardenTasks.js:663, :1606) והאוסף סגור לבעלי הרשאת גינון.
     * ====================================================================== */
    function canSeeGardenTasks() {
      return hasPerm('גינון');
    }

    /* ========================================================================
     *  🔴🔴  כתיבת משימות גינון מהדפדפן   (2026-09-16, ההיפוך)
     * ------------------------------------------------------------------------
     *  משימה נוצרת בשני מצבים: תושב מגיש דיווח (ואז נולדת משימה
     *  נלווית), או שהצוות פותח משימה בעצמו. **שני המצבים כותבים את
     *  אותו מסמך**, ולכן שני שערי יצירה.
     *
     *  🔴 **`gtFromReportOk` הוא החריג המסוכן**, וצריך לקרוא אותו
     *  לאט: הוא נותן ל**תושב** ליצור מסמך באוסף שכולו של הצוות.
     *  מה שמחזיק אותו סגור: השלב חייב להיות 'התקבל' — נקודת
     *  הפתיחה ותו לא — ואסור לו לשלוח דגל, סגירה, שבוע או אישור.
     *  כלומר הוא יכול ליצור עבודה, ולעולם לא לסמן אותה כנעשתה.
     * ====================================================================== */
    function gtFields() {
      return ['id', 'kind', 'templateId', 'title', 'category', 'area', 'x', 'y',
              'stage', 'flag', 'closure', 'week', 'due', 'note', 'drags',
              'firstWeek', 'createdAt', 'updatedAt', 'approvedBy', 'approvedAt',
              'repId', 'photos', 'order', 'year', 'schema', 'syncedAt'];
    }

    /* השדות שרק הצוות קובע — תושב אינו שולח אותם כלל. */
    function gtTeamOnly() {
      return ['flag', 'closure', 'week', 'due', 'note', 'drags',
              'approvedBy', 'approvedAt'];
    }

    function gtShapeOk() {
      return request.resource.data.keys().hasOnly(gtFields()) &&
             request.resource.data.keys().hasAll(['id', 'title', 'stage', 'schema']) &&
             request.resource.data.title is string &&
             request.resource.data.title.size() > 0 &&
             request.resource.data.schema is int;
    }

    /* 🔴 תושב פותח משימה נלווית לדיווח — בנקודת הפתיחה בלבד. */
    function gtFromReportOk() {
      return isMember() && m().isExternal == false &&
             gtShapeOk() &&
             request.resource.data.stage == 'התקבל' &&
             !request.resource.data.keys().hasAny(gtTeamOnly());
    }

    /* הצוות פותח משימה בעצמו — בלי ההגבלה על השלב. */
    function gtTeamCreateOk() {
      return hasPerm('גינון') && gtShapeOk();
    }

    /* ⚠️ `id` אינו ברשימה: מזהה שנקבע ביצירה אינו משתנה לעולם.
       שינוי שלו היה מנתק את הדיווח שמצביע על המשימה. */
    function gtTeamUpdateOk() {
      return hasPerm('גינון') &&
             request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['stage', 'flag', 'closure', 'week', 'due', 'note',
                         'drags', 'firstWeek', 'title', 'category', 'area',
                         'x', 'y', 'approvedBy', 'approvedAt',
                         'repId', 'photos', 'order', 'updatedAt', 'syncedAt']);
    }

    /* 🔴 מחיקה למנהל בלבד — לא לקבלן החיצוני. משימה שנסגרה מקבלת
       `closure`; מחיקה שמורה לטעות הזנה, והיא הפעולה היחידה בגינון
       שאי אפשר לבטל. */
    function gtDeleteOk() {
      return hasPerm('גינון') && m().isExternal == false;
    }

    match /gardenTasks/{id} {
      allow read: if canSeeGardenTasks();
      allow create: if gtTeamCreateOk() || gtFromReportOk();
      allow update: if gtTeamUpdateOk();
      allow delete: if gtDeleteOk();
    }

    /* ========================================================================
     *  🔴  יומן הגינון — הוספה בלבד   (2026-09-16)
     * ------------------------------------------------------------------------
     *  היסטוריה שאינה משתכתבת. זה היה עקרון באפיון כשהיומן היה טאב
     *  בגיליון, והוא נשמר כאן **באכיפה ולא בנוהג**: אין `update`,
     *  אין `delete`, לאיש, אף פעם.
     *
     *  🔴 **`actorUid` נאכף להיות הכותב עצמו.** כשהדפדפן כותב את
     *  היומן, "מי עשה את זה" הופך לשדה שהכותב ממלא — כלומר בלי
     *  הכלל הזה כל אחד יכול לרשום פעולה בשם מישהו אחר. זה ההבדל
     *  בין יומן לבין רשימת טענות.
     *  ⚠️ **uid ולא שם** — ר' ההחלטה על `residentDirectory`: השם
     *     נפתר בשרת בעת הצורך, ולא נשמר כאן.
     * ====================================================================== */
    function glCreateOk() {
      return hasPerm('גינון') &&
             request.resource.data.keys().hasOnly(
               ['taskId', 'kind', 'field', 'from', 'to', 'actorUid',
                'note', 'at', 'schema']) &&
             request.resource.data.keys().hasAll(['taskId', 'actorUid', 'at']) &&
             request.resource.data.actorUid == request.auth.uid;
    }

    /* 🔴 גם התושב רושם ביומן — הגשת דיווח ומשוב הן אירועים בהיסטוריה.
       אותה אכיפה על `actorUid`, ובלי אפשרות לגעת בשלב. */
    function glResidentCreateOk() {
      return isMember() && m().isExternal == false &&
             request.resource.data.keys().hasOnly(
               ['taskId', 'kind', 'field', 'from', 'to', 'actorUid',
                'note', 'at', 'schema']) &&
             request.resource.data.keys().hasAll(['taskId', 'actorUid', 'at']) &&
             request.resource.data.actorUid == request.auth.uid &&
             (request.resource.data.kind == 'נפתח' ||
              request.resource.data.kind == 'משוב');
    }

    match /gardenLog/{id} {
      allow read: if canSeeGardenTasks();
      allow create: if glCreateOk() || glResidentCreateOk();
      /* 🔴🔴 היסטוריה אינה משתכתבת. */
      allow update, delete: if false;
    }

    /* ---------- שירותים לתושב (צעד 04ב) ---------- */

    /* 🔑 **הדרישה כאן רחבה יותר בכוונה, והיא מעתיקה בדיוק את השרת.**
       `handleServices_` קורא ל-`authorize_(ss, p, null)` — כל תושב פעיל רואה
       את רשימת השירותים, בלי צורך בהרשאה מיוחדת. זה מידע קהילתי
       מפורסם (גז, אינטרנט, בריכה), לא נתונים של אדם מסוים.

       ⚠️ **אבל `null` ב-`authorize_` אינו "לכולם".** השער החיצוני שם חוסם
       משתמש חיצוני מכל פעולה שאינה גינון — ולכן גם משירותים.
       אם הכלל כאן היה מסתפק ב-`isMember()`, הקריאה הישירה היתה **רחבה
       יותר מהשרת** — וזו בדיוק הסטייה השקטה שהמעבר הזה עלול לייצר. */
    function canSeeServices() {
      return isMember() && m().isExternal == false;
    }

    match /services/{id} {
      allow read: if canSeeServices();
      /* 🔴 כמו בכל האוספים: הדפדפן לעולם אינו כותב. */
      allow write: if false;
    }

    /* ---------- מטא-התקציב לפי שנה (צעד 08א) ---------- */

    /* 🔑 **הכלל הזה מעתיק בדיוק את `seesBudget` שב-doGet.**
       שם: `perm.isSuper || perms.indexOf(PERM_BUDGET) !== -1`. תושב בלי
       הרשאת תקציב מקבל היום `budget: [], income: [], groups: [],
       splits: [], items: []` — כלומר **שום דבר**. אם הכלל כאן
       היה מסתפק ב-`isMember()`, הקריאה הישירה היתה חושפת
       לכל תושב את כל תכנית התקציב — דלת אחורית שלמה
       למידור שהשרת אוכף מהיום הראשון.

       ⚠️ `isExternal == false` מאותה סיבה כמו בשאר: `authorize_` חוסם
          משתמש חיצוני מכל פעולה שאינה גינון. ושוב `== false`
          ולא `!= true`, כדי ששדה חסר ייכשל-סגור.

       🔴 **אין כאן תנועות, וזה העיקר.** חמש הטבלאות שכן כאן
       נבדקו ואין בהן נתונים אישיים (`משפחות` בהכנסות הוא
       **מספר**). תנועות נושאות מזהה משפחה ודורשות סינון
       לפי משפחה בכלל עצמו — אוסף נפרד, בצעד נפרד (08ב).
       **אסור להוסיף תנועות למסמך השנה הזה** — הכלל כאן הוא
       הכול-או-לא-כלום, והוא אינו יודע לסנן שדות בתוך מסמך. */
    function canSeeBudget() {
      return hasPerm('תקציב') && m().isExternal == false;
    }

    /* מי רואה מסמך תנועות של משפחה אחת.
       🔴 **שלושת התנאים בענף התושב — כל אחד נחוץ:**
       1. `is string` — שדה חסר או מסוג אחר מפיל את הכלל סגור.
       2. `!= ''` — **התנאי הקריטי.** דלי החסרי-משפחה נשמר עם
          `familyId: ''`, ו-`myFamilyId()` מחזירה `''` למי שאינו חבר
          או ששדה המשפחה שלו ריק. בלי התנאי הזה `'' == ''`
          היה פותח לו את כל התנועות הלא-משויכות.
       3. ההשוואה עצמה. */
    function canSeeFamilyTx(fid) {
      return canSeeBudget() ||
             (fid is string && fid != '' && fid == myFamilyId());
    }

    match /budgetYears/{year} {
      allow read: if canSeeBudget();
      /* 🔴 כמו בכל האוספים: הדפדפן לעולם אינו כותב. */
      allow write: if false;
    }

    /* ------------------------------------------------------------------
       תנועות — מסמך לכל (שנה, משפחה)   (צעד 08ב, 2026-09-15)

       🔴 **הכלל הראשון כאן שהוא לא "הכל או כלום".** תושב רואה את
       של משפחתו ובלבד. בדיוק בשביל זה החלוקה היא למסמך
       לכל משפחה: כלל פועל על **מסמך שלם** ואינו יודע לסנן
       שורות בתוך מסמך. מסמך אחד לכל השנה היה חושף לכל
       תושב את ההוצאות של כל השכנים.

       🔴 **שלושת התנאים בענף התושב — כל אחד נחוץ:**
       1. `is string` — שדה חסר או מסוג אחר מפיל את הכלל סגור.
       2. `!= ''` — **התנאי הקריטי.** דלי החסרי-משפחה נשמר עם
          `familyId: ''`, ו-`myFamilyId()` מחזירה `''` למי שאינו חבר
          או ששדה המשפחה שלו ריק. בלי התנאי הזה `'' == ''`
          היה פותח לו את כל התנועות הלא-משויכות.
       3. ההשוואה עצמה.

       ⚠️ **אין כאן צורך באינדקס מורכב** (וזה קריטי — קונסולת
       Google Cloud חסומה ב-2SV): מצעד 09 יש **מסמך לכל תנועה**,
       והקריאה היא שאילת שוויון: בעל התקציב מסנן `year ==`
       בלבד, והתושב `year ==` וגם `familyId ==`. שתי שאילתות שוויון
       על שדות שונים נשרתות מהאינדקסים האוטומטיים (מיזוג זיגזג).
       🔴 **אל תוסיף מיון או אי-שוויון** — הם ידרשו אינדקס
       שאי-אפשר ליצור, והשאילתה תיפול בייצור.
       ------------------------------------------------------------------ */
    /* שלבי הסטטוס כפי שהם נשמרים בגיליון (STATUS_HE ב-Code.gs). */
    function txLegalStep(from, to) {
      return (from == 'הוגשה קבלה' && (to == 'בבדיקה' || to == 'הועבר להנה"ח' || to == 'נדחה')) ||
             (from == 'בבדיקה'   && (to == 'הועבר להנה"ח' || to == 'נדחה')) ||
             (from == 'הועבר להנה"ח' && (to == 'שולם' || to == 'נדחה'));
    }

    /* הכתיבה היחידה שהדפדפן מורשה לעשות על תנועה.
       🔴 **שלושה תנאים, וכל אחד נחוץ בפני עצמו:**
       1. **רק ארבעה שדות משתנים** (`hasOnly`). בלעדיו הדפדפן
          יכול לשנות סכום, סעיף או מזהה משפחה — כלומר להעביר
          כסף למשפחה אחרת או לנפח הוצאה.
       2. **מעבר חוקי בלבד.** אי-אפשר לקפוץ מ"הוגשה" ל"שולם"
          בלי לעבור באישור, ואי-אפשר להחזיר מ"שולם" אחורה.
       3. **`statusPending` חייב לעלות ל-true.** זה מה שגורם לטריגר
          להחיל על הגיליון ולסנכרון לא לדרוס. כתיבה בלעדיו
          היתה נעלמת בסנכרון הבא — שינוי שנראה שנשמר ונעלם.
       ⚠️ יצירה ומחיקה סגורות לגמרי — הן שייכות לסנכרון בלבד. */
    function txStatusUpdateOk() {
      return canSeeBudget() &&
             request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['סטטוס', 'הערת בדיקה', 'statusPending', 'updatedAt']) &&
             request.resource.data.statusPending == true &&
             /* ⚠️ **סוגריים מרובעים ולא נקודה.** מזהה בשפת הכללים
                חייב להיות ASCII; גישה בנקודה לשדה עברי היא שגיאת פרסור
                שמפילה את פרסום הכללים כולו. */
             request.resource.data['סטטוס'] is string &&
             txLegalStep(resource.data['סטטוס'], request.resource.data['סטטוס']);
    }

    /* ========================================================================
     *  כתיבת תנועות מהדפדפן   (צעד 09ב-2, 2026-09-15)
     * ------------------------------------------------------------------------
     *  🔴 **רשימת היתר, לעולם לא רשימת חסימה.** טאב התנועות הוא מבנה
     *  פתוח, והלקוח אוסף כל עמודה לא מוכרת. עם רשימת חסימה, שדה חדש
     *  שמישהו יוסיף מחר (טלפון, הערה אישית) היה נכתב ל-Firestore בלי
     *  ששורה אחת בכלל תשתנה. שדה שאינו ברשימה — הכתיבה נדחית כולה.
     *
     *  🔴 **`רוכש` אינו ברשימה, בכוונה.** זה שם של אדם. החריג היחיד
     *  (שורה בלי מזהה משפחה) הוא של הסנכרון בצד השרת בלבד; הדפדפן
     *  לעולם לא כותב שם, ומשפחה היא דרישה בכל תנועה חדשה.
     *
     *  🔴 **סטטוס ופרטים נפרדים לחלוטין.** `txStatusUpdateOk` מטפל
     *  בסטטוס ואוכף מעבר חוקי; `txDetailsUpdateOk` מטפל בשאר ו**אוסר
     *  לגעת בסטטוס**. בלי ההפרדה, "עריכת פרטים" היתה דלת אחורית
     *  לקפוץ מ"הוגשה" ל"שולם" בלי לעבור באישור.
     * ====================================================================== */
    function txAllowedFields() {
      return ['מזהה', 'חודש הגשה', 'תאריך רכישה', 'ספק/נמען', 'בנק', 'סכום',
              'סעיף', 'תת-סעיף', 'סוג הוצאה', 'מקור', 'סטטוס', 'הערת בדיקה',
              'תיאור', 'שם קובץ קבלה', 'קישור קבלה', 'מזהה משפחה',
              /* 🔴 תאריך ההגשה המדויק — `staleNudgeJob_` מחשבת ממנו כמה ימים
                 הבקשה תקועה. בלעדיו הנדנוד מפסיק לעבוד בשקט (צעד 09ב-4). */
              'הוגש בתאריך',
              'year', 'familyId', 'statusPending', 'mailPending',
              'schema', 'updatedAt'];
    }

    /* השדות שחייבים להופיע בכל מסמך חדש. */
    function txRequiredFields() {
      return ['מזהה', 'סכום', 'סטטוס', 'מקור', 'מזהה משפחה',
              'year', 'familyId', 'schema', 'updatedAt'];
    }

    /* 🔴 המזהה של המסמך נגזר מהתוכן — אחרת אפשר ליצור מסמך בשם של
       שנה אחת ולשים בו שנה אחרת, והשאילתה לפי שנה תפספס אותו. */
    function txIdMatches(docId) {
      return docId == request.resource.data.year + '__' +
                      string(request.resource.data['מזהה']);
    }

    function txShapeOk(docId) {
      return request.resource.data.keys().hasOnly(txAllowedFields()) &&
             request.resource.data.keys().hasAll(txRequiredFields()) &&
             txIdMatches(docId) &&
             request.resource.data['מזהה'] is int &&
             request.resource.data['סכום'] is number &&
             request.resource.data.year is string &&
             request.resource.data.schema is int &&
             request.resource.data.familyId is string &&
             request.resource.data.familyId != '' &&
             request.resource.data.familyId == request.resource.data['מזהה משפחה'] &&
             request.resource.data.statusPending == false;
    }

    /* תושב פותח בקשת החזר על שם משפחתו בלבד, תמיד בסטטוס הפתיחה.
       ⚠️ `mailPending` מותר כאן — כלל אבטחה אינו יכול לשלוח מייל,
          והטריגר הוא זה ששולח. אבל הוא **בוליאני בלבד**, והתבנית
          נגזרת בשרת ממצב המסמך ולא משדה שהלקוח בוחר. */
    function txResidentCreateOk(docId) {
      return isMember() && txShapeOk(docId) &&
             request.resource.data.familyId == myFamilyId() &&
             request.resource.data['מקור'] == 'תושב' &&
             request.resource.data['סטטוס'] == 'הוגשה קבלה' &&
             request.resource.data['סכום'] > 0 &&
             (!request.resource.data.keys().hasAny(['mailPending']) ||
              request.resource.data.mailPending is bool) &&
             !request.resource.data.keys().hasAny(['הערת בדיקה']);
    }

    /* בעל הרשאת תקציב מזין הוצאה — כל מקור, אבל לא סטטוס סופי משלב אפס. */
    function txAdminCreateOk(docId) {
      return canSeeBudget() && txShapeOk(docId) &&
             (!request.resource.data.keys().hasAny(['mailPending']) ||
              request.resource.data.mailPending is bool) &&
             (request.resource.data['סטטוס'] == 'הוגשה קבלה' ||
              request.resource.data['סטטוס'] == 'הועבר להנה"ח');
    }

    /* עריכת פרטים — כל מה שאינו סטטוס. */
    function txDetailsUpdateOk() {
      return canSeeBudget() &&
             request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['חודש הגשה', 'תאריך רכישה', 'ספק/נמען', 'בנק', 'סכום',
                         'סעיף', 'תת-סעיף', 'סוג הוצאה', 'תיאור',
                         'שם קובץ קבלה', 'קישור קבלה', 'updatedAt']) &&
             request.resource.data['סכום'] is number &&
             request.resource.data['סכום'] > 0;
    }

    match /budgetTx/{docId} {
      allow read: if canSeeFamilyTx(resource.data.familyId);
      allow create: if txResidentCreateOk(docId) || txAdminCreateOk(docId);
      allow update: if txStatusUpdateOk() || txDetailsUpdateOk();
      allow delete: if canSeeBudget();
    }

    /* ========================================================================
     *  מונה המזהים הרצים   (צעד 09ב-1, 2026-09-15)
     * ------------------------------------------------------------------------
     *  🔴 **למה זה קיים:** לתנועה יש מזהה קצר (1, 2, 3…)
     *  שמופיע במיילים לתושבים ובשיחות. עד היום Apps Script
     *  ספר אותו מהגיליון; כשהדפדפן יכתוב תנועות ישירות
     *  אין מי שיספור — ושני אנשים שמזינים באותו רגע היו מקבלים
     *  את אותו מספר.
     *
     *  🔴 **הכלל הזה הוא כל מה שמגן:** חבר יכול לקדם את המונה
     *  **באחד בלבד**, לעולם לא להוריד ולא לקפוץ. הורדה היתה
     *  גורמת לתנועה הבאה **לדרוס תנועה קיימת**. הנזק הגרוע
     *  ביותר שאפשר לעשות דרך הכלל הזה הוא לשרוף מספרים —
     *  מספר חסר ברצף, לא נתון שנאבד.
     *
     *  ⚠️ **יצירה ומחיקה סגורות.** המונה נזרע ע"י Apps Script
     *  מתוך המזהה הגבוה בגיליון. מונה שהדפדפן היה יוצר
     *  לבד היה מתחיל מאפס ומתנגש בכל 150 התנועות הקיימות.
     * ====================================================================== */
    function counterBumpOk() {
      return isMember() &&
             request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['n', 'updatedAt']) &&
             request.resource.data.n is int &&
             request.resource.data.n == resource.data.n + 1;
    }

    match /counters/{id} {
      allow read: if isMember();
      allow update: if counterBumpOk();
      allow create, delete: if false;
    }

    /* ---------- דגלי זמן ריצה (צעד 05א) ---------- */

    /* קונפיגורציה של האפליקציה, לא נתונים: אילו תחומים נקראים
       ישירות מ-Firestore. כל חבר פעיל צריך אותה — גם אחראי הגינון
       החיצוני, שהמסכים שלו ישתמשו בה בעתיד. אין כאן שום מידע
       שהחשיפה שלו מזיקה — בוליאנים של אילו מסלולים דלוקים.

       🔴 **כתיבה אסורה לחלוטין.** מי שיכול לערוך את המסמך הזה
       יכול לכבות לכל השיכון מסלולים, או להדליק תחום שעדיין לא
       נבדק. השינוי עובר דרך Apps Script (פעולת flagSet, מנהל-על בלבד). */
    match /appConfig/{doc} {
      allow read: if isMember();
      allow write: if false;
    }

    /* ======================================================================
     *  סטטוס מנוי כושר   (צעד 10ב-1, 2026-09-15)
     * ----------------------------------------------------------------------
     *  🔴🔴 **כל אחד את שלו בלבד, ובלי שום חריג.** אין כאן
     *  מסלול למנהל ואין מסלול למשפחה: מנוי כושר הוא של
     *  **אדם**, ובשורת תושבים אחת יושבים שני בני זוג עם אותו
     *  `familyId` — כלל לפי משפחה היה חושף לבן/בת הזוג את
     *  המנוי של השני. המסנך הוא מזהה המסמך עצמו.
     *
     *  ⚠️ **מסך הניהול של המכון אינו עובר לכאן ולעולם לא יעבור**
     *     — הוא מציג שמות, ת.ז. ותשובות שאלון בריאות, ואלה
     *     נשארים בגיליון מאחורי `authorize_` עם PERM_GYM.
     *  ⚠️ **קוד הכניסה אינו במסמך הזה.** כללי Firestore מגנים על
     *     מסמכים ולא על שדות, ולכן קוד שהיה נוסע כאן היה נקרא
     *     גם ע"י מי שהמנוי שלו פג. ר' ההערה ב-`gymStatusSyncAll_`.
     * ==================================================================== */
    /* 🔴🔴 **`isMember()` ולא `signedIn()` — תוקן 16.9.2026.**
       הכלל המקורי הסתפק ב"המסמך שלך", והחמיץ את **מתג הכיבוי**:
       תושב שסומן "עזב" מקבל `members/{uid}.active = false` מיד
       (`fbSyncRow_`), ו-`authorize_` בשרת דוחה אותו באותו רגע. הכלל
       כאן המשיך לתת לו את המסמך — כלומר **רחב מהשרת**, וזה בדיוק
       מה שאסור. מי שעזב את השיכון היה ממשיך לראות את מנוי הכושר
       שלו כל עוד הוא מחובר.
       ⚠️ `isExternal == false` מאותה סיבה כמו בכל שאר הכללים:
          `authorize_` חוסם משתמש חיצוני מכל פעולה שאינה גינון. */
    function canSeeGymStatus(uid) {
      return isMember() && m().isExternal == false && request.auth.uid == uid;
    }

    match /gymStatus/{uid} {
      allow read: if canSeeGymStatus(uid);
      /* הגיליון מקור האמת; Apps Script כותב דרך OAuth ועוקף
         את הכללים. הדפדפן לעולם אינו כותב כאן. */
      allow write: if false;
    }

    /* ======================================================================
     *  קוד הכניסה למכון   (צעד 10ב-3, 2026-09-16)
     * ----------------------------------------------------------------------
     *  🔴🔴 **הכלל היחיד כאן שתלוי בזמן, ובכוונה.**
     *  `handleGymMy_` בשרת מוסר את הקוד רק אם הסטטוס "פעיל"
     *  **וגם** `בתוקף עד >= היום` — בדיקה שנעשית בכל קריאה
     *  ולכן מדויקת לשנייה. הסנכרון לכאן, לעומת זאת, רץ פעם
     *  בשעה. כלל שהיה מסתפק ב"המסמך שלך" היה מותיר קוד בידי
     *  מי שהמנוי שלו פג — עד שעה של גישה שהשרת כבר שולל,
     *  כלומר **כלל רחב מהשרת**, וזה בדיוק מה שאסור.
     *  לכן המסמך נושא `validUntil` כחותמת זמן, והכלל משווה
     *  אליה את `request.time`. הפקיעה מדויקת לשנייה.
     *
     *  🔴 **וזו הסיבה שזה מסמך נפרד מ-`gymStatus`.** כלל פועל על
     *  מסמך שלם ואינו יודע לסנן שדות; קוד שהיה יושב בתוך
     *  מסמך הסטטוס היה נקרא תמיד ע"י בעליו.
     *
     *  ⚠️ **`is timestamp` אינו קישוט.** שדה חסר או מסוג אחר
     *     היה מפיל את ההשוואה לשגיאת הערכה. כאן זה נכשל-סגור
     *     ממילא, אבל הצורה המפורשת אומרת את זה בקול.
     *  ⚠️ המסמך גם **נכתב מלכתחילה רק למי שזכאי** ונמחק ממי
     *     שאינו (ר' `gymStatusSyncAll_`). שני שערים בלתי
     *     תלויים; טעות באחד אינה מספיקה כדי לדלוף.
     * ==================================================================== */
    /* 🔴 **פונקציה בעלת שם, ולא תנאי פרוש בתוך ה-`match`.** זה כלל
       הקובץ מ-15.9: תנאי שנדחף בשורה אחת בתוך `match` הוא בדיוק מה
       שמחליק פנימה בלי שאיש יראה אותו. יש בדיקה שאוכפת את זה. */
    function canSeeGymCode(uid) {
      /* 🔴🔴 **`canSeeGymStatus` ולא `signedIn()` — תוקן 16.9.2026, לפני
         הפרסום הראשון.** התנאי המקורי בדק רק "המסמך שלך" + תוקף, והחמיץ
         את מתג הכיבוי: תושב שעזב מקבל `active:false` מיד, `authorize_`
         דוחה אותו באותו רגע — אבל `gymUidByEmail_` בונה את מפת
         האימיילים מטאב התושבים **בלי להסתכל בסטטוס**, ולכן הסנכרון
         השעתי היה ממשיך לכתוב לו קוד עד תום תקופת המנוי.
         מי שעזב את השיכון היה שומר את **קוד הדלת** של המכון לחודשים.
         ⚠️ שני התנאים אינם עודפים זה לזה: `validUntil` סוגר את פער
            השעה מול פקיעת המנוי, ו-`isMember()` סוגר את פער העזיבה.
            כל אחד מהם לבדו משאיר דלת פתוחה. */
      return canSeeGymStatus(uid) &&
             resource.data.validUntil is timestamp &&
             request.time < resource.data.validUntil;
    }

    match /gymCode/{uid} {
      allow read: if canSeeGymCode(uid);
      allow write: if false;
    }

    /* ======================================================================
     *  מוני עמוד הבית   (פעולה 3, 2026-09-16)
     * ----------------------------------------------------------------------
     *  חמש תגיות ספירה, כל אחת מספר אחד. אין כאן שום
     *  מידע אישי — לא שם, לא אימייל, ולא מזהה משפחה.
     *
     *  🔴🔴 **מסמך לכל הרשאה, וזו הסיבה היחידה לפיצול.**
     *  כלל פועל על מסמך שלם ולא על שדה. מסמך אחד עם חמש
     *  הספירות היה נותן למנהל המכון גם את מספר בקשות
     *  ההרשמה הממתינות — **רחב מהשרת**, שבו `handleHomeExtras_`
     *  בודק כל מקטע מול ההרשאה שלו בנפרד.
     *
     *  ⚠️ מזהה המסמך הוא ASCII במכוון (`residents` ולא `תושבים`) —
     *     השוואה למחרוזת עברית בשפת הכללים עובדת, אבל
     *     שם אוסף/מסמך עברי הוא נתיב שצריך קידוד, ו-`fsUrl_`
     *     מרכיב נתיבים בשרשור פשוט. **ההרשאות עצמן** נשארות
     *     עברית, כי אלה הערכים שיושבים ב-`members/{uid}.perms`.
     *  ⚠️ הדפדפן לעולם אינו כותב: המסמכים נגזרים מהגיליון
     *     בלבד, ושני מקורות כתיבה הם שני מספרים שיסתרו זה את זה.
     * ==================================================================== */
    function canSeeHomeCount(id) {
      return isMember() && m().isExternal == false &&
             ((id == 'residents' && hasPerm('תושבים')) ||
              (id == 'gym'       && hasPerm('מכון')) ||
              (id == 'club'      && hasPerm('מועדון')) ||
              (id == 'garden'    && hasPerm('גינון')));
    }

    match /homeCounts/{id} {
      allow read: if canSeeHomeCount(id);
      allow write: if false;
    }

    /* ======================================================================
     *  שריוני המועדון — מסמך למשפחה   (צעד 12א, 2026-09-16)
     * ----------------------------------------------------------------------
     *  🔑 **הכלל מעתיק בדיוק את `handleMyClubReservations_`**, שמסנן
     *  לפי הזהות שבמושב החתום ומחזיר לתושב **רק את השריונים שלו**.
     *  החלטת יועד (16.9): תושב רואה את שלו בלבד — לא את לוח התפוסה.
     *
     *  🔴🔴 **`fid != ''` אינו קישוט.** תושב שאין לו מזהה משפחה
     *  יקבל `myFamilyId()` ריק, ומסמך שנכתב בטעות תחת מזהה ריק
     *  היה נפתח לכל מי שאין לו מזהה. אותה נעילה בדיוק כמו
     *  ב-`canSeeFamilyTx`, ומאותה סיבה.
     *
     *  ⚠️ **מזהה משפחה הוא משק בית, לא אדם** — שני בני זוג חולקים
     *     שורה ומזהה, ולכן רואים את אותם שריונים. זו ההתנהגות של
     *     השרת היום (`clubIdentity_` מתאים לפי שם משפחה/מזהה), לא
     *     שינוי.
     *  ⚠️ **במסמך אין אימייל ואין הערה** — ר' `clubResvSyncAll_`.
     * ==================================================================== */
    function canSeeClubResv(fid) {
      return isMember() && m().isExternal == false &&
             fid is string && fid != '' && fid == myFamilyId();
    }

    match /clubReservations/{fid} {
      allow read: if canSeeClubResv(fid);
      allow write: if false;
    }

    /* ======================================================================
     *  צעדי הסיור — מסמך לכל קהל   (צעד 12ב, 2026-09-16)
     * ----------------------------------------------------------------------
     *  🔑 **הכלל מעתיק את הפילטר של `handleTour_`**: צעד שמיועד
     *  למנהלים לא יוצא למי שאינו מנהל, וצעד שקהלו הוא **שם הרשאה**
     *  יוצא רק לבעלי אותה הרשאה (ומנהל-על רואה הכול, דרך `hasPerm`).
     *
     *  🔴 **הפיצול למסמך לכל קהל הוא מה שמאפשר את זה בכלל.** קריאת
     *  אוסף שלם נדחית אם מסמך אחד בו אסור לקורא — Firestore אינו
     *  מסנן. מסמך לכל צעד עם שדה "קהל" היה אומר שתושב רגיל לא יכול
     *  לקרוא את האוסף כלל.
     *
     *  ⚠️ **אין `perm-residents`, ויש `residents`.** "תושבים" בעמודת
     *     הקהל פירושו **תושב שאינו מנהל** (תוקן 16.9), ולא בעל הרשאת
     *     "תושבים". אי-אפשר לכוון צעד לבעלי ההרשאה הזאת — וזו
     *     ההתנהגות שהמודול תיאר מלכתחילה.
     *  ⚠️ המסמכים האלה אינם נתונים של אדם — הם תוכן שיווקי של
     *     האפליקציה. מה שאישי הוא רק "מה כבר ראיתי", והוא באוסף נפרד.
     * ==================================================================== */
    function isAdminUser() {
      return isMember() && (isSuper() || m().perms.size() > 0);
    }

    function canSeeTourDoc(id) {
      return isMember() && m().isExternal == false && (
        id == 'all' ||
        (id == 'admins'      && isAdminUser()) ||
        /* 🔴 נוסף 16.9 עם תיקון הקהל "תושבים" בשרת: עד אז הוא נפל
           פעמיים ב-`handleTour_` ואיש לא ראה צעד כזה. מעכשיו הוא
           מציין **תושב שאינו מנהל**, והכלל מעתיק בדיוק את התנאי
           `return !isAdmin` שם. ⚠️ ולכן הוא **שולל** הרשאה במקום
           לדרוש אותה — היחיד כזה בקובץ, ובכוונה. */
        (id == 'residents'   && !isAdminUser()) ||
        (id == 'perm-super'  && hasPerm('על')) ||
        (id == 'perm-budget' && hasPerm('תקציב')) ||
        (id == 'perm-club'   && hasPerm('מועדון')) ||
        (id == 'perm-gym'    && hasPerm('מכון')) ||
        (id == 'perm-garden' && hasPerm('גינון'))
      );
    }

    match /tourSteps/{id} {
      allow read: if canSeeTourDoc(id);
      allow write: if false;
    }

    /* "מה כבר ראיתי" — מספר אחד, וכל אחד את שלו בלבד.
       🔴 `isMember()` ולא `signedIn()`: אותו מתג כיבוי כמו בכל השאר.
       🔴 והדפדפן אינו כותב גם כאן — `markTourSeen` עובר דרך Apps
          Script, שכותב גם לגיליון וגם לכאן. שני מקורות כתיבה היו
          מאפשרים למשתמש לקבוע לעצמו "ראיתי" בלי שהגיליון יידע. */
    function canSeeTourSeen(uid) {
      return isMember() && request.auth.uid == uid;
    }

    match /tourSeen/{uid} {
      allow read: if canSeeTourSeen(uid);
      allow write: if false;
    }

    /* 🔴 **`active` הוא מתג הכיבוי.** תושב שסומן "עזב" בגיליון חייב לאבד
       גישה — ו-`authorize_` בצד Apps Script אוכף את זה, אבל כללי האבטחה
       רואים רק את המסמך הזה. לכן `isMember()` דורש `active == true`.
       ✅ `fbSyncRow_` כותב `active: false` ברגע שהתושב מסומן "עזב" או
          שהוסרו הרשאותיו — בכל ארבעת מסלולי הכתיבה. המתג עובד.

       ---------- רשומת החבר עצמה ---------- */

    match /members/{uid} {
      /* קריאה: כל אחד את שלו בלבד. שימושי לאבחון ("מה המערכת חושבת שאני?")
         ואינו חושף כלום — המשתמש כבר יודע מה ההרשאות שלו. */
      allow read: if signedIn() && request.auth.uid == uid;
      /* 🔴 **כתיבה אסורה לחלוטין, לכל אחד.** המסמך הזה הוא מקור ההרשאות;
         משתמש שיכול לערוך אותו יכול להעניק לעצמו כל הרשאה שירצה. Apps Script
         כותב דרך חשבון שירות, שעוקף את הכללים האלה ואינו זקוק להיתר כאן. */
      allow write: if false;
    }

    /* ---------- ברירת המחדל ---------- */

    /* 🔴 **הכול אסור, אלא אם נפתח במפורש למעלה.**
       ⚠️ הכלל הזה חייב להישאר **אחרון**, ואסור להחליף אותו ב-`allow read`
       גורף "רק עד שנסדר את זה" — זו בדיוק הנוסחה שחושפת מסד נתונים שלם.
       כל תחום שייפתח בעתיד מקבל בלוק `match` משלו **מעל** השורה הזאת. */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
