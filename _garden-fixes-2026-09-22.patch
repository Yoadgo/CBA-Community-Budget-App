+      if (op === 'update') return T(r.grFeedbackOk() || r.grPhotosOk() || r.grTeamUpdateOk(), 'grFeedbackOk||grPhotosOk||grTeamUpdateOk aff=' + JSON.stringify(affectedKeys(B, ctx.after)));
